---
import { pageSeo } from '../config/page-seo';
import { breadcrumbSchema, webPageSchema } from '../lib/schema/jsonld';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageCrumbBand from '../components/sections/PageCrumbBand.astro';
import ContactHero from '../components/sections/ContactHero.astro';
import ContactInquiry from '../components/sections/ContactInquiry.astro';
import ContactLocations from '../components/sections/ContactLocations.astro';

/** Edit SEO in `src/config/page-seo.ts` → `pageSeo.contact`. */
const seo = pageSeo.contact;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: seo.path },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path={seo.path}
  robots={seo.robots}
  canonical={seo.canonical}
  noindex={seo.noindex}
  schema={[webPageSchema({ title: seo.title, description: seo.description, path: seo.path }), breadcrumbSchema(crumbs)]}
>
  <PageCrumbBand title="Contact" crumbs={crumbs} />
  <ContactHero />
  <ContactInquiry />
  <ContactLocations />
</BaseLayout>
