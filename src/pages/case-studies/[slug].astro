---
import CaseStudyBeforeAfter from '../../components/sections/case-study/CaseStudyBeforeAfter.astro';
import CaseStudyChallenge from '../../components/sections/case-study/CaseStudyChallenge.astro';
import CaseStudyExecution from '../../components/sections/case-study/CaseStudyExecution.astro';
import CaseStudyFinalCta from '../../components/sections/case-study/CaseStudyFinalCta.astro';
import CaseStudyHero from '../../components/sections/case-study/CaseStudyHero.astro';
import CaseStudyLegacyBody from '../../components/sections/case-study/CaseStudyLegacyBody.astro';
import CaseStudyMetrics from '../../components/sections/case-study/CaseStudyMetrics.astro';
import CaseStudyOverview from '../../components/sections/case-study/CaseStudyOverview.astro';
import CaseStudyPerformance from '../../components/sections/case-study/CaseStudyPerformance.astro';
import CaseStudyRelated from '../../components/sections/case-study/CaseStudyRelated.astro';
import CaseStudyStrategy from '../../components/sections/case-study/CaseStudyStrategy.astro';
import CaseStudyTakeaways from '../../components/sections/case-study/CaseStudyTakeaways.astro';
import QuoteModal from '../../components/interactive/QuoteModal';
import { caseStudies } from '../../config/case-studies';
import { breadcrumbSchema, caseStudySchema, webPageSchema } from '../../lib/schema/jsonld';
import { definePageSeo } from '../../lib/seo/page-seo';
import { absoluteUrl } from '../../lib/seo/url';
import type { CaseStudy } from '../../types/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return caseStudies
    .filter((study) => Boolean(study.slug))
    .map((study) => ({
      params: { slug: study.slug },
      props: { study },
    }));
}

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Case studies', href: '/case-studies/' },
  { name: study.title, href: study.path },
];

/** Edit SEO on the case study config (`seoTitle`, `seoDescription`, `robots`, `canonical`). */
const seo = definePageSeo({
  title: study.seoTitle || study.title,
  description: study.seoDescription || study.summary,
  path: study.path,
  robots: study.robots,
  canonical: study.canonical,
  noindex: study.placeholder,
});
const title = seo.title;
const description = seo.description;
const shareImage = study.ogImage ?? study.heroImage ?? study.image;
const imageUrl = shareImage?.src ? absoluteUrl(shareImage.src) : undefined;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path={seo.path}
  robots={seo.robots}
  canonical={seo.canonical}
  noindex={seo.noindex}
  ogType="article"
  image={imageUrl}
  imageAlt={shareImage?.alt}
  imageWidth={shareImage?.width}
  imageHeight={shareImage?.height}
  publishedAt={study.publishedAt}
  modifiedAt={study.modifiedAt || study.publishedAt}
  schema={[
    webPageSchema({ title, description, path: study.path }),
    breadcrumbSchema(crumbs),
    caseStudySchema(study),
  ]}
>
  <QuoteModal client:idle endpoint={import.meta.env.PUBLIC_CONTACT_ENDPOINT} />
  <article>
    <CaseStudyHero study={study} crumbs={crumbs} />
    <CaseStudyMetrics study={study} />
    <CaseStudyOverview study={study} />
    <CaseStudyChallenge study={study} />
    <CaseStudyStrategy study={study} />
    <CaseStudyExecution study={study} />
    <CaseStudyBeforeAfter study={study} />
    <CaseStudyPerformance study={study} />
    <CaseStudyTakeaways study={study} />
    <CaseStudyLegacyBody study={study} />
    <CaseStudyRelated study={study} />
    <CaseStudyFinalCta />
  </article>
</BaseLayout>
