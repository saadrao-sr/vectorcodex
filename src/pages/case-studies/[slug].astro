---
import { caseStudies } from '../../config/case-studies';
import { breadcrumbSchema, webPageSchema } from '../../lib/schema/jsonld';
import type { CaseStudy } from '../../types/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Container from '../../components/ui/Container.astro';

export function getStaticPaths() {
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Case studies', href: '/case-studies/' },
  { name: study.title, href: study.path },
];
const description = study.summary;
---

<BaseLayout
  title={study.title}
  description={description}
  path={study.path}
  noindex={study.placeholder}
  schema={[webPageSchema({ title: study.title, description, path: study.path }), breadcrumbSchema(crumbs)]}
>
  <PageHero eyebrow={study.service} title={study.title} lede={study.summary} crumbs={crumbs} />
  <section class="py-14 sm:py-16">
    <Container class="max-w-3xl">
      {
        study.placeholder && (
          <p class="rounded-2xl border border-highlight/30 bg-highlight/10 px-5 py-4 text-sm leading-6 text-white">
            Placeholder. Client name, sector detail, and outcomes have not been added. This page does not report results.
          </p>
        )
      }
      <dl class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-white/10 p-5">
          <dt class="text-xs font-semibold tracking-[0.16em] text-white/50 uppercase">Service</dt>
          <dd class="mt-2 text-lg">{study.service}</dd>
        </div>
        <div class="rounded-2xl border border-white/10 p-5">
          <dt class="text-xs font-semibold tracking-[0.16em] text-white/50 uppercase">Sector</dt>
          <dd class="mt-2 text-lg">{study.sector}</dd>
        </div>
      </dl>
      <div class="prose-vc mt-10">
        {study.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
          </section>
        ))}
      </div>
      <p class="mt-10">
        <a href="/case-studies/" class="text-sm font-semibold text-highlight">All case studies</a>
      </p>
    </Container>
  </section>
</BaseLayout>
