---
import PostCard from '../../components/blog/PostCard.astro';
import Container from '../../components/ui/Container.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, summarize } from '../../lib/seo/format';
import { articleSchema, breadcrumbSchema } from '../../lib/schema/jsonld';
import { getAllPosts } from '../../lib/wordpress/client';
import type { BlogPost } from '../../types/content';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts
    .filter((post) => post.slug && post.slug !== 'page')
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const path = `/blog/${post.slug}/`;
const description = summarize(post.excerpt || post.title, 160);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog/' },
  { name: post.title, href: path },
];
const published = formatDate(post.publishedAt);
const modified = formatDate(post.modifiedAt);
const others = (await getAllPosts()).filter((item) => item.slug !== post.slug).slice(0, 3);
---

<BaseLayout
  title={post.title}
  description={description}
  path={path}
  ogType="article"
  image={post.image?.src}
  imageAlt={post.image?.alt}
  imageWidth={post.image?.width}
  imageHeight={post.image?.height}
  publishedAt={post.publishedAt}
  modifiedAt={post.modifiedAt}
  schema={[articleSchema({ ...post, excerpt: description }), breadcrumbSchema(crumbs)]}
>
  <article class="py-12 sm:py-16">
    <Container class="max-w-3xl">
      <Breadcrumbs items={crumbs} />
      {post.categories.length > 0 && <p class="text-xs font-semibold tracking-[0.16em] text-highlight uppercase">{post.categories.map((category) => category.name).join(', ')}</p>}
      <h1 class="mt-3 font-display text-4xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl">{post.title}</h1>
      <p class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-sm text-white/60">
        {published && (
          <span>
            Published <time datetime={post.publishedAt}>{published}</time>
          </span>
        )}
        {modified && modified !== published && (
          <span>
            Updated <time datetime={post.modifiedAt}>{modified}</time>
          </span>
        )}
        {post.authorName && <span>By {post.authorName}</span>}
      </p>
      {
        post.image && (
          <img
            src={post.image.src}
            alt={post.image.alt}
            width={post.image.width}
            height={post.image.height}
            decoding="async"
            class="mt-8 aspect-[16/9] w-full rounded-2xl object-cover"
          />
        )
      }
      <div class="prose-vc mt-10" set:html={post.contentHtml} />
      <p class="mt-12">
        <a href="/blog/" class="text-sm font-semibold text-highlight">All articles</a>
      </p>
    </Container>
    {
      others.length > 0 && (
        <Container class="mt-16">
          <h2 class="font-display text-3xl font-semibold tracking-tight">More articles</h2>
          <div class="mt-6 grid gap-5 md:grid-cols-3">
            {others.map((item) => (
              <PostCard post={item} />
            ))}
          </div>
        </Container>
      )
    }
  </article>
</BaseLayout>
