---
import BlogListing from '../../../components/blog/BlogListing.astro';
import { BLOG_PAGE_SIZE, getCategories, getPostsPage } from '../../../lib/wordpress/client';

export async function getStaticPaths() {
  const first = await getPostsPage(1, BLOG_PAGE_SIZE);
  if (!first.ok || first.totalPages < 2) return [];
  return Array.from({ length: first.totalPages - 1 }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const page = Number(Astro.params.page);
const result = await getPostsPage(page, BLOG_PAGE_SIZE);
const categories = await getCategories();
---

<BlogListing result={result} categories={categories} page={page} />
