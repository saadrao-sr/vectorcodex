---
import { Mail } from 'lucide-react';
import { breadcrumbSchema, webPageSchema } from '../lib/schema/jsonld';
import { site } from '../config/site';
import { talentProfiles } from '../config/team-talent';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import PageHero from '../components/sections/PageHero.astro';
import Container from '../components/ui/Container.astro';
import { buttonClass } from '../components/ui/styles';
import TeamRequirementsModal from '../components/interactive/TeamRequirementsModal';

const title = 'Our Team';
const description =
  'Explore VectorCodex talent solutions — dedicated specialists across SEO, web development, PPC, content, digital marketing, and UI/UX.';
const path = '/our-team/';
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Our Team', href: path },
];

function contactHref(email: string | null, role: string) {
  const address = email?.trim() || site.email;
  const subject = encodeURIComponent(`Enquiry: ${role}`);
  return `mailto:${address}?subject=${subject}`;
}

function contactLabel(email: string | null) {
  return email?.trim() || site.email;
}
---

<BaseLayout title={title} description={description} path={path} schema={[webPageSchema({ title, description, path }), breadcrumbSchema(crumbs)]}>
  <TeamRequirementsModal client:idle endpoint={import.meta.env.PUBLIC_CONTACT_ENDPOINT} />

  <PageHero
    eyebrow="Talent"
    title="Your extended digital team."
    lede="Dedicated specialists and full-service support across search, development, and marketing — scoped to the roles your business actually needs."
    crumbs={crumbs}
  />

  <section class="border-b border-white/10 py-12 sm:py-14 lg:py-16" aria-labelledby="team-roles-heading">
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <h2 id="team-roles-heading" class="font-display text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          <span class="text-white">Roles We Can </span>
          <span class="text-highlight">Deploy</span>
        </h2>
        <p class="mt-3 text-base leading-7 text-white/65 sm:text-lg sm:leading-8">
          Portraits and names below are editable placeholders until verified team biographies are published.
        </p>
      </div>

      <ul class="mt-8 grid grid-cols-1 gap-4 sm:mt-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
        {
          talentProfiles.map((profile) => {
            const href = contactHref(profile.email, profile.role);
            const label = contactLabel(profile.email);
            return (
              <li>
                <article class="group flex h-full flex-col overflow-hidden rounded-[1.5rem] border border-white/10 bg-white/[0.03] transition duration-300 hover:border-highlight/45 hover:bg-white/[0.05]">
                  <div class="relative aspect-[4/4.2] overflow-hidden bg-surface">
                    <img
                      src={profile.image}
                      alt=""
                      width={640}
                      height={800}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover object-center transition duration-500 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                    />
                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg via-bg/30 to-transparent" aria-hidden="true" />
                    <span class="absolute top-3 left-3 inline-flex h-9 w-9 items-center justify-center rounded-full border border-highlight/35 bg-bg/75 text-[0.7rem] font-semibold tracking-[0.12em] text-highlight uppercase backdrop-blur-sm">
                      {profile.initials}
                    </span>
                  </div>
                  <div class="flex flex-1 flex-col px-4 py-4 sm:px-5 sm:py-5">
                    <h3 class="font-display text-lg font-semibold tracking-tight text-white">{profile.name}</h3>
                    <p class="mt-1 text-sm font-medium text-highlight">{profile.role}</p>
                    <a href={href} class="mt-3 inline-flex min-w-0 items-center gap-2 text-sm text-white/55 transition hover:text-highlight">
                      <Mail size={14} aria-hidden="true" className="shrink-0 text-highlight/70" />
                      <span class="truncate">{label}</span>
                    </a>
                  </div>
                </article>
              </li>
            );
          })
        }
      </ul>

      <div class="mt-8 flex justify-center sm:mt-10">
        <button
          type="button"
          class:list={[buttonClass.base, buttonClass.gradient, 'shadow-[0_12px_40px_rgb(197_246_61_/0.16)]']}
          data-team-requirements-open
        >
          Discuss Your Requirements
        </button>
      </div>
    </Container>
  </section>

  <CtaBand
    title="Need a scoped team, not a generic package?"
    text="Tell us the department, headcount, and budget range. We will reply with a clear next step."
  />
</BaseLayout>
