---
import { blogListingSeo } from '../../config/page-seo';
import { breadcrumbSchema, webPageSchema } from '../../lib/schema/jsonld';
import { getAllPosts } from '../../lib/wordpress/client';
import type { BlogListResult, BlogPost, BlogTerm } from '../../types/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogHero from '../sections/BlogHero.astro';
import QuoteModal from '../interactive/QuoteModal';
import Container from '../ui/Container.astro';
import BlogCategoryFilter from '../interactive/BlogCategoryFilter';
import Pagination from './Pagination.astro';
import PostCard from './PostCard.astro';

interface Props {
  result: BlogListResult;
  categories: BlogTerm[];
  page: number;
}

const { result, categories, page } = Astro.props;
/** Edit SEO in `src/config/page-seo.ts` → `pageSeo.blog` / `blogListingSeo()`. */
const seo = blogListingSeo(page);
const path = seo.path;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog/' },
  ...(page > 1 ? [{ name: `Page ${page}`, href: path }] : []),
];
const prev = page > 1 ? (page === 2 ? '/blog/' : `/blog/page/${page - 1}/`) : undefined;
const next = result.ok && page < result.totalPages ? `/blog/page/${page + 1}/` : undefined;

/** Blog listing shows WordPress posts only — never dummy placeholders. */
const listingPosts: BlogPost[] = result.ok ? result.posts : [];
const hasLivePosts = listingPosts.length > 0;
const wpConfigured = result.configured;
const wpError = result.configured && !result.ok;

let searchablePosts: BlogPost[] = listingPosts;
if (hasLivePosts) {
  try {
    const all = await getAllPosts();
    if (all.length > 0) searchablePosts = all;
  } catch {
    searchablePosts = listingPosts;
  }
}

const searchIndex = searchablePosts.map((post) => ({
  id: post.id,
  slug: post.slug,
  title: post.title,
  excerpt: post.excerpt,
  publishedAt: post.publishedAt,
  image: post.image,
  categories: post.categories,
}));

const listingCopy = wpError
  ? 'Articles could not be loaded from WordPress right now. Please try again shortly.'
  : !wpConfigured
    ? 'WordPress is not connected yet. Set WORDPRESS_API_URL in the project root .env file.'
    : hasLivePosts
      ? 'Fresh perspectives from the VectorCodex team — published from WordPress and built into this site.'
      : 'No published articles yet. New WordPress posts will appear here after the next site build.';

const showDevError = import.meta.env.DEV && Boolean(result.error);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path={seo.path}
  robots={seo.robots}
  canonical={seo.canonical}
  noindex={seo.noindex}
  prev={prev}
  next={next}
  schema={[webPageSchema({ title: seo.title, description: seo.description, path: seo.path }), breadcrumbSchema(crumbs)]}
>
  <QuoteModal client:idle endpoint={import.meta.env.PUBLIC_CONTACT_ENDPOINT} />
  <BlogHero
    crumbs={crumbs}
    page={page}
    posts={searchIndex}
    placeholderPosts={false}
  />
  <section
    id="blog-articles"
    class="scroll-mt-28 border-t border-white/10 py-12 sm:py-14 lg:py-16"
    aria-labelledby="articles-heading"
  >
    <Container>
      <div class="mb-8 max-w-2xl sm:mb-10">
        <h2
          id="articles-heading"
          class="font-display text-2xl font-semibold tracking-tight text-white sm:text-3xl"
        >
          Latest
          <span class="text-highlight"> Articles</span>
        </h2>
        <p class="mt-2 text-sm leading-6 text-white/60 sm:text-base sm:leading-7">
          {listingCopy}
        </p>
        {
          showDevError && (
            <p class="mt-3 rounded-xl border border-cta/30 bg-cta/10 px-3 py-2 font-mono text-xs leading-5 text-cta/95" role="status">
              Dev: {result.error}
            </p>
          )
        }
      </div>

      {
        hasLivePosts && categories.length > 0 && (
          <BlogCategoryFilter client:visible categories={categories} listingId="blog-articles" />
        )
      }

      {
        hasLivePosts ? (
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {listingPosts.map((post) => <PostCard post={post} />)}
          </div>
        ) : (
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-8 text-sm leading-6 text-white/65 sm:px-6">
            {listingCopy}
          </div>
        )
      }

      {hasLivePosts && <Pagination page={page} totalPages={result.totalPages} />}
    </Container>
  </section>
</BaseLayout>
