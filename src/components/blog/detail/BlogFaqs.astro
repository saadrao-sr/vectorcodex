---
import type { BlogFaq } from '../../../types/content';
import FaqAccordion from '../../interactive/FaqAccordion';
import { eyebrowClass } from '../../ui/styles';

interface Props {
  items: BlogFaq[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section id="blog-faqs" class="blog-faqs mt-8 sm:mt-10" aria-labelledby="blog-faqs-heading">
      <header class="blog-faqs__intro min-w-0">
        <p class:list={[eyebrowClass, 'w-fit']}>FAQs</p>
        <h2
          id="blog-faqs-heading"
          class="mt-3 max-w-xl font-display text-[1.55rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[1.85rem]"
        >
          Questions about this
          <span class="text-highlight"> article</span>
        </h2>
        <p class="mt-2.5 max-w-xl text-sm leading-7 text-white/65 sm:text-[0.95rem] sm:leading-7">
          Quick answers related to the topics covered above.
        </p>
      </header>

      <div class="blog-faqs__list mt-5 min-w-0 sm:mt-6">
        <FaqAccordion client:visible items={items} />
      </div>
    </section>
  )
}
