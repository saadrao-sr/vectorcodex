---
import { site } from '../../../config/site';
import type { BlogAuthorSocial, BlogPost, Crumb } from '../../../types/content';
import { formatDate } from '../../../lib/seo/format';
import Container from '../../ui/Container.astro';
import SectionBannerBg from '../../ui/SectionBannerBg.astro';
import { eyebrowClass } from '../../ui/styles';

interface Props {
  post: BlogPost;
  crumbs: Crumb[];
  readingMinutes: number;
}

const { post, crumbs, readingMinutes } = Astro.props;
const published = formatDate(post.publishedAt);
const modified = formatDate(post.modifiedAt);
const showUpdated = Boolean(modified && modified !== published);
const categories = (post.categories ?? []).filter((term) => term?.name);

const iconPaths: Record<string, string> = {
  linkedin:
    'M6.9 8.5H4V20h2.9V8.5zM5.4 3.5A1.7 1.7 0 1 0 5.4 6.9 1.7 1.7 0 0 0 5.4 3.5zM20.5 20h-2.9v-5.7c0-1.6-.6-2.7-2.1-2.7-1.1 0-1.7.8-2 1.5-.1.3-.1.7-.1 1.1V20H10.5s0-9.4 0-10.4H13.4v1.5c.5-.7 1.4-1.8 3.4-1.8 2.5 0 4.2 1.6 4.2 5.1V20z',
  facebook: 'M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3.1l.9-3H13v-1.5c0-.8.7-1.5 1.5-1.5z',
  pinterest:
    'M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.3 9.2-.1-.8-.2-2 0-2.9.2-.8 1.3-5.5 1.3-5.5s-.3-.7-.3-1.6c0-1.5.9-2.6 2-2.6.9 0 1.4.7 1.4 1.5 0 .9-.6 2.3-.9 3.5-.3 1.1.5 1.9 1.5 1.9 1.8 0 3.2-1.9 3.2-4.7 0-2.4-1.8-4.2-4.3-4.2-2.9 0-4.7 2.2-4.7 4.5 0 .9.3 1.8.8 2.3.1.1.1.2.1.3l-.3 1.2c0 .2-.1.2-.3.1-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2-1.3 2.7 1 .3 2 .5 3.1.5 5.5 0 10-4.5 10-10S17.5 2 12 2z',
};

function resolveKey(label: string) {
  const value = label.toLowerCase();
  if (value.includes('linkedin')) return 'linkedin';
  if (value.includes('facebook')) return 'facebook';
  if (value.includes('pinterest')) return 'pinterest';
  return value;
}

const siteLinkedIn = site.socials.find((item) => item.icon === 'linkedin');
const siteFacebook = site.socials.find((item) => item.icon === 'facebook');

const fallbackSocials: BlogAuthorSocial[] = [
  ...(siteLinkedIn ? [{ label: 'LinkedIn', href: siteLinkedIn.href }] : []),
  ...(siteFacebook ? [{ label: 'Facebook', href: siteFacebook.href }] : []),
  { label: 'Pinterest', href: 'https://www.pinterest.com/' },
];

const authorSocials = (post.authorSocials?.length ? post.authorSocials : fallbackSocials).filter((item) =>
  Boolean(item.href),
);
---

<section
  id="blog-article-hero"
  class="blog-article-hero relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] pt-[calc(var(--header-height)+1.35rem)] pb-8 sm:pt-[calc(var(--header-height)+1.75rem)] sm:pb-11"
  aria-labelledby="blog-article-heading"
>
  <SectionBannerBg eager />

  <Container class="relative">
    <nav aria-label="Breadcrumb" class="mb-6 sm:mb-7">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.8125rem] leading-none text-white/55">
        {
          crumbs.map((item, index) => {
            const last = index === crumbs.length - 1;
            return (
              <li class="inline-flex max-w-full items-center gap-2">
                {index > 0 && <span aria-hidden="true" class="text-white/30">/</span>}
                {last ? (
                  <span aria-current="page" class="truncate text-highlight">
                    {item.name}
                  </span>
                ) : (
                  <a href={item.href} class="truncate transition hover:text-highlight">
                    {item.name}
                  </a>
                )}
              </li>
            );
          })
        }
      </ol>
    </nav>

    <div class="blog-article-hero__layout">
      <div class="blog-article-hero__copy min-w-0">
        {
          categories.length > 0 && (
            <ul class="flex flex-wrap gap-2" aria-label="Categories">
              {categories.map((category) => (
                <li>
                  <span class:list={[eyebrowClass, 'w-fit max-w-full']}>{category.name}</span>
                </li>
              ))}
            </ul>
          )
        }

        <h1
          id="blog-article-heading"
          class:list={[
            'max-w-3xl font-display text-[1.75rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.35rem] sm:leading-[1.08] lg:text-[2.75rem] lg:leading-[1.05]',
            categories.length > 0 ? 'mt-4 sm:mt-5' : 'mt-0',
          ]}
        >
          {post.title}
        </h1>

        <div class="blog-article-hero__meta mt-5 flex flex-wrap items-center gap-x-3 gap-y-2.5 text-sm text-white/55 sm:mt-6 sm:gap-x-4">
          {
            post.authorName && (
              <div class="inline-flex flex-wrap items-center gap-2.5">
                {post.authorAvatar ? (
                  <img
                    src={post.authorAvatar}
                    alt=""
                    width={36}
                    height={36}
                    loading="eager"
                    decoding="async"
                    class="h-9 w-9 rounded-full border border-white/15 object-cover"
                  />
                ) : (
                  <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-highlight/30 bg-highlight/10 text-xs font-semibold text-highlight">
                    {post.authorName.slice(0, 1).toUpperCase()}
                  </span>
                )}
                <span class="font-medium text-white/80">{post.authorName}</span>
                {authorSocials.length > 0 && (
                  <ul class="ml-0.5 flex flex-wrap items-center gap-1.5" aria-label={`${post.authorName} on social media`}>
                    {authorSocials.map((item) => {
                      const key = resolveKey(item.label);
                      const path = iconPaths[key];
                      if (!path) return null;
                      return (
                        <li>
                          <a
                            href={item.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-white/15 bg-white/[0.03] text-white/70 transition hover:border-highlight/40 hover:bg-highlight/10 hover:text-highlight"
                            aria-label={`${post.authorName} on ${item.label}`}
                          >
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                              <path d={path} />
                            </svg>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                )}
              </div>
            )
          }

          {
            published && (
              <>
                <span class="blog-article-hero__dot" aria-hidden="true" />
                <time datetime={post.publishedAt}>{published}</time>
              </>
            )
          }

          {
            showUpdated && (
              <>
                <span class="blog-article-hero__dot" aria-hidden="true" />
                <span>
                  Updated <time datetime={post.modifiedAt}>{modified}</time>
                </span>
              </>
            )
          }

          <span class="blog-article-hero__dot" aria-hidden="true" />
          <span>{readingMinutes} min read</span>
        </div>
      </div>

      {
        post.image && (
          <div class="blog-article-hero__media min-w-0">
            <figure class="overflow-hidden rounded-[1.35rem] border border-white/12 bg-surface shadow-[0_20px_60px_rgb(0_0_0_/0.32)] sm:rounded-[1.6rem]">
              <img
                src={post.image.src}
                alt={post.image.alt}
                width={post.image.width ?? 1200}
                height={post.image.height ?? 675}
                fetchpriority="high"
                decoding="async"
                class="aspect-[16/10] h-full w-full object-cover"
              />
            </figure>
          </div>
        )
      }
    </div>
  </Container>
</section>

<style>
  .blog-article-hero__layout {
    display: grid;
    align-items: start;
    gap: 1.75rem;
  }

  .blog-article-hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
  }

  .blog-article-hero__dot {
    display: none;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.35);
  }

  @media (min-width: 480px) {
    .blog-article-hero__dot {
      display: inline-block;
    }
  }

  @media (min-width: 900px) {
    .blog-article-hero__layout {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
      align-items: center;
      gap: 2.75rem;
    }
  }
</style>
