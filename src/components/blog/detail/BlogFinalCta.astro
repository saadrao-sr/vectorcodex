---
import { ArrowUpRight } from 'lucide-react';
import Container from '../../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../../ui/styles';
---

<section
  id="blog-final-cta"
  class="relative isolate overflow-hidden border-t border-white/10 bg-[#0D120C] py-8 sm:py-10 lg:py-12"
  aria-labelledby="blog-final-cta-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgb(222_243_77_/0.14),transparent_70%)] blur-3xl"></div>
  </div>

  <Container class="relative">
    <div class="mx-auto max-w-5xl overflow-hidden rounded-[1.75rem] border border-white/12 bg-white/[0.03] px-6 py-10 text-center sm:px-10 sm:py-12">
      <p class:list={[eyebrowClass, 'mx-auto w-fit']}>Next Step</p>
      <h2
        id="blog-final-cta-heading"
        class="mt-3 font-display text-2xl font-semibold tracking-tight text-balance text-white sm:text-3xl lg:text-[2.35rem]"
      >
        Ready to Turn Insights Into
        <span class="text-highlight"> Results?</span>
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-white/65 sm:text-base sm:leading-8">
        Let's put the right digital strategy behind your next stage of growth.
      </p>
      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <button
          type="button"
          class:list={[buttonClass.base, buttonClass.gradient, 'w-full shadow-[0_12px_40px_rgb(197_246_61_/0.16)] sm:w-auto']}
          data-quote-open
        >
          Discuss Your Project
          <ArrowUpRight size={16} aria-hidden="true" />
        </button>
        <a href="/services/" class:list={[buttonClass.base, buttonClass.ghost, 'w-full sm:w-auto']}>
          Explore Our Services
        </a>
      </div>
    </div>
  </Container>
</section>
