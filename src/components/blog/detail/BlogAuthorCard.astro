---
import { site } from '../../../config/site';
import type { BlogAuthorSocial, BlogPost } from '../../../types/content';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const iconPaths: Record<string, string> = {
  linkedin:
    'M6.9 8.5H4V20h2.9V8.5zM5.4 3.5A1.7 1.7 0 1 0 5.4 6.9 1.7 1.7 0 0 0 5.4 3.5zM20.5 20h-2.9v-5.7c0-1.6-.6-2.7-2.1-2.7-1.1 0-1.7.8-2 1.5-.1.3-.1.7-.1 1.1V20H10.5s0-9.4 0-10.4H13.4v1.5c.5-.7 1.4-1.8 3.4-1.8 2.5 0 4.2 1.6 4.2 5.1V20z',
  facebook: 'M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3.1l.9-3H13v-1.5c0-.8.7-1.5 1.5-1.5z',
  pinterest:
    'M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.3 9.2-.1-.8-.2-2 0-2.9.2-.8 1.3-5.5 1.3-5.5s-.3-.7-.3-1.6c0-1.5.9-2.6 2-2.6.9 0 1.4.7 1.4 1.5 0 .9-.6 2.3-.9 3.5-.3 1.1.5 1.9 1.5 1.9 1.8 0 3.2-1.9 3.2-4.7 0-2.4-1.8-4.2-4.3-4.2-2.9 0-4.7 2.2-4.7 4.5 0 .9.3 1.8.8 2.3.1.1.1.2.1.3l-.3 1.2c0 .2-.1.2-.3.1-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2-1.3 2.7 1 .3 2 .5 3.1.5 5.5 0 10-4.5 10-10S17.5 2 12 2z',
};

function resolveKey(label: string) {
  const value = label.toLowerCase();
  if (value.includes('linkedin')) return 'linkedin';
  if (value.includes('facebook')) return 'facebook';
  if (value.includes('pinterest')) return 'pinterest';
  return value;
}

const siteLinkedIn = site.socials.find((item) => item.icon === 'linkedin');
const siteFacebook = site.socials.find((item) => item.icon === 'facebook');

const fallbackSocials: BlogAuthorSocial[] = [
  ...(siteLinkedIn ? [{ label: 'LinkedIn', href: siteLinkedIn.href }] : []),
  ...(siteFacebook ? [{ label: 'Facebook', href: siteFacebook.href }] : []),
  { label: 'Pinterest', href: 'https://www.pinterest.com/' },
];

const socials = (post.authorSocials?.length ? post.authorSocials : fallbackSocials).filter((item) =>
  Boolean(item.href),
);
---

{
  post.authorName && (
    <aside
      class="rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-4 sm:px-5 sm:py-5"
      aria-label="About the author"
    >
      <div class="flex items-start gap-3.5 sm:gap-4">
        {post.authorAvatar ? (
          <img
            src={post.authorAvatar}
            alt=""
            width={48}
            height={48}
            loading="lazy"
            decoding="async"
            class="h-12 w-12 shrink-0 rounded-full border border-white/15 object-cover"
          />
        ) : (
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-highlight/30 bg-highlight/10 font-display text-lg font-semibold text-highlight">
            {post.authorName.slice(0, 1).toUpperCase()}
          </span>
        )}

        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-[0.65rem] font-semibold tracking-[0.14em] text-white/45 uppercase">Written by</p>
              <p class="mt-1 font-display text-lg font-semibold tracking-tight text-white">{post.authorName}</p>
            </div>

            {
              socials.length > 0 && (
                <ul class="flex flex-wrap items-center gap-2" aria-label={`${post.authorName} on social media`}>
                  {socials.map((item) => {
                    const key = resolveKey(item.label);
                    const path = iconPaths[key];
                    if (!path) return null;
                    return (
                      <li>
                        <a
                          href={item.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-white/[0.03] text-white/70 transition hover:border-highlight/40 hover:bg-highlight/10 hover:text-highlight"
                          aria-label={`${post.authorName} on ${item.label}`}
                        >
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d={path} />
                          </svg>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )
            }
          </div>

          <p class="mt-2 text-sm leading-6 text-white/60">
            Insights from the VectorCodex team on SEO, web development, and digital marketing.
          </p>
        </div>
      </div>
    </aside>
  )
}
