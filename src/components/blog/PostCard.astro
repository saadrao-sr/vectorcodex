---
import { formatDate } from '../../lib/seo/format';
import type { BlogPost } from '../../types/content';

interface Props {
  post: BlogPost;
  /** When true, card is visual-only until a published WordPress post exists. */
  placeholder?: boolean;
}

const { post, placeholder = false } = Astro.props;
const href = placeholder ? undefined : `/blog/${post.slug}/`;
const date = formatDate(post.publishedAt);
const titleClass =
  'mt-3 font-display text-xl leading-tight font-semibold tracking-tight sm:text-2xl group-hover:text-highlight';
---

<article class="h-full">
  {
    href ? (
      <a
        href={href}
        class="group flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] transition hover:border-highlight/40"
      >
        <div class="aspect-[16/9] overflow-hidden bg-surface">
          {post.image ? (
            <img
              src={post.image.src}
              alt={post.image.alt}
              width={post.image.width}
              height={post.image.height}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
            />
          ) : (
            <div class="flex h-full items-end p-4 text-sm font-semibold text-highlight">Article</div>
          )}
        </div>
        <div class="flex flex-1 flex-col p-5">
          {post.categories[0] && (
            <p class="text-xs font-semibold tracking-[0.16em] text-highlight uppercase">{post.categories[0].name}</p>
          )}
          <h2 class={titleClass}>{post.title}</h2>
          {post.excerpt && <p class="mt-3 line-clamp-3 text-sm leading-6 text-white/70">{post.excerpt}</p>}
          {date && (
            <time datetime={post.publishedAt} class="mt-5 text-sm text-white/50">
              {date}
            </time>
          )}
        </div>
      </a>
    ) : (
      <div class="group flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03]">
        <div class="relative aspect-[16/9] overflow-hidden bg-surface">
          {post.image ? (
            <img
              src={post.image.src}
              alt={post.image.alt}
              width={post.image.width}
              height={post.image.height}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover opacity-90"
            />
          ) : (
            <div class="flex h-full items-end p-4 text-sm font-semibold text-highlight">Article</div>
          )}
          <span class="absolute top-3 left-3 rounded-full border border-highlight/40 bg-[#0D120C]/75 px-2.5 py-1 text-[0.6rem] font-semibold tracking-[0.12em] text-highlight uppercase backdrop-blur-sm">
            Coming soon
          </span>
        </div>
        <div class="flex flex-1 flex-col p-5">
          {post.categories[0] && (
            <p class="text-xs font-semibold tracking-[0.16em] text-highlight uppercase">{post.categories[0].name}</p>
          )}
          <h2 class={titleClass}>{post.title}</h2>
          {post.excerpt && <p class="mt-3 line-clamp-3 text-sm leading-6 text-white/70">{post.excerpt}</p>}
          {date && (
            <time datetime={post.publishedAt} class="mt-5 text-sm text-white/50">
              {date}
            </time>
          )}
        </div>
      </div>
    )
  }
</article>
