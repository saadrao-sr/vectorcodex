---
/**
 * Shared full-bleed tech banner used across page heroes / band sections.
 * Matches HomeProjectCta + footer atmosphere without competing with content.
 */
interface Props {
  /** Image focal point. */
  objectPosition?: string;
  /** Eager load for above-the-fold heroes. */
  eager?: boolean;
  class?: string;
}

const {
  objectPosition = 'center 28%',
  eager = false,
  class: className,
} = Astro.props;
---

<div
  class:list={['section-banner-bg pointer-events-none absolute inset-0 overflow-hidden', className]}
  aria-hidden="true"
>
  <img
    src="/images/hero-tech.jpg"
    alt=""
    width={1920}
    height={1080}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
    class="section-banner-bg__image absolute inset-0 h-full w-full object-cover"
    style={`object-position: ${objectPosition}`}
  />
  <div class="section-banner-bg__scrim absolute inset-0"></div>
  <div class="section-banner-bg__wash absolute inset-0"></div>
  <div class="section-banner-bg__grid absolute inset-0"></div>
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-highlight/40 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-highlight/20 to-transparent"></div>
</div>

<style>
  .section-banner-bg__image {
    opacity: 0.42;
    filter: saturate(0.88) contrast(1.06);
  }

  .section-banner-bg__scrim {
    background:
      linear-gradient(180deg, rgb(13 18 12 / 0.78) 0%, rgb(13 18 12 / 0.88) 48%, rgb(13 18 12 / 0.96) 100%),
      linear-gradient(90deg, rgb(13 18 12 / 0.55) 0%, transparent 34%, transparent 66%, rgb(13 18 12 / 0.55) 100%);
  }

  .section-banner-bg__wash {
    background:
      radial-gradient(ellipse 78% 55% at 50% -8%, rgb(222 243 77 / 0.14), transparent 58%),
      radial-gradient(ellipse 42% 38% at 88% 78%, rgb(197 246 61 / 0.08), transparent 70%),
      linear-gradient(135deg, rgb(197 246 61 / 0.05), transparent 42%, rgb(246 239 92 / 0.04));
  }

  .section-banner-bg__grid {
    opacity: 0.14;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(180deg, rgb(0 0 0 / 0.55), transparent 90%);
  }
</style>
