---
import { site } from '../../config/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<img
  src={site.logo.path}
  alt={site.logo.alt}
  width={site.logo.width}
  height={site.logo.height}
  decoding="async"
  class:list={['h-8 w-auto max-w-[10.5rem] object-contain object-left sm:h-9 sm:max-w-[12rem]', className]}
/>
