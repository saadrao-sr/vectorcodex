---
import type { Crumb } from '../../types/content';

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-white/60">
    {
      items.map((item, index) => {
        const last = index === items.length - 1;
        return (
          <li class="flex min-w-0 items-center gap-2">
            {index > 0 && (
              <span aria-hidden="true" class="text-white/30">
                /
              </span>
            )}
            {last ? (
              <span aria-current="page" class="truncate text-white">
                {item.name}
              </span>
            ) : (
              <a href={item.href} class="truncate transition hover:text-highlight">
                {item.name}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
