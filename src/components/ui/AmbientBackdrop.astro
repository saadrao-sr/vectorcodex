---
interface Props {
  /** Visual density / motif for the section. */
  variant?: 'orbs' | 'mesh' | 'drift';
  class?: string;
}

const { variant = 'orbs', class: className } = Astro.props;
---

<div class:list={['ambient-backdrop pointer-events-none absolute inset-0 overflow-hidden', className]} aria-hidden="true" data-variant={variant}>
  {
    variant === 'orbs' && (
      <>
        <div class="ambient-backdrop__orb ambient-backdrop__orb--a absolute top-[12%] left-[8%] h-52 w-52 rounded-full bg-[radial-gradient(circle,rgb(222_243_77_/0.14),transparent_70%)] blur-2xl" />
        <div class="ambient-backdrop__orb ambient-backdrop__orb--b absolute right-[10%] bottom-[8%] h-64 w-64 rounded-full bg-[radial-gradient(circle,rgb(197_246_61_/0.1),transparent_72%)] blur-2xl" />
        <div class="ambient-backdrop__ring absolute top-[40%] right-[18%] h-28 w-28 rounded-full border border-highlight/15" />
      </>
    )
  }
  {
    variant === 'mesh' && (
      <>
        <div class="ambient-backdrop__orb ambient-backdrop__orb--a absolute top-10 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgb(222_243_77_/0.12),transparent_70%)] blur-2xl" />
        <div class="ambient-backdrop__beam ambient-backdrop__beam--a absolute top-0 left-[20%] h-full w-px bg-gradient-to-b from-transparent via-highlight/25 to-transparent" />
        <div class="ambient-backdrop__beam ambient-backdrop__beam--b absolute top-0 right-[28%] h-full w-px bg-gradient-to-b from-transparent via-lime/20 to-transparent" />
        <div class="ambient-backdrop__chip absolute bottom-[18%] left-[12%] h-16 w-16 rotate-12 rounded-2xl border border-highlight/20 bg-highlight/5" />
      </>
    )
  }
  {
    variant === 'drift' && (
      <>
        <div class="ambient-backdrop__orb ambient-backdrop__orb--a absolute top-[18%] left-[14%] h-48 w-48 rounded-full bg-[radial-gradient(circle,rgb(222_243_77_/0.11),transparent_70%)] blur-2xl" />
        <div class="ambient-backdrop__orb ambient-backdrop__orb--b absolute right-[12%] bottom-[14%] h-56 w-56 rounded-full bg-[radial-gradient(circle,rgb(246_239_92_/0.08),transparent_72%)] blur-2xl" />
        <div class="ambient-backdrop__dot ambient-backdrop__dot--a absolute top-[30%] right-[22%] h-2 w-2 rounded-full bg-highlight/50" />
        <div class="ambient-backdrop__dot ambient-backdrop__dot--b absolute bottom-[28%] left-[24%] h-1.5 w-1.5 rounded-full bg-lime/45" />
        <div class="ambient-backdrop__dot ambient-backdrop__dot--c absolute top-[58%] left-[40%] h-1 w-1 rounded-full bg-gold/40" />
      </>
    )
  }
</div>
