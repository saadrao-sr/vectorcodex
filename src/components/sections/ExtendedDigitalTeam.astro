---
import { ArrowUpRight, Briefcase, Users } from 'lucide-react';
import { talentProfiles } from '../../config/team-talent';
import TalentCarousel from '../interactive/TalentCarousel';
import Container from '../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../ui/styles';

const offerings = [
  {
    title: 'Full-Service Agency',
    text: 'SEO, web development, social media marketing, and PPC managed under one roof.',
    Icon: Briefcase,
    accent: 'from-highlight/18 via-transparent to-transparent',
  },
  {
    title: 'Dedicated Resources',
    text: 'Hire dedicated SEO specialists, developers, content strategists, PPC specialists, and digital marketing professionals to extend your existing team.',
    Icon: Users,
    accent: 'from-lime/16 via-transparent to-transparent',
  },
] as const;
---

<section
  id="extended-team"
  class="relative isolate overflow-hidden border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="extended-team-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute top-16 left-[8%] h-72 w-72 rounded-full bg-[radial-gradient(circle,rgb(222_243_77_/0.1),transparent_70%)] blur-2xl"></div>
    <div class="absolute right-[6%] bottom-10 h-64 w-64 rounded-full bg-[radial-gradient(circle,rgb(197_246_61_/0.06),transparent_70%)] blur-2xl"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-highlight/35 to-transparent"></div>
  </div>

  <Container class="relative">
    <div class="grid items-stretch gap-8 sm:gap-8 md:grid-cols-2 md:gap-6 lg:gap-10 xl:gap-12">
      <div class="extended-team__copy flex h-full min-w-0 flex-col">
        <p class:list={[eyebrowClass, 'self-start']}>Flexible Digital Expertise</p>
        <h2
          id="extended-team-heading"
          class="mt-3 font-display text-[1.75rem] font-semibold tracking-tight text-balance text-white sm:text-[1.85rem] md:text-[1.7rem] lg:text-[2.35rem] lg:leading-[1.15]"
        >
          More Than an Agency.
          <span class="text-highlight"> Your Extended Digital Team.</span>
        </h2>
        <p class="mt-3 font-display text-base font-semibold tracking-tight text-white/90 sm:text-lg md:text-base lg:text-xl">
          Need an Agency or Skilled People to Grow Your Team?
        </p>
        <p class="mt-2.5 max-w-xl text-sm leading-6 text-white/65 md:text-[0.9rem] md:leading-6 lg:text-base lg:leading-7">
          Whether you need a complete digital partner to manage your online growth or dedicated professionals to support your in-house department, VectorCodex connects you with the expertise your business needs.
        </p>

        <ul class="mt-5 grid gap-2.5 sm:mt-6 sm:gap-3 md:gap-2.5 lg:gap-3">
          {
            offerings.map((item) => {
              const Icon = item.Icon;
              return (
                <li>
                  <article class="group relative overflow-hidden rounded-[1.25rem] border border-white/10 bg-white/[0.03] p-3.5 transition duration-300 hover:border-highlight/45 hover:bg-white/[0.05] sm:rounded-[1.5rem] sm:p-4 md:p-3.5 lg:p-5">
                    <div
                      class:list={[
                        'pointer-events-none absolute inset-0 bg-gradient-to-br opacity-90 transition duration-300 group-hover:opacity-100',
                        item.accent,
                      ]}
                      aria-hidden="true"
                    />
                    <div
                      class="pointer-events-none absolute -top-12 -right-10 h-28 w-28 rounded-full bg-highlight/10 blur-2xl transition duration-500 group-hover:bg-highlight/18"
                      aria-hidden="true"
                    />
                    <div class="relative flex gap-3 sm:gap-3.5">
                      <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-highlight/25 bg-highlight/10 text-highlight shadow-[0_0_28px_rgb(222_243_77_/0.12)] transition duration-300 group-hover:border-highlight/50 sm:h-11 sm:w-11 sm:rounded-2xl md:h-10 md:w-10 lg:h-11 lg:w-11">
                        <Icon size={18} aria-hidden="true" />
                      </div>
                      <div class="min-w-0">
                        <h3 class="font-display text-base font-semibold tracking-tight text-white md:text-[0.95rem] lg:text-lg">{item.title}</h3>
                        <p class="mt-1 text-sm leading-6 text-white/65 md:text-[0.8125rem] md:leading-5 lg:text-sm lg:leading-6">{item.text}</p>
                      </div>
                    </div>
                  </article>
                </li>
              );
            })
          }
        </ul>

        <div class="mt-auto flex flex-col gap-3 pt-6 sm:flex-row sm:flex-wrap sm:pt-7 md:flex-col md:pt-5 lg:flex-row lg:pt-7">
          <a
            href="/about/#meet-the-team"
            class:list={[
              buttonClass.base,
              buttonClass.gradient,
              'w-full shadow-[0_12px_40px_rgb(197_246_61_/0.16)] sm:w-auto md:w-full lg:w-auto',
            ]}
          >
            Explore Team Solutions
          </a>
          <button
            type="button"
            class:list={[buttonClass.base, buttonClass.ghost, 'w-full sm:w-auto md:w-full lg:w-auto']}
            data-team-requirements-open
          >
            Discuss Your Requirements
            <ArrowUpRight size={16} aria-hidden="true" />
          </button>
        </div>
      </div>

      <div class="extended-team__gallery relative flex min-h-[22rem] min-w-0 flex-col sm:min-h-[24rem] md:min-h-0 md:h-full">
        <TalentCarousel client:visible items={talentProfiles} />
      </div>
    </div>
  </Container>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .extended-team__copy,
    .extended-team__gallery {
      opacity: 0;
      transform: translateY(14px);
      animation: extended-team-rise 0.65s ease forwards;
    }

    .extended-team__copy {
      animation-delay: 40ms;
    }

    .extended-team__gallery {
      animation-delay: 100ms;
    }

    :global(.talent-slide) {
      animation: talent-slide-in 0.4s ease;
    }
  }

  @keyframes extended-team-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes talent-slide-in {
    from {
      opacity: 0.45;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 768px) {
    .extended-team__gallery :global(astro-island),
    .extended-team__gallery :global(astro-island > *) {
      display: flex;
      height: 100%;
      min-height: 100%;
      flex: 1 1 auto;
      flex-direction: column;
    }
  }
</style>
