---
import { ArrowUpRight } from 'lucide-react';
import { servicesFaqs, servicesFaqsIntro } from '../../config/services-page';
import FaqAccordion from '../interactive/FaqAccordion';
import AmbientBackdrop from '../ui/AmbientBackdrop.astro';
import Container from '../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../ui/styles';

const intro = servicesFaqsIntro;
---

<section
  id="services-faq"
  class="services-faq relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="services-faq-heading"
>
  <AmbientBackdrop variant="orbs" />

  <Container class="relative">
    <div class="services-faq__layout">
      <div class="services-faq__copy min-w-0">
        <p class:list={[eyebrowClass, 'w-fit max-w-full']}>{intro.eyebrow}</p>
        <h2
          id="services-faq-heading"
          class="mt-3 max-w-xl font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.25rem] lg:text-[2.45rem] lg:leading-[1.08]"
        >
          {intro.titleBefore}
          <span class="text-highlight"> {intro.titleHighlight}</span>
        </h2>
        <p class="mt-3 max-w-md text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-8">
          {intro.text}
        </p>
        <div class="mt-5 flex flex-col gap-3 sm:mt-6 sm:flex-row sm:flex-wrap">
          <button
            type="button"
            class:list={[
              buttonClass.base,
              buttonClass.gradient,
              'w-full shadow-[0_14px_40px_rgb(197_246_61_/0.18)] sm:w-auto',
            ]}
            data-quote-open
          >
            Discuss Your Project
            <ArrowUpRight size={16} aria-hidden="true" />
          </button>
          <a href="/contact/" class:list={[buttonClass.base, buttonClass.ghost, 'w-full sm:w-auto']}>
            Contact Us
          </a>
        </div>
      </div>

      <div class="services-faq__accordion min-w-0">
        <FaqAccordion client:visible items={servicesFaqs} />
      </div>
    </div>
  </Container>
</section>

<style>
  .services-faq__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .services-faq__layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 2rem;
    }

    .services-faq__copy {
      position: sticky;
      top: 6.5rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .services-faq__copy,
    .services-faq__accordion {
      opacity: 0;
      transform: translateY(14px);
      animation: services-faq-rise 0.7s ease forwards;
    }

    .services-faq__copy {
      animation-delay: 60ms;
    }

    .services-faq__accordion {
      animation-delay: 140ms;
    }
  }

  @keyframes services-faq-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
