---
import { ArrowUpRight } from 'lucide-react';
import Container from '../../ui/Container.astro';
import SectionBannerBg from '../../ui/SectionBannerBg.astro';
import { buttonClass, eyebrowClass } from '../../ui/styles';
---

<section
  id="case-study-final-cta"
  class="relative isolate overflow-hidden border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="case-study-final-cta-heading"
>
  <SectionBannerBg />

  <Container class="relative">
    <div class="mx-auto max-w-3xl overflow-hidden rounded-[1.75rem] border border-white/12 bg-white/[0.03] px-6 py-10 text-center sm:px-10 sm:py-12">
      <p class:list={[eyebrowClass, 'mx-auto w-fit']}>Next Step</p>
      <h2
        id="case-study-final-cta-heading"
        class="mt-3 font-display text-2xl font-semibold tracking-tight text-balance text-white sm:text-3xl lg:text-[2.35rem]"
      >
        Ready to Create Your Own
        <span class="text-highlight"> Growth Story?</span>
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-white/65 sm:text-base sm:leading-8">
        Tell us about your market, constraints, and goals. We will outline a clear next step — without inventing outcomes
        you cannot measure.
      </p>
      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <button
          type="button"
          class:list={[buttonClass.base, buttonClass.gradient, 'w-full shadow-[0_12px_40px_rgb(197_246_61_/0.16)] sm:w-auto']}
          data-quote-open
        >
          Discuss Your Project
          <ArrowUpRight size={16} aria-hidden="true" />
        </button>
        <a href="/services/" class:list={[buttonClass.base, buttonClass.ghost, 'w-full sm:w-auto']}>
          Explore Services
        </a>
      </div>
    </div>
  </Container>
</section>
