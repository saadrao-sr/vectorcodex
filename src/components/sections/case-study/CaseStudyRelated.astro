---
import { ArrowUpRight } from 'lucide-react';
import { getRelatedCaseStudies } from '../../../config/case-studies';
import type { CaseStudy } from '../../../types/content';
import Container from '../../ui/Container.astro';
import { eyebrowClass } from '../../ui/styles';

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const related = getRelatedCaseStudies(study, 3);
---

{
  related.length > 0 && (
    <section
      id="related-case-studies"
      class="cs-related relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-8 sm:py-10 lg:py-12"
      aria-labelledby="related-heading"
    >
      <Container>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between sm:gap-4">
          <div class="min-w-0">
            <p class={eyebrowClass}>Related Case Studies</p>
            <h2
              id="related-heading"
              class="mt-2.5 font-display text-xl font-semibold tracking-tight text-balance text-white sm:mt-3 sm:text-2xl lg:text-[1.75rem]"
            >
              More project stories
            </h2>
          </div>
          <a
            href="/case-studies/"
            class="inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-highlight"
          >
            All case studies
            <ArrowUpRight size={15} aria-hidden="true" />
          </a>
        </div>

        <ul class="cs-related__grid mt-5 sm:mt-6">
          {related.map((item) => (
            <li>
              <a
                href={item.path}
                class="group flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] transition hover:border-highlight/40 hover:bg-white/[0.05]"
              >
                <div class="aspect-[16/9] overflow-hidden bg-surface">
                  {item.image ? (
                    <img
                      src={item.image.src}
                      alt={item.image.alt}
                      width={item.image.width ?? 800}
                      height={item.image.height ?? 450}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                    />
                  ) : (
                    <div class="flex h-full items-end bg-gradient-to-br from-highlight/15 via-transparent to-transparent p-3.5">
                      <span class="text-xs font-semibold text-highlight">Case study</span>
                    </div>
                  )}
                </div>
                <div class="flex flex-1 flex-col px-3.5 py-3.5 sm:px-4 sm:py-4">
                  <p class="text-[0.6rem] font-semibold tracking-[0.14em] text-highlight uppercase">
                    {item.service}
                  </p>
                  <h3 class="mt-1.5 font-display text-base font-semibold tracking-tight text-white transition group-hover:text-highlight sm:text-[1.05rem]">
                    {item.title}
                  </h3>
                  <p class="mt-1.5 line-clamp-2 text-sm leading-5 text-white/65">{item.summary}</p>
                  <span class="mt-auto inline-flex items-center gap-1 pt-3 text-xs font-semibold text-highlight">
                    View project
                    <ArrowUpRight size={13} aria-hidden="true" />
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </Container>
    </section>
  )
}

<style>
  .cs-related__grid {
    display: grid;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .cs-related__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (min-width: 900px) {
    .cs-related__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
