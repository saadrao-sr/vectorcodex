---
import type { CaseStudy } from '../../../types/content';
import Container from '../../ui/Container.astro';
import { eyebrowClass } from '../../ui/styles';

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const strategy = study.strategy;
---

{
  strategy && (
    <section
      id="our-strategy"
      class="cs-strategy relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-8 sm:py-10 lg:py-12"
      aria-labelledby="strategy-heading"
    >
      <Container>
        <div class="cs-strategy__layout">
          <div class="cs-strategy__intro min-w-0">
            <p class={eyebrowClass}>Our Strategy</p>
            <h2
              id="strategy-heading"
              class="mt-2.5 font-display text-xl font-semibold tracking-tight text-balance text-white sm:mt-3 sm:text-2xl lg:text-[1.75rem]"
            >
              Project-specific priorities, not a recycled playbook
            </h2>
            <p class="mt-3 text-sm leading-7 text-white/70 sm:text-[0.95rem] sm:leading-7">{strategy.body}</p>

            {study.serviceLinks && study.serviceLinks.length > 0 && (
              <div class="mt-4 sm:mt-5">
                <h3 class="text-[0.65rem] font-semibold tracking-[0.14em] text-white/45 uppercase">
                  Services in this engagement
                </h3>
                <ul class="mt-2.5 flex flex-wrap gap-2">
                  {study.serviceLinks.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="inline-flex rounded-full border border-white/15 bg-white/[0.04] px-3 py-1 text-xs font-semibold text-white/80 transition hover:border-highlight/40 hover:text-highlight"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          {strategy.points && strategy.points.length > 0 && (
            <ol class="cs-strategy__points min-w-0 space-y-2.5">
              {strategy.points.map((point, index) => (
                <li class="flex gap-3 rounded-xl border border-white/10 bg-white/[0.03] px-3.5 py-3 sm:gap-3.5 sm:px-4">
                  <span class="font-display text-sm font-semibold text-highlight sm:text-base">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <p class="text-sm leading-6 text-white/75">{point}</p>
                </li>
              ))}
            </ol>
          )}
        </div>
      </Container>
    </section>
  )
}

<style>
  .cs-strategy__layout {
    display: grid;
    align-items: start;
    gap: 1.25rem;
  }

  @media (min-width: 900px) {
    .cs-strategy__layout {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: 2.25rem;
    }
  }
</style>
