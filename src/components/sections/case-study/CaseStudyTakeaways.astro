---
import type { CaseStudy } from '../../../types/content';
import Container from '../../ui/Container.astro';
import { eyebrowClass } from '../../ui/styles';

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
---

{
  study.takeaways && study.takeaways.length > 0 && (
    <section
      id="key-takeaways"
      class="relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
      aria-labelledby="takeaways-heading"
    >
      <Container>
        <div class="mx-auto max-w-3xl">
          <p class={eyebrowClass}>Key Takeaways</p>
          <h2
            id="takeaways-heading"
            class="mt-3 font-display text-2xl font-semibold tracking-tight text-balance text-white sm:text-3xl"
          >
            What this engagement reinforces
          </h2>
          <ul class="mt-6 space-y-3">
            {study.takeaways.map((item, index) => (
              <li class="flex gap-4 rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-4">
                <span class="font-display text-sm font-semibold text-highlight">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <p class="text-sm leading-6 text-white/75 sm:text-[0.95rem]">{item}</p>
              </li>
            ))}
          </ul>
        </div>
      </Container>
    </section>
  )
}
