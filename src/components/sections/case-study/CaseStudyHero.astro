---
import { ArrowUpRight } from 'lucide-react';
import type { CaseStudy, Crumb } from '../../../types/content';
import Container from '../../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../../ui/styles';

interface Props {
  study: CaseStudy;
  crumbs: Crumb[];
}

const { study, crumbs } = Astro.props;
const heroImage = study.heroImage ?? study.image;
const services = study.servicesDelivered?.length
  ? study.servicesDelivered
  : study.service
    ? [study.service]
    : [];

const metaItems = [
  study.clientLabel ? { label: 'Client', value: study.clientLabel } : null,
  study.industry || study.sector ? { label: 'Industry', value: study.industry || study.sector } : null,
  study.duration ? { label: 'Duration', value: study.duration } : null,
  study.market ? { label: 'Market', value: study.market } : null,
].filter((item): item is { label: string; value: string } => Boolean(item));
---

<section
  id="case-study-hero"
  class="case-study-hero relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] pt-[calc(var(--header-height)+1.5rem)] pb-10 sm:pt-[calc(var(--header-height)+1.75rem)] sm:pb-12 lg:pb-14"
  aria-labelledby="case-study-hero-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute top-16 left-[8%] h-48 w-48 rounded-full bg-[radial-gradient(circle,rgb(222_243_77_/0.1),transparent_70%)] blur-3xl sm:h-56 sm:w-56"></div>
    <div class="absolute right-[6%] bottom-8 h-44 w-44 rounded-full bg-[radial-gradient(circle,rgb(197_246_61_/0.07),transparent_70%)] blur-3xl sm:h-52 sm:w-52"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-highlight/30 to-transparent"></div>
  </div>

  <Container class="relative">
    <nav aria-label="Breadcrumb" class="case-study-hero__crumbs">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.8125rem] leading-none text-white/55">
        {
          crumbs.map((item, index) => {
            const last = index === crumbs.length - 1;
            return (
              <li class="inline-flex max-w-full items-center gap-2">
                {index > 0 && <span aria-hidden="true" class="text-white/30">/</span>}
                {last ? (
                  <span aria-current="page" class="truncate text-highlight">
                    {item.name}
                  </span>
                ) : (
                  <a href={item.href} class="truncate transition hover:text-highlight">
                    {item.name}
                  </a>
                )}
              </li>
            );
          })
        }
      </ol>
    </nav>

    <div class="case-study-hero__layout">
      <div class="case-study-hero__copy min-w-0">
        <p class:list={[eyebrowClass, 'w-fit max-w-full']}>
          {study.industry || study.sector} · {study.service}
        </p>

        <h1
          id="case-study-hero-heading"
          class="mt-3 max-w-2xl font-display text-[1.75rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:mt-3.5 sm:text-[2.25rem] sm:leading-[1.08] lg:text-[2.65rem] lg:leading-[1.06]"
        >
          {study.title}
        </h1>

        <p class="mt-3.5 max-w-xl text-sm leading-7 text-white/65 sm:mt-4 sm:text-[0.95rem] sm:leading-7">
          {study.intro || study.summary}
        </p>

        {
          study.placeholder && (
            <p
              class="mt-4 rounded-2xl border border-highlight/30 bg-highlight/10 px-4 py-3 text-sm leading-6 text-white/90"
              role="status"
            >
              Placeholder case study. Client identity and verified outcomes will replace this template when cleared for
              publication.
            </p>
          )
        }

        {
          metaItems.length > 0 && (
            <dl class="case-study-hero__meta mt-5 grid grid-cols-2 gap-2.5 sm:mt-6 sm:gap-3">
              {metaItems.map((item) => (
                <div class="rounded-2xl border border-white/10 bg-white/[0.03] px-3.5 py-3 sm:px-4">
                  <dt class="text-[0.65rem] font-semibold tracking-[0.14em] text-white/45 uppercase">{item.label}</dt>
                  <dd class="mt-1 text-sm leading-5 font-medium text-white">{item.value}</dd>
                </div>
              ))}
            </dl>
          )
        }

        {
          services.length > 0 && (
            <div class="mt-5 sm:mt-6">
              <p class="text-[0.65rem] font-semibold tracking-[0.14em] text-white/45 uppercase">Services</p>
              <ul class="mt-2.5 flex flex-wrap gap-2">
                {study.serviceLinks?.length
                  ? study.serviceLinks.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          class="inline-flex rounded-full border border-highlight/30 bg-highlight/10 px-3 py-1 text-xs font-semibold text-highlight transition hover:bg-highlight/20"
                        >
                          {link.label}
                        </a>
                      </li>
                    ))
                  : services.map((label) => (
                      <li>
                        <span class="inline-flex rounded-full border border-white/15 bg-white/[0.04] px-3 py-1 text-xs font-semibold text-white/80">
                          {label}
                        </span>
                      </li>
                    ))}
              </ul>
            </div>
          )
        }

        <div class="mt-6 flex flex-col gap-2.5 sm:mt-7 sm:flex-row sm:flex-wrap sm:gap-3">
          <button type="button" class:list={[buttonClass.base, buttonClass.gradient, 'w-full sm:w-auto']} data-quote-open>
            Discuss a Similar Project
            <ArrowUpRight size={16} aria-hidden="true" />
          </button>
          <a href="/services/" class:list={[buttonClass.base, buttonClass.ghost, 'w-full sm:w-auto']}>
            Explore Services
          </a>
        </div>
      </div>

      {
        heroImage && (
          <div class="case-study-hero__media min-w-0">
            <div class="overflow-hidden rounded-[1.5rem] border border-white/12 bg-surface shadow-[0_20px_60px_rgb(0_0_0_/0.32)] sm:rounded-[1.75rem]">
              <img
                src={heroImage.src}
                alt={heroImage.alt}
                width={heroImage.width ?? 1200}
                height={heroImage.height ?? 800}
                fetchpriority="high"
                decoding="async"
                class="aspect-[4/3] h-full w-full object-cover"
              />
            </div>
          </div>
        )
      }
    </div>
  </Container>
</section>

<style>
  .case-study-hero__crumbs {
    margin-bottom: 1.25rem;
  }

  .case-study-hero__layout {
    display: grid;
    align-items: start;
    gap: 1.75rem;
  }

  .case-study-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .case-study-hero__meta {
    width: 100%;
  }

  .case-study-hero__media {
    width: 100%;
  }

  @media (min-width: 640px) {
    .case-study-hero__crumbs {
      margin-bottom: 1.5rem;
    }

    .case-study-hero__layout {
      gap: 2rem;
    }
  }

  /* Side-by-side before Tailwind lg so ~1000px viewports stay aligned. */
  @media (min-width: 900px) {
    .case-study-hero__layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 2.5rem;
      align-items: center;
    }

    .case-study-hero__media {
      position: sticky;
      top: calc(var(--header-height) + 1rem);
    }
  }

  @media (min-width: 1024px) {
    .case-study-hero__layout {
      gap: 3rem;
    }
  }
</style>
