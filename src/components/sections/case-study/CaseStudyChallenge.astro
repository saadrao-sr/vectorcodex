---
import type { CaseStudy } from '../../../types/content';
import Container from '../../ui/Container.astro';
import { eyebrowClass } from '../../ui/styles';

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const challenge = study.challenge;
---

{
  challenge && (
    <section
      id="the-challenge"
      class="relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
      aria-labelledby="challenge-heading"
    >
      <Container>
        <div class="mx-auto max-w-3xl">
          <p class={eyebrowClass}>The Challenge</p>
          <h2
            id="challenge-heading"
            class="mt-3 font-display text-2xl font-semibold tracking-tight text-balance text-white sm:text-3xl"
          >
            Problems and opportunities that shaped the work
          </h2>
          <p class="mt-4 text-sm leading-7 text-white/70 sm:text-base sm:leading-8">{challenge.body}</p>
          {challenge.points && challenge.points.length > 0 && (
            <ul class="mt-6 grid gap-3 sm:grid-cols-2">
              {challenge.points.map((point, index) => (
                <li class="rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-4">
                  <span class="font-display text-xs font-semibold tracking-[0.14em] text-highlight">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <p class="mt-2 text-sm leading-6 text-white/75">{point}</p>
                </li>
              ))}
            </ul>
          )}
        </div>
      </Container>
    </section>
  )
}
