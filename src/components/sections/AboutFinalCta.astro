---
import { ArrowRight, ArrowUpRight } from 'lucide-react';
import { buttonClass, eyebrowClass } from '../ui/styles';
---

<section
  id="about-final-cta"
  class="about-final-cta relative isolate overflow-hidden border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="about-final-cta-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="about-final-cta__glow absolute top-1/2 left-1/2 h-[20rem] w-[20rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgb(222_243_77_/0.16),transparent_68%)] blur-2xl sm:h-[24rem] sm:w-[24rem]"></div>
    <div class="about-final-cta__orb absolute top-[14%] left-[8%] h-24 w-24 rounded-full border border-highlight/15 bg-highlight/5"></div>
    <div class="about-final-cta__orb about-final-cta__orb--delay absolute right-[10%] bottom-[16%] h-20 w-20 rotate-12 rounded-[1.25rem] border border-lime/20 bg-gradient-to-br from-lime/10 to-gold/5"></div>
    <div class="about-final-cta__arc absolute top-[22%] right-[18%] h-40 w-40 rounded-full border border-highlight/10"></div>
    <div class="about-final-cta__arc about-final-cta__arc--inner absolute top-[28%] right-[22%] h-24 w-24 rounded-full border border-dashed border-highlight/15"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-highlight/40 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-highlight/25 to-transparent"></div>
    <svg class="absolute inset-0 h-full w-full opacity-[0.06]" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <pattern id="about-final-cta-grid" width="52" height="52" patternUnits="userSpaceOnUse">
          <path d="M52 0H0V52" fill="none" stroke="rgb(222 243 77)" stroke-width="0.6"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#about-final-cta-grid)"></rect>
    </svg>
  </div>

  <div class="relative mx-auto w-full max-w-6xl px-4 text-center sm:px-6 lg:px-8">
    <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>Let's Create What's Next</p>

    <h2
      id="about-final-cta-heading"
      class="mt-3 font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.25rem] lg:text-[2.45rem] lg:leading-[1.08]"
    >
      Your Ambition Deserves
      <span class="text-highlight"> More Than Ordinary</span>
      Digital Solutions.
    </h2>

    <p class="mx-auto mt-3 max-w-3xl text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-8">
      Whether you're building something new, transforming your digital presence, or looking for the right team to support your growth, VectorCodex is ready to help turn your next big idea into reality.
    </p>

    <div class="mt-5 flex flex-col items-center justify-center gap-3 sm:mt-6 sm:flex-row sm:gap-4">
      <button
        type="button"
        class:list={[
          buttonClass.base,
          buttonClass.gradient,
          'group w-full px-7 shadow-[0_16px_48px_rgb(197_246_61_/0.2)] transition duration-300 hover:-translate-y-0.5 hover:shadow-[0_20px_56px_rgb(197_246_61_/0.28)] motion-reduce:transform-none sm:w-auto',
        ]}
        data-quote-open
      >
        Let's Start a Conversation
        <ArrowRight
          size={16}
          aria-hidden="true"
          className="transition duration-300 group-hover:translate-x-0.5"
        />
      </button>
      <a
        href="/services/"
        class:list={[buttonClass.base, buttonClass.ghost, 'group w-full sm:w-auto']}
      >
        Explore Our Services
        <ArrowUpRight
          size={16}
          aria-hidden="true"
          className="transition duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </div>

    <p class="mt-5 text-xs tracking-[0.08em] text-white/45 sm:text-sm">
      Great ideas deserve the right digital partner.
    </p>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .about-final-cta__glow {
      animation: about-final-cta-pulse 7s ease-in-out infinite;
    }

    .about-final-cta__orb {
      animation: about-final-cta-float 9s ease-in-out infinite;
    }

    .about-final-cta__orb--delay {
      animation-delay: -3.5s;
    }

    .about-final-cta__arc--inner {
      animation: about-final-cta-spin 28s linear infinite;
    }
  }

  @keyframes about-final-cta-pulse {
    0%,
    100% {
      opacity: 0.7;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.08);
    }
  }

  @keyframes about-final-cta-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes about-final-cta-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
