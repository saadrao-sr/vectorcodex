---
interface Props {
  weakLabel: string;
  strongLabel: string;
  weakPoints: string[];
  strongPoints: string[];
  note: string;
}

const { weakLabel, strongLabel, weakPoints, strongPoints, note } = Astro.props;
---

<div class="local-compare" aria-label="Illustrative comparison of local presence quality">
  <div class="local-compare__col local-compare__col--weak">
    <p class="local-compare__label">{weakLabel}</p>
    <div class="local-compare__screen">
      <span class="local-compare__pin local-compare__pin--dim"></span>
      <span class="local-compare__bar" style="width: 38%"></span>
      <span class="local-compare__bar local-compare__bar--short" style="width: 24%"></span>
    </div>
    <ul class="local-compare__list">
      {weakPoints.map((point) => <li>{point}</li>)}
    </ul>
  </div>

  <div class="local-compare__col local-compare__col--strong">
    <p class="local-compare__label local-compare__label--accent">{strongLabel}</p>
    <div class="local-compare__screen local-compare__screen--strong">
      <span class="local-compare__pin"></span>
      <span class="local-compare__bar local-compare__bar--accent" style="width: 78%"></span>
      <span class="local-compare__bar local-compare__bar--accent" style="width: 62%"></span>
    </div>
    <ul class="local-compare__list">
      {strongPoints.map((point) => <li>{point}</li>)}
    </ul>
  </div>

  <p class="local-compare__note">{note}</p>
</div>

<style>
  .local-compare {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .local-compare {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .local-compare__note {
      grid-column: 1 / -1;
    }
  }

  .local-compare__col {
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.15rem;
    background: rgb(255 255 255 / 0.03);
    padding: 1rem;
    transition:
      border-color 0.22s ease,
      background-color 0.22s ease,
      transform 0.22s ease,
      box-shadow 0.22s ease;
  }

  .local-compare__col:hover {
    border-color: rgb(222 243 77 / 0.4);
    box-shadow: 0 14px 36px rgb(0 0 0 / 0.26);
    transform: translateY(-2px);
  }

  .local-compare__col--strong {
    border-color: rgb(222 243 77 / 0.28);
    background:
      linear-gradient(165deg, rgb(222 243 77 / 0.08), transparent 50%),
      rgb(255 255 255 / 0.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .local-compare__col,
    .local-compare__col:hover {
      transition: border-color 0.2s ease, background-color 0.2s ease;
      transform: none;
    }
  }

  .local-compare__label {
    margin: 0 0 0.75rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.45);
  }

  .local-compare__label--accent {
    color: #def34d;
  }

  .local-compare__screen {
    position: relative;
    min-height: 5.5rem;
    margin-bottom: 0.85rem;
    border-radius: 0.75rem;
    border: 1px dashed rgb(255 255 255 / 0.12);
    background: rgb(0 0 0 / 0.25);
    padding: 0.85rem;
  }

  .local-compare__screen--strong {
    border-style: solid;
    border-color: rgb(222 243 77 / 0.22);
  }

  .local-compare__pin {
    display: block;
    width: 0.65rem;
    height: 0.65rem;
    margin-bottom: 0.65rem;
    border-radius: 9999px 9999px 9999px 0.1rem;
    background: #def34d;
    transform: rotate(-45deg);
  }

  .local-compare__pin--dim {
    background: rgb(255 255 255 / 0.25);
  }

  .local-compare__bar {
    display: block;
    height: 0.35rem;
    margin-top: 0.4rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.12);
  }

  .local-compare__bar--accent {
    background: linear-gradient(90deg, #def34d, rgb(197 246 61 / 0.4));
  }

  .local-compare__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .local-compare__list li {
    position: relative;
    padding-left: 0.85rem;
    font-size: 0.8rem;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.62);
  }

  .local-compare__list li + li {
    margin-top: 0.35rem;
  }

  .local-compare__list li::before {
    content: '';
    position: absolute;
    top: 0.55rem;
    left: 0;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.25);
  }

  .local-compare__col--strong .local-compare__list li::before {
    background: #def34d;
  }

  .local-compare__note {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.4);
  }
</style>
