---
import type { ChildServiceLanding } from '../../../config/service-children';
import AmbientBackdrop from '../../ui/AmbientBackdrop.astro';
import Container from '../../ui/Container.astro';
import { eyebrowClass } from '../../ui/styles';

interface Props {
  service: ChildServiceLanding;
}

const { service } = Astro.props;
const { includes } = service;
---

<section
  class="relative isolate border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby={`${service.slug}-includes-heading`}
>
  <AmbientBackdrop variant="mesh" class="opacity-40" />
  <Container class="relative">
    <header class="max-w-2xl">
      <p class:list={[eyebrowClass, 'w-fit max-w-full']}>{includes.eyebrow}</p>
      <h2
        id={`${service.slug}-includes-heading`}
        class="mt-3 font-display text-[1.65rem] font-semibold tracking-tight text-balance sm:text-[2.1rem]"
      >
        {includes.titleBefore}
        <span class="text-highlight"> {includes.titleHighlight}</span>
      </h2>
      <p class="mt-3 max-w-xl text-sm leading-7 text-white/65 sm:text-base sm:leading-8">{includes.intro}</p>
    </header>

    <div class="child-includes mt-8 sm:mt-10" role="list">
      {
        includes.items.map((item) => (
          <article class="child-includes__slot" role="listitem">
            <div class="child-includes__rail" aria-hidden="true">
              <span class="child-includes__num font-display">{item.number}</span>
            </div>
            <div class="min-w-0">
              <h3 class="font-display text-base font-semibold tracking-tight text-white sm:text-lg">{item.title}</h3>
              <p class="mt-1.5 text-sm leading-6 text-white/60">{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .child-includes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.65rem;
  }

  @media (min-width: 768px) {
    .child-includes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }

  @media (min-width: 1100px) {
    .child-includes {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .child-includes__slot:nth-child(1),
    .child-includes__slot:nth-child(2),
    .child-includes__slot:nth-child(3) {
      grid-column: span 4;
    }

    .child-includes__slot:nth-child(4),
    .child-includes__slot:nth-child(5) {
      grid-column: span 6;
    }

    .child-includes__slot:nth-child(6),
    .child-includes__slot:nth-child(7) {
      grid-column: span 6;
    }
  }

  .child-includes__slot {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem;
    height: 100%;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.1rem;
    background: rgb(255 255 255 / 0.03);
    padding: 1rem 1rem 1.05rem;
    transition:
      border-color 0.22s ease,
      background-color 0.22s ease,
      transform 0.22s ease,
      box-shadow 0.22s ease;
  }

  .child-includes__slot:hover {
    border-color: rgb(222 243 77 / 0.45);
    background: rgb(255 255 255 / 0.05);
    box-shadow: 0 14px 36px rgb(0 0 0 / 0.26);
    transform: translateY(-2px);
  }

  .child-includes__slot:hover .child-includes__rail {
    border-color: rgb(222 243 77 / 0.5);
    background: rgb(222 243 77 / 0.14);
  }

  @media (prefers-reduced-motion: reduce) {
    .child-includes__slot,
    .child-includes__slot:hover {
      transition: border-color 0.2s ease, background-color 0.2s ease;
      transform: none;
    }
  }

  .child-includes__rail {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.85rem;
    border: 1px solid rgb(222 243 77 / 0.3);
    background: rgb(222 243 77 / 0.08);
  }

  .child-includes__num {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #def34d;
  }
</style>
