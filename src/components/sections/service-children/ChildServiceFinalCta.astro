---
import { ArrowUpRight } from 'lucide-react';
import type { ChildServiceLanding } from '../../../config/service-children';
import Container from '../../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../../ui/styles';

interface Props {
  service: ChildServiceLanding;
}

const { service } = Astro.props;
const { finalCta, enquiryValue } = service;
---

<section
  id={`${service.slug}-final-cta`}
  class="relative isolate overflow-hidden border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby={`${service.slug}-final-cta-heading`}
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute top-1/2 left-1/2 h-[20rem] w-[20rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgb(222_243_77_/0.15),transparent_68%)] blur-2xl sm:h-[24rem] sm:w-[24rem]"
    >
    </div>
  </div>

  <Container class="relative">
    <div
      class="relative mx-auto w-full max-w-5xl overflow-hidden rounded-[1.5rem] border border-white/12 bg-white/[0.03] px-5 py-7 text-center sm:rounded-[1.75rem] sm:px-10 sm:py-8 lg:px-14 lg:py-9"
    >
      <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{finalCta.eyebrow}</p>
      <h2
        id={`${service.slug}-final-cta-heading`}
        class="mt-3 font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.25rem] lg:text-[2.45rem]"
      >
        {finalCta.titleBefore}
        <span class="text-highlight"> {finalCta.titleHighlight}</span>
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-8">
        {finalCta.text}
      </p>
      <div class="mt-5 flex justify-center sm:mt-6">
        <button
          type="button"
          class:list={[
            buttonClass.base,
            buttonClass.gradient,
            'group w-full px-7 shadow-[0_16px_48px_rgb(197_246_61_/0.2)] sm:w-auto',
          ]}
          data-quote-open
          data-service={enquiryValue}
        >
          {finalCta.primaryLabel}
          <ArrowUpRight size={16} aria-hidden="true" />
        </button>
      </div>
    </div>
  </Container>
</section>
