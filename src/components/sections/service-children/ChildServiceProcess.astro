---
import type { ChildServiceLanding } from '../../../config/service-children';
import Container from '../../ui/Container.astro';
import { eyebrowClass } from '../../ui/styles';

interface Props {
  service: ChildServiceLanding;
}

const { service } = Astro.props;
const { process } = service;
---

<section
  class="relative isolate border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby={`${service.slug}-process-heading`}
>
  <Container>
    <header class="mx-auto max-w-2xl text-center">
      <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{process.eyebrow}</p>
      <h2
        id={`${service.slug}-process-heading`}
        class="mt-3 font-display text-[1.65rem] font-semibold tracking-tight text-balance sm:text-[2.1rem]"
      >
        {process.titleBefore}
        <span class="text-highlight"> {process.titleHighlight}</span>
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-white/65 sm:text-base sm:leading-8">{process.intro}</p>
    </header>

    <ol class="child-process mt-8 list-none p-0 sm:mt-10">
      {
        process.stages.map((stage, index) => (
          <li class="child-process__stage">
            {index > 0 ? <span class="child-process__join" aria-hidden="true" /> : null}
            <div class="child-process__card">
              <span class="child-process__num font-display">{stage.number}</span>
              <h3 class="mt-2 font-display text-[0.92rem] font-semibold tracking-tight text-white">{stage.title}</h3>
              <p class="mt-1.5 text-[0.78rem] leading-5 text-white/58 sm:text-sm sm:leading-6">{stage.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Container>
</section>

<style>
  .child-process {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.65rem;
  }

  @media (min-width: 768px) {
    .child-process {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0;
      align-items: stretch;
    }
  }

  .child-process__stage {
    position: relative;
    min-width: 0;
    height: 100%;
  }

  .child-process__card {
    height: 100%;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.03);
    padding: 0.95rem 0.85rem 1rem;
    transition:
      border-color 0.22s ease,
      background-color 0.22s ease,
      transform 0.22s ease,
      box-shadow 0.22s ease;
  }

  .child-process__card:hover {
    border-color: rgb(222 243 77 / 0.45);
    background: rgb(255 255 255 / 0.05);
    box-shadow: 0 14px 36px rgb(0 0 0 / 0.28);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .child-process__card,
    .child-process__card:hover {
      transition: border-color 0.2s ease, background-color 0.2s ease;
      transform: none;
    }
  }

  .child-process__num {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #def34d;
  }

  @media (min-width: 768px) {
    .child-process__join {
      position: absolute;
      top: 1.35rem;
      left: -0.35rem;
      width: 0.7rem;
      height: 1px;
      background: rgb(222 243 77 / 0.45);
      z-index: 1;
    }

    .child-process__stage + .child-process__stage .child-process__card {
      border-left-color: transparent;
      border-radius: 0;
    }

    .child-process__stage:first-child .child-process__card {
      border-radius: 1rem 0 0 1rem;
    }

    .child-process__stage:last-child .child-process__card {
      border-radius: 0 1rem 1rem 0;
      border-color: rgb(222 243 77 / 0.28);
      background:
        linear-gradient(165deg, rgb(222 243 77 / 0.08), transparent 50%),
        rgb(255 255 255 / 0.03);
    }
  }
</style>
