---
import type { ChildServiceLanding } from '../../../config/service-children';
import AmbientBackdrop from '../../ui/AmbientBackdrop.astro';
import Container from '../../ui/Container.astro';
import { eyebrowClass } from '../../ui/styles';

interface Props {
  service: ChildServiceLanding;
}

const { service } = Astro.props;
const { audience } = service;
---

<section
  class="relative isolate border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby={`${service.slug}-audience-heading`}
>
  <AmbientBackdrop variant="orbs" class="opacity-40" />
  <Container class="relative">
    <header class="mx-auto max-w-2xl text-center">
      <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{audience.eyebrow}</p>
      <h2
        id={`${service.slug}-audience-heading`}
        class="mt-3 font-display text-[1.65rem] font-semibold tracking-tight text-balance sm:text-[2.1rem]"
      >
        {audience.titleBefore}
        <span class="text-highlight"> {audience.titleHighlight}</span>
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-white/65 sm:text-base sm:leading-8">{audience.intro}</p>
    </header>

    <ul class="child-audience mt-8 list-none p-0 sm:mt-10">
      {
        audience.profiles.map((profile) => (
          <li class="child-audience__profile">
            <p class="child-audience__focus">{profile.focus}</p>
            <h3 class="mt-2 font-display text-lg font-semibold tracking-tight text-white">{profile.title}</h3>
            <p class="mt-2 text-sm leading-6 text-white/62">{profile.text}</p>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .child-audience {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem;
  }

  @media (min-width: 768px) {
    .child-audience {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  .child-audience__profile {
    height: 100%;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.2rem;
    background: rgb(255 255 255 / 0.03);
    padding: 1.15rem 1.1rem 1.2rem;
    transition:
      border-color 0.22s ease,
      background-color 0.22s ease,
      transform 0.22s ease,
      box-shadow 0.22s ease;
  }

  .child-audience__profile:nth-child(2) {
    border-color: rgb(222 243 77 / 0.28);
    background:
      linear-gradient(165deg, rgb(222 243 77 / 0.08), transparent 48%),
      rgb(255 255 255 / 0.03);
  }

  .child-audience__profile:hover {
    border-color: rgb(222 243 77 / 0.45);
    background: rgb(255 255 255 / 0.05);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.28);
    transform: translateY(-3px);
  }

  .child-audience__profile:nth-child(2):hover {
    background:
      linear-gradient(165deg, rgb(222 243 77 / 0.12), transparent 48%),
      rgb(255 255 255 / 0.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .child-audience__profile,
    .child-audience__profile:hover {
      transition: border-color 0.2s ease, background-color 0.2s ease;
      transform: none;
    }
  }

  .child-audience__focus {
    margin: 0;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #def34d;
  }
</style>
