---
import HeroBackgroundVideo from '../interactive/HeroBackgroundVideo';
import Button from '../ui/Button.astro';
import { eyebrowClass } from '../ui/styles';

type CredibilityItem = {
  src: string;
  alt: string;
  width: number;
  height: number;
  label?: string;
  text?: string;
  imageClass?: string;
};

const credibility: CredibilityItem[] = [
  {
    src: '/images/five%20star%20rating.webp',
    alt: 'Five-star rating',
    width: 320,
    height: 80,
    label: '5-Star',
    text: 'Rated Agency',
    imageClass: 'h-8 w-auto max-w-[5.5rem] sm:h-10 sm:max-w-[9rem]',
  },
  {
    src: '/images/trust%20pilot.webp',
    alt: 'Trustpilot',
    width: 320,
    height: 120,
    label: 'Trustpilot',
    text: 'Client Trust & Reputation',
    imageClass: 'h-8 w-auto max-w-[5.5rem] sm:h-10 sm:max-w-[9rem]',
  },
  {
    src: '/images/google%20review.webp',
    alt: 'Google Business Profile',
    width: 320,
    height: 160,
    label: 'GMB',
    text: 'Local Search Visibility',
    imageClass: 'h-8 w-auto max-w-[5.5rem] sm:h-10 sm:max-w-[9rem]',
  },
  {
    src: '/images/google-partner.webp',
    alt: 'Google Partner',
    width: 320,
    height: 120,
    label: 'Google Partner',
    text: 'Google Affiliated Partner',
    imageClass: 'h-9 w-auto max-w-[5rem] sm:h-10 sm:max-w-[6.5rem]',
  },
  {
    src: '/images/clutch.webp',
    alt: 'Clutch',
    width: 320,
    height: 120,
    label: 'Clutch',
    text: 'Top Rated',
    imageClass: 'h-8 w-auto max-w-[5.5rem] sm:h-10 sm:max-w-[8rem]',
  },
];

const assetVersion = '20261104v20';
const posterSrc = `/images/hero-poster.jpg?v=${assetVersion}`;
const webmSrc = `/videos/hero-bg.webm?v=${assetVersion}`;
const mp4Src = `/videos/hero-bg.mp4?v=${assetVersion}`;
---

<section class="relative isolate flex min-h-[100svh] items-center overflow-hidden pt-24 pb-16 sm:pt-28 sm:pb-20">
  <div class="absolute inset-0 -z-20 overflow-hidden" aria-hidden="true">
    <img
      src={posterSrc}
      alt=""
      width={1600}
      height={900}
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover object-center"
    />
    <HeroBackgroundVideo
      client:idle
      webmSrc={webmSrc}
      mp4Src={mp4Src}
      posterSrc={posterSrc}
    />
  </div>
  <div class="absolute inset-0 -z-10 bg-[#0D120C]/72" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,rgb(197_246_61_/0.10),transparent_55%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto flex w-full min-w-0 max-w-5xl flex-col items-center px-4 text-center sm:px-6 lg:px-8">
    <p class={eyebrowClass}>Your SEO & Digital Growth Partner</p>

    <h1 class="mt-6 max-w-4xl font-display text-[2.05rem] leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl md:text-6xl lg:text-[4.25rem]">
      <span class="block text-white">Turn Your Digital Presence Into</span>
      <span class="mt-1 block text-highlight sm:mt-2">Measurable Business Growth.</span>
    </h1>

    <p class="mt-6 max-w-2xl text-base leading-7 text-white/75 sm:text-lg sm:leading-8">
      We combine advanced SEO, web development, and digital marketing to help businesses improve visibility, attract qualified traffic, and accelerate sustainable growth.
    </p>

    <div class="mt-8 flex w-full max-w-md flex-col gap-3 sm:mt-10 sm:max-w-none sm:flex-row sm:justify-center">
      <Button href="/contact/" class="w-full shadow-[0_12px_40px_rgb(197_246_61_/0.18)] sm:w-auto">
        Book a Free Consultation
      </Button>
      <Button href="/case-studies/" variant="ghost" class="w-full sm:w-auto">Explore Our Work</Button>
    </div>

    <ul
      class="mt-10 flex w-full min-w-0 max-w-5xl snap-x snap-mandatory flex-nowrap gap-px overflow-x-auto overscroll-x-contain rounded-2xl border border-white/12 bg-white/10 shadow-[0_20px_60px_rgb(0_0_0_/0.35)] [-ms-overflow-style:none] [scrollbar-width:none] sm:mt-12 lg:grid lg:grid-cols-5 lg:overflow-visible [&::-webkit-scrollbar]:hidden"
      aria-label="Credibility"
    >
      {
        credibility.map((item) => (
          <li class="flex w-[min(72vw,15.5rem)] min-w-[13.5rem] shrink-0 snap-center flex-col items-center gap-2.5 bg-[#0D120C]/80 px-4 py-5 text-center backdrop-blur-md lg:w-auto lg:min-w-0 lg:px-3 lg:py-6">
            <div class="flex h-12 w-full shrink-0 items-center justify-center">
              <img
                src={item.src}
                alt={item.alt}
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
                class:list={[
                  'mx-auto max-h-full w-auto object-contain object-center',
                  item.imageClass ?? 'h-9 max-w-[8rem] sm:h-10 sm:max-w-[9rem]',
                ]}
              />
            </div>
            <div class="min-h-[2.75rem] w-full min-w-0">
              {item.label && (
                <p class="text-sm font-semibold tracking-tight whitespace-nowrap text-white">{item.label}</p>
              )}
              {item.text && (
                <p class="mt-1 text-xs leading-5 text-white/60 sm:text-[0.8125rem]">{item.text}</p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
