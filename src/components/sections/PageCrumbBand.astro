---
import type { Crumb } from '../../types/content';
import Container from '../ui/Container.astro';

interface Props {
  title: string;
  crumbs: Crumb[];
  /** Optional image behind the band */
  imageSrc?: string;
}

const { title, crumbs, imageSrc = '/images/hero-tech.jpg' } = Astro.props;
---

<section
  class="page-crumb-band relative isolate overflow-hidden bg-[#0D120C] pt-[calc(var(--header-height)+1.25rem)] pb-6 sm:pt-[calc(var(--header-height)+1.5rem)] sm:pb-8"
  aria-label="Page introduction"
>
  <Container class="relative">
    <nav class="page-crumb-band__panel" aria-label="Breadcrumb">
      <div class="page-crumb-band__bg" aria-hidden="true">
        <img
          src={imageSrc}
          alt=""
          width={1200}
          height={400}
          loading="eager"
          decoding="async"
          class="page-crumb-band__image"
        />
        <div class="page-crumb-band__veil"></div>
        <div class="page-crumb-band__glow"></div>
      </div>

      <div class="page-crumb-band__content">
        <div class="page-crumb-band__rule" aria-hidden="true">
          <span class="page-crumb-band__line"></span>
          <span class="page-crumb-band__mark"></span>
          <span class="page-crumb-band__line"></span>
        </div>

        <p class="page-crumb-band__title">{title}</p>

        <ol class="page-crumb-band__trail">
          {
            crumbs.map((item, index) => {
              const last = index === crumbs.length - 1;
              return (
                <li class="inline-flex items-center gap-2">
                  {index > 0 && <span aria-hidden="true" class="text-white/30">/</span>}
                  {last ? (
                    <span aria-current="page" class="text-highlight">
                      {item.name}
                    </span>
                  ) : (
                    <a href={item.href} class="transition hover:text-highlight">
                      {item.name}
                    </a>
                  )}
                </li>
              );
            })
          }
        </ol>
      </div>
    </nav>
  </Container>
</section>

<style>
  .page-crumb-band__panel {
    position: relative;
    display: flex;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    min-height: 7.5rem;
    border-radius: 1.5rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: 0 18px 48px rgb(0 0 0 / 0.28);
  }

  .page-crumb-band__bg {
    position: absolute;
    inset: 0;
  }

  .page-crumb-band__image {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center 35%;
    transform: scale(1.08);
    filter: saturate(0.85) brightness(0.72);
  }

  .page-crumb-band__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(13 18 12 / 0.82), rgb(13 18 12 / 0.55) 48%, rgb(13 18 12 / 0.8)),
      linear-gradient(180deg, rgb(13 18 12 / 0.35), rgb(13 18 12 / 0.78));
  }

  .page-crumb-band__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 70% 40%, rgb(222 243 77 / 0.18), transparent 48%),
      radial-gradient(ellipse at 20% 70%, rgb(197 246 61 / 0.1), transparent 42%);
  }

  .page-crumb-band__content {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    padding: 1.35rem 1.25rem;
    text-align: center;
  }

  .page-crumb-band__rule {
    display: flex;
    width: min(100%, 18rem);
    align-items: center;
    gap: 0.65rem;
  }

  .page-crumb-band__line {
    height: 1px;
    flex: 1 1 auto;
    background-image: linear-gradient(
      90deg,
      transparent,
      rgb(222 243 77 / 0.15) 12%,
      rgb(222 243 77 / 0.55) 50%,
      rgb(222 243 77 / 0.15) 88%,
      transparent
    );
    background-size: 10px 1px;
    background-repeat: repeat-x;
    opacity: 0.9;
  }

  .page-crumb-band__mark {
    position: relative;
    width: 0.7rem;
    height: 0.7rem;
    flex: 0 0 auto;
  }

  .page-crumb-band__mark::before,
  .page-crumb-band__mark::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    background: rgb(222 243 77 / 0.85);
    transform: translate(-50%, -50%);
  }

  .page-crumb-band__mark::before {
    width: 100%;
    height: 1px;
  }

  .page-crumb-band__mark::after {
    width: 1px;
    height: 100%;
  }

  .page-crumb-band__title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    background: linear-gradient(180deg, #ffffff 20%, rgb(255 255 255 / 0.72) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .page-crumb-band__trail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.5rem;
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.55);
  }

  @media (min-width: 640px) {
    .page-crumb-band__panel {
      min-height: 8.5rem;
      border-radius: 1.75rem;
    }

    .page-crumb-band__content {
      padding: 1.6rem 1.5rem;
    }
  }
</style>
