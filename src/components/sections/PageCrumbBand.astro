---
import type { Crumb } from '../../types/content';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Container from '../ui/Container.astro';

interface Props {
  /** Kept for call-site compatibility; decorative page titles were removed. */
  title?: string;
  crumbs: Crumb[];
  imageSrc?: string;
}

const { crumbs } = Astro.props;
---

{
  crumbs.length > 0 && (
    <div class="page-crumbs relative isolate bg-[#0D120C] pt-[calc(var(--header-height)+1.25rem)] pb-2 sm:pt-[calc(var(--header-height)+1.5rem)] sm:pb-3">
      <Container>
        <Breadcrumbs items={crumbs} class="mb-0" />
      </Container>
    </div>
  )
}
