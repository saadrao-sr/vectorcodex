---
import { servicesExpertiseIntro, servicesExpertiseItems } from '../../config/services-page';
import AmbientBackdrop from '../ui/AmbientBackdrop.astro';
import Container from '../ui/Container.astro';
import { eyebrowClass } from '../ui/styles';

const intro = servicesExpertiseIntro;
---

<section
  id="services-expertise"
  class="services-expertise relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="services-expertise-heading"
>
  <AmbientBackdrop variant="drift" />

  <Container class="relative">
    <header class="mx-auto max-w-3xl text-center">
      <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{intro.eyebrow}</p>
      <h2
        id="services-expertise-heading"
        class="mt-3 font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.25rem] lg:text-[2.55rem] lg:leading-[1.06]"
      >
        {intro.titleBefore}
        <span class="text-highlight"> {intro.titleHighlight}</span>
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-8">
        {intro.text}
      </p>
    </header>

    <div class="services-expertise__stage">
      <div class="services-expertise__hub" aria-hidden="true">
        <span class="services-expertise__ring services-expertise__ring--outer"></span>
        <span class="services-expertise__ring services-expertise__ring--inner"></span>
        <div class="services-expertise__core">
          <p class="services-expertise__core-label">VectorCodex</p>
          <p class="services-expertise__core-sub">Connected delivery</p>
        </div>
      </div>

      <ul class="services-expertise__nodes">
        {
          servicesExpertiseItems.map((item, index) => (
            <li
              class={`services-expertise__node services-expertise__node--${index + 1}`}
              style={`--node-i: ${index}`}
            >
              <article class="services-expertise__card">
                <p class="services-expertise__index font-display">{String(index + 1).padStart(2, '0')}</p>
                <h3 class="mt-2 font-display text-lg font-semibold tracking-tight text-white">{item.title}</h3>
                <p class="mt-2 text-sm leading-6 text-white/60">{item.text}</p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</section>

<style>
  .services-expertise__stage {
    position: relative;
    display: grid;
    gap: 0.9rem;
    margin-top: 3rem;
  }

  @media (min-width: 640px) {
    .services-expertise__stage {
      margin-top: 3.5rem;
    }
  }

  .services-expertise__hub {
    display: none;
  }

  .services-expertise__nodes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .services-expertise__nodes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .services-expertise__stage {
      min-height: 28rem;
      display: grid;
      place-items: center;
    }

    .services-expertise__hub {
      position: absolute;
      inset: 18% 28%;
      display: grid;
      place-items: center;
      pointer-events: none;
    }

    .services-expertise__ring {
      position: absolute;
      left: 50%;
      top: 50%;
      border: 1px solid rgb(222 243 77 / 0.2);
      border-radius: 9999px;
      transform: translate(-50%, -50%);
    }

    .services-expertise__ring--outer {
      width: min(100%, 22rem);
      aspect-ratio: 1;
    }

    .services-expertise__ring--inner {
      width: min(68%, 14rem);
      aspect-ratio: 1;
      border-style: dashed;
      border-color: rgb(222 243 77 / 0.3);
    }

    .services-expertise__core {
      position: relative;
      z-index: 1;
      width: 10.5rem;
      border: 1px solid rgb(222 243 77 / 0.35);
      border-radius: 9999px;
      background: rgb(13 18 12 / 0.92);
      padding: 1.35rem 1rem;
      text-align: center;
      aspect-ratio: 1;
      display: grid;
      place-content: center;
    }

    .services-expertise__core-label {
      font-family: var(--font-display, inherit);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #def34d;
    }

    .services-expertise__core-sub {
      margin-top: 0.3rem;
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgb(255 255 255 / 0.5);
    }

    .services-expertise__nodes {
      display: contents;
    }

    .services-expertise__node--1 {
      position: absolute;
      top: 0;
      left: 0;
      width: min(18rem, 34%);
    }

    .services-expertise__node--2 {
      position: absolute;
      top: 0;
      right: 0;
      width: min(18rem, 34%);
    }

    .services-expertise__node--3 {
      position: absolute;
      bottom: 0;
      left: 0;
      width: min(18rem, 34%);
    }

    .services-expertise__node--4 {
      position: absolute;
      bottom: 0;
      right: 0;
      width: min(18rem, 34%);
    }
  }

  .services-expertise__card {
    height: 100%;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.35rem;
    background: rgb(255 255 255 / 0.03);
    padding: 1.15rem 1.15rem 1.2rem;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease;
  }

  .services-expertise__card:hover {
    border-color: rgb(222 243 77 / 0.4);
    background: rgb(255 255 255 / 0.05);
  }

  .services-expertise__index {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #def34d;
  }

  @media (prefers-reduced-motion: no-preference) {
    .services-expertise__node {
      opacity: 0;
      transform: translateY(14px);
      animation: services-expertise-rise 0.65s ease forwards;
      animation-delay: calc(120ms + var(--node-i, 0) * 70ms);
    }

    .services-expertise__ring--inner {
      animation: services-expertise-spin 32s linear infinite;
    }
  }

  @keyframes services-expertise-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes services-expertise-spin {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }
</style>
