---
import { ArrowDown, ArrowUpRight } from 'lucide-react';
import { servicesPageHero } from '../../config/services-page';
import AmbientBackdrop from '../ui/AmbientBackdrop.astro';
import Container from '../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../ui/styles';

const hero = servicesPageHero;
---

<section
  id="services-hero"
  class="services-hero relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="services-hero-heading"
>
  <AmbientBackdrop variant="mesh" />

  <Container class="relative">
    <div class="services-hero__layout">
      <div class="services-hero__copy min-w-0">
        <p class:list={[eyebrowClass, 'w-fit max-w-full']}>{hero.eyebrow}</p>
        <h1
          id="services-hero-heading"
          class="mt-3 max-w-2xl font-display text-[1.85rem] leading-[1.1] font-semibold tracking-tight text-balance text-white sm:text-[2.35rem] sm:leading-[1.06] lg:text-[2.85rem] lg:leading-[1.04]"
        >
          {hero.titleBefore}
          <span class="text-highlight"> {hero.titleHighlight}</span>
        </h1>
        <p class="mt-4 max-w-xl text-sm leading-7 text-white/65 sm:mt-5 sm:text-base sm:leading-8">
          {hero.intro}
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:mt-7 sm:flex-row sm:flex-wrap">
          <a
            href={hero.primaryCta.href}
            class:list={[
              buttonClass.base,
              buttonClass.gradient,
              'w-full shadow-[0_14px_40px_rgb(197_246_61_/0.18)] sm:w-auto',
            ]}
          >
            {hero.primaryCta.label}
            <ArrowDown size={16} aria-hidden="true" />
          </a>
          <button
            type="button"
            class:list={[buttonClass.base, buttonClass.ghost, 'w-full sm:w-auto']}
            data-quote-open
          >
            {hero.secondaryCta.label}
            <ArrowUpRight size={16} aria-hidden="true" />
          </button>
        </div>
      </div>

      <div class="services-hero__panel" aria-hidden="true">
        <div class="services-hero__orb"></div>
        <p class="services-hero__kicker">Growth system</p>
        <ul class="services-hero__stack">
          <li>SEO</li>
          <li>Web Development</li>
          <li>Social Media</li>
          <li>PPC</li>
        </ul>
        <p class="services-hero__note">Strategy · Build · Demand</p>
      </div>
    </div>
  </Container>
</section>

<style>
  .services-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .services-hero__layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 2rem;
    }
  }

  .services-hero__panel {
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.6rem;
    background:
      radial-gradient(circle at 70% 20%, rgb(222 243 77 / 0.14), transparent 50%),
      linear-gradient(165deg, rgb(18 24 17 / 0.96), rgb(13 18 12 / 0.92));
    padding: 1.5rem 1.35rem;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.28);
  }

  @media (min-width: 640px) {
    .services-hero__panel {
      padding: 1.85rem 1.75rem;
    }
  }

  .services-hero__orb {
    position: absolute;
    top: -2rem;
    right: -1.5rem;
    width: 9rem;
    height: 9rem;
    border-radius: 9999px;
    border: 1px dashed rgb(222 243 77 / 0.35);
    opacity: 0.7;
  }

  .services-hero__kicker {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #def34d;
  }

  .services-hero__stack {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .services-hero__stack li {
    font-family: var(--font-display, inherit);
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: #fff;
  }

  .services-hero__stack li:nth-child(even) {
    color: #def34d;
  }

  .services-hero__note {
    margin-top: 1.15rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.45);
  }

  @media (prefers-reduced-motion: no-preference) {
    .services-hero__copy,
    .services-hero__panel {
      opacity: 0;
      transform: translateY(14px);
      animation: services-hero-rise 0.7s ease forwards;
    }

    .services-hero__copy {
      animation-delay: 60ms;
    }

    .services-hero__panel {
      animation-delay: 140ms;
    }

    .services-hero__orb {
      animation: services-hero-spin 28s linear infinite;
    }
  }

  @keyframes services-hero-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes services-hero-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
