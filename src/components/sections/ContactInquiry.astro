---
import { Mail, MessageCircle } from 'lucide-react';
import { site } from '../../config/site';
import ProjectInquiryForm from '../interactive/ProjectInquiryForm';
import Container from '../ui/Container.astro';
import { eyebrowClass } from '../ui/styles';

const whatsappHref = site.whatsapp ? `https://wa.me/${site.whatsapp}` : '';
const whatsappDisplay = site.whatsapp
  ? `+${site.whatsapp.slice(0, 2)} ${site.whatsapp.slice(2, 5)} ${site.whatsapp.slice(5)}`
  : '';

const dubaiMapEmbed =
  'https://www.google.com/maps?q=Dubai%2C%20United%20Arab%20Emirates&z=11&hl=en&output=embed';
---

<section
  id="contact-form"
  class="contact-inquiry relative isolate scroll-mt-28 overflow-x-clip border-t border-white/10 bg-[#0D120C] py-12 sm:py-14 lg:py-16"
  aria-labelledby="contact-inquiry-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute top-24 left-[12%] h-56 w-56 rounded-full bg-[radial-gradient(circle,rgb(222_243_77_/0.08),transparent_70%)] blur-3xl"
    >
    </div>
    <div
      class="absolute right-[8%] bottom-16 h-64 w-64 rounded-full bg-[radial-gradient(circle,rgb(197_246_61_/0.05),transparent_70%)] blur-3xl"
    >
    </div>
  </div>

  <Container class="relative">
    <header class="mx-auto max-w-3xl text-center">
      <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>Get in Touch</p>
      <h2
        id="contact-inquiry-heading"
        class="mt-4 font-display text-[1.75rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-4xl lg:text-[2.65rem] lg:leading-[1.08]"
      >
        Tell Us About
        <span class="text-highlight"> Your Project.</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-white/65 sm:text-base sm:leading-8">
        Share a little about your business, goals, and what you're looking to achieve. Our team will review your enquiry
        and help you find the right digital solution.
      </p>
    </header>

    <div class="mt-10 grid gap-6 lg:mt-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-8 xl:gap-10">
      <div class="contact-inquiry__form relative min-w-0">
        <div
          class="pointer-events-none absolute -inset-6 -z-10 rounded-[2rem] bg-[radial-gradient(circle_at_30%_20%,rgb(222_243_77_/0.12),transparent_55%)] blur-2xl"
          aria-hidden="true"
        >
        </div>
        <ProjectInquiryForm client:visible endpoint={import.meta.env.PUBLIC_CONTACT_ENDPOINT} />
      </div>

      <aside class="contact-inquiry__aside min-w-0">
        <div
          class="relative flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-white/12 bg-white/[0.03] p-5 sm:p-7"
        >
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-br from-highlight/10 via-transparent to-transparent"
            aria-hidden="true"
          >
          </div>

          <div class="relative flex min-h-0 flex-1 flex-col">
            <h3 class="font-display text-xl font-semibold tracking-tight text-white sm:text-2xl">
              Contact information
            </h3>
            <p class="mt-2 text-sm leading-6 text-white/60">
              Reach out directly and we'll help you shape the right next step.
            </p>

            <ul class="mt-7 space-y-4">
              {
                site.telephone && (
                  <li>
                    <a
                      href={`tel:${site.telephone.replace(/\s+/g, '')}`}
                      class="group flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.02] p-4 transition hover:border-highlight/35"
                    >
                      <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-highlight/25 bg-highlight/10 text-highlight">
                        <MessageCircle size={18} aria-hidden="true" />
                      </span>
                      <span class="min-w-0">
                        <span class="block text-[0.65rem] font-semibold tracking-[0.14em] text-highlight uppercase">
                          Phone
                        </span>
                        <span class="mt-1 block text-sm font-semibold text-white transition group-hover:text-highlight">
                          {site.telephone}
                        </span>
                      </span>
                    </a>
                  </li>
                )
              }

              {
                whatsappHref && (
                  <li>
                    <a
                      href={whatsappHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.02] p-4 transition hover:border-highlight/35"
                    >
                      <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-highlight/25 bg-highlight/10 text-highlight">
                        <MessageCircle size={18} aria-hidden="true" />
                      </span>
                      <span class="min-w-0">
                        <span class="block text-[0.65rem] font-semibold tracking-[0.14em] text-highlight uppercase">
                          WhatsApp
                        </span>
                        <span class="mt-1 block text-sm font-semibold text-white transition group-hover:text-highlight">
                          {whatsappDisplay}
                        </span>
                      </span>
                    </a>
                  </li>
                )
              }

              {
                site.email && (
                  <li>
                    <a
                      href={`mailto:${site.email}`}
                      class="group flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.02] p-4 transition hover:border-highlight/35"
                    >
                      <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-highlight/25 bg-highlight/10 text-highlight">
                        <Mail size={18} aria-hidden="true" />
                      </span>
                      <span class="min-w-0">
                        <span class="block text-[0.65rem] font-semibold tracking-[0.14em] text-highlight uppercase">
                          Email
                        </span>
                        <span class="mt-1 block text-sm font-semibold text-white transition group-hover:text-highlight">
                          {site.email}
                        </span>
                      </span>
                    </a>
                  </li>
                )
              }
            </ul>

            <div class="mt-4 min-h-[14rem] flex-1 overflow-hidden rounded-2xl border border-white/10 bg-[#0D120C]/60 lg:min-h-[16rem]">
              <iframe
                title="Map showing Dubai, United Arab Emirates"
                src={dubaiMapEmbed}
                class="h-56 w-full border-0 lg:h-full lg:min-h-[16rem]"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </Container>
</section>
