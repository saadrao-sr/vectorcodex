---
import Container from '../ui/Container.astro';

const logos = [
  { src: '/images/fonesavers.webp', alt: 'Fonesavers', width: 320, height: 120 },
  { src: '/images/galaxyways.webp', alt: 'Galaxyways', width: 320, height: 120 },
  { src: '/images/melahut.webp', alt: 'MelaHut', width: 320, height: 120 },
  { src: '/images/nten8.webp', alt: 'NTEN8', width: 320, height: 120 },
  { src: '/images/shishavibe.webp', alt: 'ShishaVibe', width: 320, height: 120 },
] as const;

const track = [...logos, ...logos];
---

<section
  class="client-logos relative isolate overflow-hidden border-t border-white/10 bg-bg py-10 sm:py-12 lg:py-14"
  aria-labelledby="clients-heading"
>
  <div class="client-logos__bg pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute top-6 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgb(222_243_77_/0.07),transparent_70%)] blur-3xl"></div>
    <div class="absolute right-[8%] bottom-4 h-40 w-40 rounded-full bg-[radial-gradient(circle,rgb(197_246_61_/0.05),transparent_70%)] blur-3xl"></div>
    <span class="client-logos__shape client-logos__shape--ring"></span>
    <span class="client-logos__shape client-logos__shape--orb"></span>
    <span class="client-logos__shape client-logos__shape--square"></span>
    <span class="client-logos__shape client-logos__shape--line"></span>
    <span class="client-logos__shape client-logos__shape--dot"></span>
  </div>

  <Container class="relative">
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="clients-heading" class="font-display text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        <span class="text-highlight">Trusted Brands</span>
        <span class="text-white"> We've Worked With</span>
      </h2>
      <p class="mt-3 text-base leading-7 text-white/65 sm:text-lg">
        Driving digital growth across different industries.
      </p>
    </div>
  </Container>

  <div class="client-logo-slider relative mt-8 overflow-hidden sm:mt-10" aria-label="Client logos">
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 bg-gradient-to-r from-bg to-transparent sm:w-20" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-gradient-to-l from-bg to-transparent sm:w-20" aria-hidden="true"></div>

    <div class="client-logo-slider__viewport group">
      <ul class="client-logo-slider__track">
        {
          track.map((logo, index) => (
            <li class="client-logo-slider__item" aria-hidden={index >= logos.length ? 'true' : undefined}>
              <img
                src={logo.src}
                alt={index >= logos.length ? '' : logo.alt}
                width={logo.width}
                height={logo.height}
                loading="lazy"
                decoding="async"
                class="h-8 w-auto max-w-[7.5rem] object-contain object-center sm:h-10 sm:max-w-[9rem] lg:h-11 lg:max-w-[10rem]"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .client-logos__shape {
    position: absolute;
    opacity: 0.2;
    will-change: transform;
  }

  .client-logos__shape--ring {
    top: 14%;
    left: 5%;
    width: 5.5rem;
    height: 5.5rem;
    border: 1.5px solid rgb(222 243 77 / 0.5);
    border-radius: 9999px;
  }

  .client-logos__shape--orb {
    top: 18%;
    right: 7%;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 9999px;
    border: 1px solid rgb(222 243 77 / 0.22);
    background: radial-gradient(circle at 35% 30%, rgb(222 243 77 / 0.28), transparent 68%);
  }

  .client-logos__shape--square {
    --shape-rot: 16deg;
    bottom: 18%;
    left: 12%;
    width: 2.5rem;
    height: 2.5rem;
    border: 1.5px solid rgb(222 243 77 / 0.4);
    border-radius: 0.55rem;
    transform: rotate(var(--shape-rot));
  }

  .client-logos__shape--line {
    top: 48%;
    right: 16%;
    width: 3.75rem;
    height: 1.5px;
    border-radius: 9999px;
    background: linear-gradient(90deg, rgb(222 243 77 / 0.5), transparent);
  }

  .client-logos__shape--dot {
    bottom: 22%;
    right: 22%;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 9999px;
    background: #def34d;
    opacity: 0.26;
  }

  @media (max-width: 639px) {
    .client-logos__shape--ring {
      width: 3.75rem;
      height: 3.75rem;
      left: 2%;
    }

    .client-logos__shape--orb {
      width: 3rem;
      height: 3rem;
      right: 3%;
    }

    .client-logos__shape--square {
      opacity: 0.14;
    }
  }

  .client-logo-slider__viewport {
    overflow: hidden;
  }

  .client-logo-slider__track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 2.5rem;
    padding-inline: 1.5rem;
    animation: client-logo-marquee 32s linear infinite;
  }

  .client-logo-slider__viewport:hover .client-logo-slider__track {
    animation-play-state: paused;
  }

  .client-logo-slider__item {
    display: flex;
    height: 4rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.03);
    padding-inline: 1.25rem;
  }

  .client-logo-slider__item img {
    filter: grayscale(1) brightness(1.15) opacity(0.72);
    transition: filter 200ms ease;
  }

  .client-logo-slider__item:hover img {
    filter: none;
  }

  @keyframes client-logo-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (min-width: 640px) {
    .client-logo-slider__track {
      gap: 3rem;
      padding-inline: 2rem;
    }

    .client-logo-slider__item {
      height: 4.5rem;
      padding-inline: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .client-logos__shape--ring {
      animation: client-logos-drift-a 16s ease-in-out infinite;
    }

    .client-logos__shape--orb {
      animation: client-logos-drift-b 18s ease-in-out infinite;
    }

    .client-logos__shape--square {
      animation: client-logos-drift-c 14s ease-in-out infinite;
    }

    .client-logos__shape--line {
      animation: client-logos-drift-a 20s ease-in-out infinite reverse;
    }

    .client-logos__shape--dot {
      animation: client-logos-drift-b 12s ease-in-out infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .client-logo-slider__track {
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
      padding-inline: 1rem;
      animation: none;
      transform: none;
    }

    .client-logo-slider__item:nth-child(n + 6) {
      display: none;
    }
  }

  @keyframes client-logos-drift-a {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(10px, -14px, 0);
    }
  }

  @keyframes client-logos-drift-b {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-12px, 10px, 0);
    }
  }

  @keyframes client-logos-drift-c {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(var(--shape-rot, 0deg));
    }
    50% {
      transform: translate3d(8px, -8px, 0) rotate(calc(var(--shape-rot, 0deg) + 7deg));
    }
  }
</style>
