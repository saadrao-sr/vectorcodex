---
import type { IndustryLanding } from '../../../config/industries';
import AmbientBackdrop from '../../ui/AmbientBackdrop.astro';
import Container from '../../ui/Container.astro';
import { eyebrowClass } from '../../ui/styles';

interface Props {
  industry: IndustryLanding;
}

const { industry } = Astro.props;
const { audience } = industry;
---

<section
  id="industry-audience"
  class="industry-audience relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="industry-audience-heading"
>
  <AmbientBackdrop variant="mesh" />

  <Container class="relative">
    <header class="mx-auto max-w-3xl text-center">
      <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{audience.eyebrow}</p>
      <h2
        id="industry-audience-heading"
        class="mt-3 font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.25rem] lg:text-[2.55rem] lg:leading-[1.06]"
      >
        {audience.titleBefore}
        <span class="text-highlight"> {audience.titleHighlight}</span>
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-8">
        {audience.intro}
      </p>
    </header>

    <div class="industry-audience__shell">
      <ul class="industry-audience__segments">
        {
          audience.segments.map((segment, index) => (
            <li style={`--i: ${index}`}>
              <article class="industry-audience__segment">
                <p class="industry-audience__index font-display">{String(index + 1).padStart(2, '0')}</p>
                <h3 class="mt-2 font-display text-lg font-semibold tracking-tight text-white">{segment.title}</h3>
                <p class="mt-2 text-sm leading-6 text-white/60">{segment.text}</p>
              </article>
            </li>
          ))
        }
      </ul>

      <div class="industry-audience__journey-wrap">
        <p class="industry-audience__journey-label">Buyer journey</p>
        <ol class="industry-audience__journey">
          {
            audience.journey.map((step, index) => (
              <li class="industry-audience__step" style={`--j: ${index}`}>
                <span class="industry-audience__node" aria-hidden="true" />
                <div>
                  <h3 class="font-display text-base font-semibold tracking-tight text-white">{step.title}</h3>
                  <p class="mt-1.5 text-sm leading-6 text-white/60">{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </Container>
</section>

<style>
  .industry-audience__shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: 3rem;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .industry-audience__shell {
      margin-top: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .industry-audience__shell {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 1.25rem;
    }
  }

  .industry-audience__segments {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .industry-audience__segments li {
    min-height: 0;
    height: 100%;
  }

  .industry-audience__segment {
    display: flex;
    height: 100%;
    min-height: 100%;
    flex-direction: column;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.35rem;
    background: rgb(255 255 255 / 0.03);
    padding: 1.25rem;
  }

  .industry-audience__index {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #def34d;
  }

  .industry-audience__journey-wrap {
    display: flex;
    height: 100%;
    flex-direction: column;
    border: 1px solid rgb(222 243 77 / 0.28);
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 90% 10%, rgb(222 243 77 / 0.1), transparent 45%),
      rgb(255 255 255 / 0.03);
    padding: 1.25rem;
  }

  .industry-audience__journey-label {
    margin: 0 0 1rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #def34d;
  }

  .industry-audience__journey {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .industry-audience__step {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem;
    flex: 1;
    padding-bottom: 1rem;
  }

  .industry-audience__step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 1.1rem;
    left: 0.45rem;
    width: 2px;
    height: calc(100% - 0.35rem);
    background: linear-gradient(180deg, rgb(222 243 77 / 0.5), rgb(222 243 77 / 0.08));
  }

  .industry-audience__step:last-child {
    padding-bottom: 0;
  }

  .industry-audience__node {
    position: relative;
    z-index: 1;
    width: 0.95rem;
    height: 0.95rem;
    margin-top: 0.25rem;
    border: 2px solid #def34d;
    border-radius: 9999px;
    background: #0d120c;
  }

  @media (prefers-reduced-motion: no-preference) {
    .industry-audience__segments li,
    .industry-audience__step {
      opacity: 0;
      transform: translateY(12px);
      animation: industry-audience-rise 0.6s ease forwards;
    }

    .industry-audience__segments li {
      animation-delay: calc(100ms + var(--i, 0) * 60ms);
    }

    .industry-audience__step {
      animation-delay: calc(180ms + var(--j, 0) * 70ms);
    }
  }

  @keyframes industry-audience-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
