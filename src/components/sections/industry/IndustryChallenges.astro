---
import {
  FileText,
  Gauge,
  MapPin,
  Megaphone,
  Search,
  Shield,
  Smartphone,
  Users,
  type LucideIcon,
} from 'lucide-react';
import type { IndustryChallengeIcon, IndustryLanding } from '../../../config/industries';
import AmbientBackdrop from '../../ui/AmbientBackdrop.astro';
import Container from '../../ui/Container.astro';
import { eyebrowClass } from '../../ui/styles';

interface Props {
  industry: IndustryLanding;
}

const { industry } = Astro.props;
const { challenges } = industry;

const icons: Record<IndustryChallengeIcon, LucideIcon> = {
  search: Search,
  shield: Shield,
  users: Users,
  file: FileText,
  smartphone: Smartphone,
  megaphone: Megaphone,
  gauge: Gauge,
  'map-pin': MapPin,
};
---

<section
  id="industry-challenges"
  class="industry-challenges relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="industry-challenges-heading"
>
  <AmbientBackdrop variant="drift" />

  <Container class="relative">
    <header class="mx-auto max-w-3xl text-center">
      <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{challenges.eyebrow}</p>
      <h2
        id="industry-challenges-heading"
        class="mt-3 font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.25rem] lg:text-[2.55rem] lg:leading-[1.06]"
      >
        {challenges.titleBefore}
        <span class="text-highlight"> {challenges.titleHighlight}</span>
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-8">
        {challenges.intro}
      </p>
    </header>

    <ul class="industry-challenges__grid">
      {
        challenges.items.map((item, index) => {
          const Icon = icons[item.icon];
          return (
            <li
              class:list={[
                'industry-challenges__tile',
                item.featured && 'industry-challenges__tile--featured',
              ]}
              style={`--tile-i: ${index}`}
            >
              <article class="industry-challenges__card group">
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-br from-highlight/10 via-transparent to-transparent opacity-80 transition duration-300 group-hover:opacity-100"
                  aria-hidden="true"
                />
                <div class="relative flex h-full flex-col">
                  <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-highlight/30 bg-highlight/10 text-highlight">
                    <Icon size={18} aria-hidden="true" />
                  </span>
                  <h3 class="mt-3 font-display text-lg font-semibold tracking-tight text-white sm:text-xl">
                    {item.title}
                  </h3>
                  <p class="mt-2 flex-1 text-sm leading-6 text-white/60">{item.problem}</p>
                  <p class="mt-3 border-t border-white/10 pt-3 text-sm font-medium leading-6 text-highlight/90">
                    Opportunity: {item.opportunity}
                  </p>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </Container>
</section>

<style>
  .industry-challenges__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    align-items: stretch;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .industry-challenges__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .industry-challenges__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.15rem;
    }
  }

  .industry-challenges__tile {
    min-width: 0;
    height: 100%;
  }

  .industry-challenges__card {
    position: relative;
    display: flex;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.35rem;
    background: rgb(255 255 255 / 0.03);
    padding: 1.25rem;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease;
  }

  .industry-challenges__tile--featured .industry-challenges__card {
    border-color: rgb(222 243 77 / 0.28);
  }

  .industry-challenges__card:hover {
    border-color: rgb(222 243 77 / 0.4);
    background: rgb(255 255 255 / 0.05);
  }

  @media (prefers-reduced-motion: no-preference) {
    .industry-challenges__tile {
      opacity: 0;
      transform: translateY(14px);
      animation: industry-challenges-rise 0.65s ease forwards;
      animation-delay: calc(120ms + var(--tile-i, 0) * 60ms);
    }
  }

  @keyframes industry-challenges-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
