---
import type { IndustryLanding } from '../../../config/industries';
import AmbientBackdrop from '../../ui/AmbientBackdrop.astro';
import Container from '../../ui/Container.astro';
import { eyebrowClass } from '../../ui/styles';

interface Props {
  industry: IndustryLanding;
}

const { industry } = Astro.props;
const { solutions } = industry;
---

<section
  id="industry-solutions"
  class="industry-solutions relative isolate scroll-mt-28 overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="industry-solutions-heading"
>
  <AmbientBackdrop variant="orbs" />

  <Container class="relative">
    <header class="mx-auto max-w-3xl text-center">
      <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{solutions.eyebrow}</p>
      <h2
        id="industry-solutions-heading"
        class="mt-3 font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.25rem] lg:text-[2.55rem] lg:leading-[1.06]"
      >
        {solutions.titleBefore}
        <span class="text-highlight"> {solutions.titleHighlight}</span>
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-8">
        {solutions.intro}
      </p>
    </header>

    <ul class="industry-solutions__grid">
      {
        solutions.items.map((item, index) => (
          <li style={`--i: ${index}`}>
            <article class="industry-solutions__card">
              <p class="industry-solutions__index font-display">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="mt-3 font-display text-xl font-semibold tracking-tight text-white">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-white/60">{item.text}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .industry-solutions__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .industry-solutions__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 3.5rem;
    }
  }

  .industry-solutions__card {
    height: 100%;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.35rem;
    background: rgb(255 255 255 / 0.03);
    padding: 1.25rem 1.2rem 1.3rem;
    transition: border-color 0.25s ease;
  }

  .industry-solutions__card:hover {
    border-color: rgb(222 243 77 / 0.4);
  }

  .industry-solutions__index {
    font-size: clamp(1.8rem, 3.5vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    color: rgb(222 243 77 / 0.35);
  }

  @media (prefers-reduced-motion: no-preference) {
    .industry-solutions__grid li {
      opacity: 0;
      transform: translateY(14px);
      animation: industry-solutions-rise 0.65s ease forwards;
      animation-delay: calc(100ms + var(--i, 0) * 70ms);
    }
  }

  @keyframes industry-solutions-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
