---
import { ArrowUpRight } from 'lucide-react';
import type { IndustryLanding } from '../../../config/industries';
import FaqAccordion from '../../interactive/FaqAccordion';
import AmbientBackdrop from '../../ui/AmbientBackdrop.astro';
import Container from '../../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../../ui/styles';

interface Props {
  industry: IndustryLanding;
}

const { industry } = Astro.props;
const { faqs } = industry;
---

<section
  id="industry-faq"
  class="industry-faq relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="industry-faq-heading"
>
  <AmbientBackdrop variant="orbs" />

  <Container class="relative">
    <div class="industry-faq__layout">
      <div class="industry-faq__copy min-w-0">
        <p class:list={[eyebrowClass, 'w-fit max-w-full']}>{faqs.eyebrow}</p>
        <h2
          id="industry-faq-heading"
          class="mt-3 max-w-xl font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.25rem] lg:text-[2.45rem] lg:leading-[1.08]"
        >
          {faqs.titleBefore}
          <span class="text-highlight"> {faqs.titleHighlight}</span>
        </h2>
        <p class="mt-3 max-w-md text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-8">
          {faqs.intro}
        </p>
        <div class="mt-5 flex flex-col gap-3 sm:mt-6 sm:flex-row sm:flex-wrap">
          <button
            type="button"
            class:list={[
              buttonClass.base,
              buttonClass.gradient,
              'w-full shadow-[0_14px_40px_rgb(197_246_61_/0.18)] sm:w-auto',
            ]}
            data-quote-open
          >
            Discuss Your Project
            <ArrowUpRight size={16} aria-hidden="true" />
          </button>
          <a href="/contact/" class:list={[buttonClass.base, buttonClass.ghost, 'w-full sm:w-auto']}>
            Contact Us
          </a>
        </div>
      </div>

      <div class="industry-faq__accordion min-w-0">
        <FaqAccordion client:visible items={faqs.items} />
      </div>
    </div>
  </Container>
</section>

<style>
  .industry-faq__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .industry-faq__layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 2rem;
    }

    .industry-faq__copy {
      position: sticky;
      top: 6.5rem;
    }
  }
</style>
