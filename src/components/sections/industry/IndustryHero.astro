---
import {
  ArrowDown,
  ArrowUpRight,
  Building2,
  Calculator,
  HeartPulse,
  Plane,
  ShieldCheck,
  Stethoscope,
  type LucideIcon,
} from 'lucide-react';
import type { IndustryLanding, IndustryVisualMotif } from '../../../config/industries';
import AmbientBackdrop from '../../ui/AmbientBackdrop.astro';
import Container from '../../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../../ui/styles';

interface Props {
  industry: IndustryLanding;
}

const { industry } = Astro.props;
const { hero } = industry;

const motifVisuals: Record<
  IndustryVisualMotif,
  { panelTitle: string; chips: { Icon: LucideIcon; label: string }[] }
> = {
  care: {
    panelTitle: 'Digital care journeys',
    chips: [
      { Icon: HeartPulse, label: 'Trust' },
      { Icon: Stethoscope, label: 'Clarity' },
      { Icon: ShieldCheck, label: 'Access' },
    ],
  },
  finance: {
    panelTitle: 'Trusted financial journeys',
    chips: [
      { Icon: Calculator, label: 'Clarity' },
      { Icon: ShieldCheck, label: 'Trust' },
      { Icon: Building2, label: 'Growth' },
    ],
  },
  travel: {
    panelTitle: 'Travel discovery paths',
    chips: [
      { Icon: Plane, label: 'Reach' },
      { Icon: ShieldCheck, label: 'Trust' },
      { Icon: Building2, label: 'Book' },
    ],
  },
  property: {
    panelTitle: 'Property demand paths',
    chips: [
      { Icon: Building2, label: 'Listings' },
      { Icon: ShieldCheck, label: 'Trust' },
      { Icon: HeartPulse, label: 'Enquiry' },
    ],
  },
  generic: {
    panelTitle: 'Digital growth journeys',
    chips: [
      { Icon: ShieldCheck, label: 'Trust' },
      { Icon: Building2, label: 'Clarity' },
      { Icon: HeartPulse, label: 'Growth' },
    ],
  },
};

const visual = motifVisuals[industry.visualMotif];
---

<section
  id="industry-hero"
  class="industry-hero relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="industry-hero-heading"
>
  <AmbientBackdrop variant="mesh" />

  <Container class="relative">
    <div class="industry-hero__layout">
      <div class="industry-hero__copy min-w-0">
        <p class:list={[eyebrowClass, 'w-fit max-w-full']}>{hero.eyebrow}</p>
        <h1
          id="industry-hero-heading"
          class="mt-3 max-w-xl font-display text-[1.85rem] leading-[1.1] font-semibold tracking-tight text-balance text-white sm:text-[2.35rem] sm:leading-[1.06] lg:text-[2.85rem] lg:leading-[1.04]"
        >
          {hero.titleBefore}
          <span class="text-highlight"> {hero.titleHighlight}</span>
        </h1>
        <p class="mt-4 max-w-lg text-sm leading-7 text-white/65 sm:mt-5 sm:text-base sm:leading-8">
          {hero.intro}
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:mt-7 sm:flex-row sm:flex-wrap">
          <a
            href="#industry-solutions"
            class:list={[
              buttonClass.base,
              buttonClass.gradient,
              'w-full shadow-[0_14px_40px_rgb(197_246_61_/0.18)] sm:w-auto',
            ]}
          >
            {hero.primaryCtaLabel}
            <ArrowDown size={16} aria-hidden="true" />
          </a>
          <button
            type="button"
            class:list={[buttonClass.base, buttonClass.ghost, 'w-full sm:w-auto']}
            data-quote-open
          >
            {hero.secondaryCtaLabel}
            <ArrowUpRight size={16} aria-hidden="true" />
          </button>
        </div>
      </div>

      <div class="industry-hero__visual" aria-hidden="true">
        <div class="industry-hero__panel">
          <div class="industry-hero__orbit"></div>
          <div class="industry-hero__orbit industry-hero__orbit--inner"></div>
          <p class="industry-hero__kicker">{industry.shortName}</p>
          <p class="industry-hero__panel-title font-display">{visual.panelTitle}</p>
          <ul class="industry-hero__chips">
            {
              visual.chips.map((chip, index) => {
                const Icon = chip.Icon;
                return (
                  <li class={`industry-hero__chip industry-hero__chip--${index + 1}`}>
                    <Icon size={16} />
                    <span>{chip.label}</span>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .industry-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .industry-hero__layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 2rem;
    }
  }

  .industry-hero__panel {
    position: relative;
    overflow: hidden;
    min-height: 16rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.6rem;
    background:
      radial-gradient(circle at 70% 20%, rgb(222 243 77 / 0.14), transparent 48%),
      linear-gradient(165deg, rgb(18 24 17 / 0.96), rgb(13 18 12 / 0.92));
    padding: 1.6rem 1.4rem;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.28);
  }

  @media (min-width: 640px) {
    .industry-hero__panel {
      min-height: 18rem;
      padding: 1.9rem 1.7rem;
    }
  }

  .industry-hero__orbit {
    position: absolute;
    top: 18%;
    right: 8%;
    width: 9rem;
    height: 9rem;
    border: 1px solid rgb(222 243 77 / 0.22);
    border-radius: 9999px;
  }

  .industry-hero__orbit--inner {
    top: 28%;
    right: 16%;
    width: 5.5rem;
    height: 5.5rem;
    border-style: dashed;
    border-color: rgb(222 243 77 / 0.35);
  }

  .industry-hero__kicker {
    position: relative;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #def34d;
  }

  .industry-hero__panel-title {
    position: relative;
    margin-top: 0.75rem;
    max-width: 10ch;
    font-size: clamp(1.7rem, 3.5vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: #fff;
  }

  .industry-hero__chips {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  .industry-hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid rgb(222 243 77 / 0.28);
    border-radius: 9999px;
    background: rgb(13 18 12 / 0.75);
    padding: 0.45rem 0.75rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.8);
  }

  .industry-hero__chip svg {
    color: #def34d;
  }

  @media (prefers-reduced-motion: no-preference) {
    .industry-hero__copy,
    .industry-hero__visual {
      opacity: 0;
      transform: translateY(14px);
      animation: industry-hero-rise 0.7s ease forwards;
    }

    .industry-hero__copy {
      animation-delay: 60ms;
    }

    .industry-hero__visual {
      animation-delay: 140ms;
    }

    .industry-hero__orbit--inner {
      animation: industry-hero-spin 28s linear infinite;
    }
  }

  @keyframes industry-hero-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes industry-hero-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
