---
import type { IndustryLanding } from '../../../config/industries';
import AmbientBackdrop from '../../ui/AmbientBackdrop.astro';
import Container from '../../ui/Container.astro';
import { eyebrowClass } from '../../ui/styles';

interface Props {
  industry: IndustryLanding;
}

const { industry } = Astro.props;
const { why } = industry;
const statementLines = why.statement
  .replace(/\.$/, '')
  .split(/\.\s+/)
  .map((line) => line.trim())
  .filter(Boolean);
---

<section
  id="industry-why"
  class="industry-why relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="industry-why-heading"
>
  <AmbientBackdrop variant="orbs" />

  <Container class="relative">
    <header class="mx-auto max-w-3xl text-center">
      <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{why.eyebrow}</p>
      <h2
        id="industry-why-heading"
        class="mt-3 font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.25rem] lg:text-[2.55rem] lg:leading-[1.06]"
      >
        {why.titleBefore}
        <span class="text-highlight"> {why.titleHighlight}</span>
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-8">
        {why.intro}
      </p>
    </header>

    <div class="industry-why__stage">
      <div class="industry-why__core">
        <p class="industry-why__kicker">Why organisations choose us</p>
        <p class="industry-why__statement font-display">
          {
            statementLines.map((line, index) => (
              <span class:list={['industry-why__line', index === statementLines.length - 1 && 'industry-why__line--accent']}>
                {line}.
              </span>
            ))
          }
        </p>
      </div>

      <ul class="industry-why__points">
        {
          why.points.map((point, index) => (
            <li style={`--i: ${index}`}>
              <article class="industry-why__card">
                <p class="industry-why__number font-display">{String(index + 1).padStart(2, '0')}</p>
                <h3 class="mt-2 font-display text-lg font-semibold tracking-tight text-white">{point.title}</h3>
                <p class="mt-2 text-sm leading-6 text-white/60">{point.text}</p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</section>

<style>
  .industry-why__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin-top: 3rem;
  }

  @media (min-width: 640px) {
    .industry-why__stage {
      margin-top: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .industry-why__stage {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 1.25rem;
      align-items: stretch;
    }
  }

  .industry-why__core {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border: 1px solid rgb(222 243 77 / 0.35);
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 50% 20%, rgb(222 243 77 / 0.14), transparent 50%),
      linear-gradient(165deg, rgb(18 24 17 / 0.98), rgb(13 18 12 / 0.94));
    padding: 1.5rem 1.3rem;
    text-align: center;
  }

  .industry-why__kicker {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #def34d;
  }

  .industry-why__statement {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.9rem;
  }

  .industry-why__line {
    font-size: clamp(1.2rem, 2.5vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: #fff;
  }

  .industry-why__line--accent {
    color: #def34d;
  }

  .industry-why__points {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    align-items: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .industry-why__points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .industry-why__points li {
    min-width: 0;
    height: 100%;
  }

  .industry-why__card {
    display: flex;
    height: 100%;
    min-height: 100%;
    flex-direction: column;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.03);
    padding: 1.25rem;
  }

  .industry-why__number {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #def34d;
  }

  @media (prefers-reduced-motion: no-preference) {
    .industry-why__core,
    .industry-why__points li {
      opacity: 0;
      transform: translateY(12px);
      animation: industry-why-rise 0.65s ease forwards;
    }

    .industry-why__core {
      animation-delay: 80ms;
    }

    .industry-why__points li {
      animation-delay: calc(140ms + var(--i, 0) * 55ms);
    }
  }

  @keyframes industry-why-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
