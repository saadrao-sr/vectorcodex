---
import {
  Compass,
  LineChart,
  PenTool,
  Rocket,
  TrendingUp,
  type LucideIcon,
} from 'lucide-react';
import AmbientBackdrop from '../ui/AmbientBackdrop.astro';
import Container from '../ui/Container.astro';
import { eyebrowClass } from '../ui/styles';

type Step = {
  number: string;
  title: string;
  text: string;
  Icon: LucideIcon;
};

const steps: Step[] = [
  {
    number: '01',
    title: 'Discover & Understand',
    text: 'We learn about your business, goals, audience, challenges, and expectations.',
    Icon: Compass,
  },
  {
    number: '02',
    title: 'Research & Strategize',
    text: 'We analyze opportunities and develop a tailored digital strategy and project roadmap.',
    Icon: LineChart,
  },
  {
    number: '03',
    title: 'Plan & Create',
    text: 'Our team designs, develops, and implements solutions aligned with your objectives.',
    Icon: PenTool,
  },
  {
    number: '04',
    title: 'Launch & Optimize',
    text: 'We test, launch, monitor performance, and refine the work for better results.',
    Icon: Rocket,
  },
  {
    number: '05',
    title: 'Grow & Support',
    text: 'We provide ongoing improvements, support, and strategic guidance as your business grows.',
    Icon: TrendingUp,
  },
];
---

<section id="how-we-work" class="relative isolate overflow-hidden border-t border-white/10 bg-bg py-12 sm:py-14 lg:py-16" aria-labelledby="how-we-work-heading">
  <AmbientBackdrop variant="mesh" />

  <Container class="relative">
    <div class="mx-auto max-w-3xl text-center">
      <p class={eyebrowClass}>How we work</p>
      <h2
        id="how-we-work-heading"
        class="mt-3 font-display text-3xl font-semibold tracking-tight text-balance sm:text-4xl lg:text-[2.75rem]"
      >
        <span class="text-white">From First Conversation to </span>
        <span class="text-highlight">Real Growth</span>
      </h2>
      <p class="mt-3 text-base leading-7 text-white/65 sm:text-lg sm:leading-8">
        A clear, collaborative process that turns your business goals into digital solutions and measurable progress.
      </p>
    </div>

    <ol class="how-process relative mt-8 sm:mt-10">
      <div class="how-process__line" aria-hidden="true"></div>

      {
        steps.map((step) => {
          const Icon = step.Icon;
          return (
            <li class="how-process__step group relative">
              <div class="how-process__marker">
                <span class="how-process__number">{step.number}</span>
              </div>

              <article class="how-process__card">
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-highlight/12 via-transparent to-transparent opacity-80 transition duration-300 group-hover:opacity-100" aria-hidden="true" />
                <div class="pointer-events-none absolute -top-12 -right-10 h-28 w-28 rounded-full bg-highlight/10 blur-2xl transition duration-500 group-hover:bg-highlight/18" aria-hidden="true" />

                <div class="relative">
                  <div class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-highlight/25 bg-highlight/10 text-highlight shadow-[0_0_30px_rgb(222_243_77_/0.12)] transition duration-300 group-hover:border-highlight/50 group-hover:shadow-[0_0_40px_rgb(222_243_77_/0.22)]">
                    <Icon size={20} aria-hidden="true" />
                  </div>
                  <h3 class="mt-3 font-display text-xl font-semibold tracking-tight text-white">{step.title}</h3>
                  <p class="mt-2 text-sm leading-6 text-white/65">{step.text}</p>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>
  </Container>
</section>

<style>
  .how-process {
    display: grid;
    gap: 1.25rem;
  }

  .how-process__line {
    display: none;
  }

  .how-process__step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .how-process__step:not(:last-child) .how-process__marker::after {
    content: '';
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 50%;
    width: 2px;
    height: calc(100% + 0.55rem);
    transform: translateX(-50%);
    border-radius: 9999px;
    background: linear-gradient(180deg, rgb(197 246 61 / 0.55), rgb(246 239 92 / 0.2));
  }

  .how-process__marker {
    position: relative;
    z-index: 1;
    display: flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgb(222 243 77 / 0.35);
    background: #0d120c;
    box-shadow: 0 0 0 6px rgb(13 18 12 / 0.95), 0 0 28px rgb(222 243 77 / 0.18);
    transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;
  }

  .how-process__step:hover .how-process__marker {
    border-color: rgb(222 243 77 / 0.7);
    box-shadow: 0 0 0 6px rgb(13 18 12 / 0.95), 0 0 36px rgb(222 243 77 / 0.28);
    transform: translateY(-1px);
  }

  .how-process__number {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #def34d;
  }

  .how-process__card {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(255 255 255 / 0.03);
    padding: 1.1rem 1.2rem;
    transition: border-color 200ms ease, background-color 200ms ease, transform 200ms ease;
  }

  .how-process__step:hover .how-process__card {
    border-color: rgb(222 243 77 / 0.4);
    background: rgb(255 255 255 / 0.05);
    transform: translateY(-2px);
  }

  @media (min-width: 1024px) {
    .how-process {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1rem;
      padding-top: 0.5rem;
    }

    .how-process__line {
      display: block;
      position: absolute;
      top: 1.85rem;
      left: 6%;
      right: 6%;
      height: 2px;
      border-radius: 9999px;
      background: linear-gradient(90deg, transparent, rgb(197 246 61 / 0.55), rgb(246 239 92 / 0.55), transparent);
      background-size: 200% 100%;
      animation: how-line-flow 4.5s linear infinite;
    }

    .how-process__step {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 1.1rem;
    }

    .how-process__step:not(:last-child) .how-process__marker::after {
      display: none;
    }

    .how-process__marker {
      margin-top: 0.15rem;
    }

    .how-process__card {
      width: 100%;
      min-height: 100%;
      padding: 1.2rem 1.05rem 1.3rem;
      text-align: center;
    }

    .how-process__card .inline-flex {
      margin-inline: auto;
    }
  }

  @keyframes how-line-flow {
    from {
      background-position: 0% 50%;
    }
    to {
      background-position: 200% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .how-process__line {
      animation: none;
    }

    .how-process__step:hover .how-process__marker,
    .how-process__step:hover .how-process__card {
      transform: none;
    }
  }
</style>
