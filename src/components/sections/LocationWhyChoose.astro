---
import type { LocationOffice } from '../../config/locations';
import Container from '../ui/Container.astro';
import { eyebrowClass } from '../ui/styles';
import LocationAmbientBg from './LocationAmbientBg.astro';

interface Props {
  location: LocationOffice;
}

const { location } = Astro.props;
const { whyChoose } = location;
const statementLines = whyChoose.statement
  .replace(/\.$/, '')
  .split(/\.\s+/)
  .map((line) => line.trim())
  .filter(Boolean);
---

<section
  id="location-why"
  class="location-why relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="location-why-heading"
>
  <LocationAmbientBg variant="c" />

  <Container class="relative">
    <header class="location-why__header mx-auto max-w-3xl text-center">
      <p class:list={[eyebrowClass, 'location-why__eyebrow mx-auto w-fit max-w-full']}>Why VectorCodex</p>
      <h2
        id="location-why-heading"
        class="location-why__title mt-3 font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.25rem] lg:text-[2.45rem] lg:leading-[1.06]"
      >
        A Digital Growth Partner Focused on
        <span class="text-highlight"> Your Success.</span>
      </h2>
      <p class="location-why__intro mx-auto mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-8">
        {whyChoose.intro}
      </p>
    </header>

    <div class="location-why__stage mt-7 sm:mt-8">
      <div class="location-why__orbit" aria-hidden="true">
        <span class="location-why__ring location-why__ring--outer"></span>
        <span class="location-why__ring location-why__ring--mid"></span>
        <span class="location-why__ring location-why__ring--inner"></span>
        <svg class="location-why__spokes" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid meet">
          <path d="M200 40 L200 360"></path>
          <path d="M40 200 L360 200"></path>
          <path d="M78 78 L322 322"></path>
          <path d="M322 78 L78 322"></path>
        </svg>
      </div>

      <div class="location-why__core">
        <span class="location-why__core-mark" aria-hidden="true"></span>
        <p class="location-why__core-kicker">Why businesses in {location.locationLabel} choose us</p>
        <p class="location-why__statement font-display">
          {
            statementLines.map((line, index) => (
              <span
                class:list={[
                  'location-why__line',
                  index === statementLines.length - 1 && 'location-why__line--accent',
                ]}
              >
                {line}.
              </span>
            ))
          }
        </p>
        <span class="location-why__core-rule" aria-hidden="true"></span>
      </div>

      <ol class="location-why__points">
        {
          whyChoose.points.map((point, index) => {
            const number = String(index + 1).padStart(2, '0');
            return (
              <li
                class={`location-why__point location-why__point--${index + 1}`}
                style={`--why-i: ${index}`}
              >
                <article class="location-why__card group">
                  <span class="location-why__number font-display">{number}</span>
                  <h3 class="location-why__point-title font-display">{point.title}</h3>
                  <p class="location-why__point-text">{point.text}</p>
                </article>
              </li>
            );
          })
        }
      </ol>
    </div>
  </Container>
</section>

<style>
  .location-why__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem;
  }

  @media (min-width: 1024px) {
    .location-why__stage {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto auto;
      gap: 0.85rem 1rem;
      align-items: stretch;
    }
  }

  .location-why__orbit {
    display: none;
  }

  @media (min-width: 1024px) {
    .location-why__orbit {
      position: absolute;
      inset: 12% 18% 10% 18%;
      z-index: 0;
      display: block;
      pointer-events: none;
    }
  }

  .location-why__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    border: 1px solid rgb(222 243 77 / 0.16);
    border-radius: 9999px;
    transform: translate(-50%, -50%);
  }

  .location-why__ring--outer {
    width: min(100%, 28rem);
    aspect-ratio: 1;
  }

  .location-why__ring--mid {
    width: min(78%, 21rem);
    aspect-ratio: 1;
    border-color: rgb(222 243 77 / 0.24);
  }

  .location-why__ring--inner {
    width: min(52%, 14rem);
    aspect-ratio: 1;
    border-style: dashed;
    border-color: rgb(222 243 77 / 0.28);
  }

  .location-why__spokes {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(100%, 28rem);
    height: auto;
    aspect-ratio: 1;
    opacity: 0.28;
    transform: translate(-50%, -50%);
  }

  .location-why__spokes path {
    fill: none;
    stroke: rgb(222 243 77 / 0.35);
    stroke-width: 1;
    stroke-dasharray: 4 6;
  }

  .location-why__core {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(222 243 77 / 0.35);
    border-radius: 1.75rem;
    background:
      radial-gradient(circle at 50% 20%, rgb(222 243 77 / 0.18), transparent 42%),
      radial-gradient(circle at 80% 90%, rgb(197 246 61 / 0.08), transparent 40%),
      linear-gradient(165deg, rgb(18 24 17 / 0.98), rgb(13 18 12 / 0.94));
    padding: 1.25rem 1.15rem 1.2rem;
    text-align: center;
    box-shadow:
      0 0 0 1px rgb(222 243 77 / 0.08) inset,
      0 28px 70px rgb(0 0 0 / 0.35);
  }

  @media (min-width: 640px) {
    .location-why__core {
      padding: 1.4rem 1.5rem 1.35rem;
    }
  }

  @media (min-width: 1024px) {
    .location-why__core {
      grid-column: 4 / span 6;
      grid-row: 2;
      padding: 1.5rem 1.75rem 1.4rem;
      align-self: center;
    }
  }

  .location-why__core-mark {
    position: absolute;
    inset: 0.9rem;
    pointer-events: none;
  }

  .location-why__core-mark::before,
  .location-why__core-mark::after {
    content: '';
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border: solid #def34d;
    opacity: 0.8;
  }

  .location-why__core-mark::before {
    top: 0;
    left: 0;
    border-width: 2px 0 0 2px;
  }

  .location-why__core-mark::after {
    right: 0;
    bottom: 0;
    border-width: 0 2px 2px 0;
  }

  .location-why__core::before {
    content: '';
    position: absolute;
    inset: auto 18% 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #def34d 50%, transparent);
    opacity: 0.55;
  }

  .location-why__core-kicker {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    max-width: 100%;
    padding: 0.4rem 0.85rem;
    border: 1px solid rgb(222 243 77 / 0.28);
    border-radius: 9999px;
    background: rgb(222 243 77 / 0.08);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #def34d;
  }

  .location-why__statement {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    margin-top: 0.85rem;
    width: 100%;
    max-width: 20rem;
  }

  .location-why__line {
    display: block;
    width: 100%;
    font-size: clamp(1.15rem, 2.4vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.25;
    white-space: nowrap;
    color: #fff;
  }

  .location-why__line--accent {
    color: #def34d;
  }

  .location-why__core-rule {
    display: block;
    width: 2.5rem;
    height: 2px;
    margin-top: 0.9rem;
    border-radius: 9999px;
    background: linear-gradient(90deg, #def34d, #c5f63d);
    box-shadow: 0 0 14px rgb(222 243 77 / 0.4);
  }

  .location-why__points {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .location-why__points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .location-why__points {
      display: contents;
    }

    .location-why__point--1 {
      grid-column: 1 / span 4;
      grid-row: 1;
    }

    .location-why__point--2 {
      grid-column: 9 / span 4;
      grid-row: 1;
    }

    .location-why__point--3 {
      grid-column: 1 / span 3;
      grid-row: 2;
      align-self: center;
    }

    .location-why__point--4 {
      grid-column: 10 / span 3;
      grid-row: 2;
      align-self: center;
    }

    .location-why__point--5 {
      grid-column: 3 / span 8;
      grid-row: 3;
      justify-self: center;
      width: min(100%, 34rem);
    }
  }

  .location-why__card {
    height: 100%;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.03);
    padding: 1rem 1rem 1.05rem;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  @media (min-width: 640px) {
    .location-why__card {
      padding: 1.1rem 1.15rem 1.15rem;
    }
  }

  .location-why__card:hover {
    border-color: rgb(222 243 77 / 0.4);
    background: rgb(255 255 255 / 0.05);
  }

  .location-why__number {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #def34d;
  }

  .location-why__point-title {
    margin-top: 0.55rem;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: #fff;
  }

  @media (min-width: 640px) {
    .location-why__point-title {
      font-size: 1.12rem;
    }
  }

  .location-why__point-text {
    margin-top: 0.55rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: rgb(255 255 255 / 0.6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .location-why__header,
    .location-why__core {
      opacity: 0;
      transform: translateY(14px);
      animation: location-why-rise 0.7s ease forwards;
    }

    .location-why__header {
      animation-delay: 50ms;
    }

    .location-why__core {
      animation-delay: 120ms;
    }

    .location-why__point {
      opacity: 0;
      transform: translateY(12px);
      animation: location-why-rise 0.6s ease forwards;
      animation-delay: calc(180ms + var(--why-i, 0) * 55ms);
    }

    .location-why__ring--inner {
      animation: location-why-spin 28s linear infinite;
    }

    .location-why__core-rule {
      animation: location-why-rule 2.8s ease-in-out infinite;
    }
  }

  @keyframes location-why-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes location-why-spin {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  @keyframes location-why-rule {
    0%,
    100% {
      transform: scaleX(1);
      opacity: 0.85;
    }
    50% {
      transform: scaleX(1.35);
      opacity: 1;
    }
  }

  @media (max-width: 420px) {
    .location-why__line {
      white-space: normal;
      text-wrap: balance;
    }
  }
</style>
