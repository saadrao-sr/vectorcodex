---
import type { LocationMapId } from '../../config/locations';

interface Props {
  mapId: LocationMapId;
  visualLabel: string;
}

const { mapId, visualLabel } = Astro.props;

/** Simplified geographic outlines for hero composition (stylised, recognisable shapes). */
const maps: Record<
  LocationMapId,
  {
    viewBox: string;
    path: string;
    points: { x: number; y: number }[];
    lines: string[];
  }
> = {
  uae: {
    viewBox: '0 0 200 160',
    // Simplified UAE peninsula / gulf coastline silhouette
    path: 'M28 78 C36 52 58 38 82 36 C104 34 118 42 128 54 C138 48 152 46 168 52 C178 58 184 70 178 86 C172 104 154 118 132 124 C118 128 104 126 94 118 C86 132 70 140 52 136 C34 132 24 112 28 78 Z',
    points: [
      { x: 96, y: 72 },
      { x: 128, y: 68 },
      { x: 148, y: 78 },
      { x: 72, y: 96 },
      { x: 112, y: 104 },
    ],
    lines: ['M96 72 L128 68', 'M128 68 L148 78', 'M96 72 L112 104', 'M72 96 L112 104', 'M112 104 L148 78'],
  },
  london: {
    viewBox: '0 0 200 220',
    // Simplified Great Britain outline with focus cue toward southeast England
    path: 'M86 18 C96 14 108 18 112 30 C118 28 128 34 126 46 C134 52 138 64 132 76 C140 86 142 102 136 116 C144 128 140 146 128 156 C134 170 126 188 110 196 C98 204 84 200 78 186 C66 190 54 180 56 166 C44 158 42 140 50 128 C42 112 48 94 60 86 C56 70 62 52 74 44 C72 32 78 22 86 18 Z',
    points: [
      { x: 118, y: 148 },
      { x: 104, y: 132 },
      { x: 92, y: 156 },
      { x: 108, y: 168 },
      { x: 84, y: 110 },
    ],
    lines: ['M104 132 L118 148', 'M118 148 L108 168', 'M92 156 L118 148', 'M84 110 L104 132', 'M92 156 L108 168'],
  },
  pakistan: {
    viewBox: '0 0 180 240',
    // Simplified Pakistan outline (north to south)
    path: 'M78 22 C96 18 118 28 128 46 C140 54 150 70 146 90 C154 104 152 124 140 138 C148 152 146 172 132 186 C124 202 108 216 88 220 C70 224 54 214 50 196 C38 186 34 166 42 150 C34 134 36 114 48 100 C42 82 48 60 62 48 C66 34 70 26 78 22 Z',
    points: [
      { x: 92, y: 128 },
      { x: 108, y: 96 },
      { x: 78, y: 156 },
      { x: 118, y: 148 },
      { x: 86, y: 84 },
    ],
    lines: ['M108 96 L92 128', 'M92 128 L78 156', 'M92 128 L118 148', 'M86 84 L108 96', 'M78 156 L118 148'],
  },
};

const map = maps[mapId];
---

<div class="location-map" data-map={mapId}>
  <div class="location-map__glow" aria-hidden="true"></div>
  <div class="location-map__frame">
    <svg class="location-map__svg" viewBox={map.viewBox} role="img" aria-label={`Geographic outline for ${visualLabel}`}>
      <defs>
        <linearGradient id={`loc-map-fill-${mapId}`} x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="rgb(222 243 77 / 0.22)"></stop>
          <stop offset="100%" stop-color="rgb(197 246 61 / 0.06)"></stop>
        </linearGradient>
      </defs>
      <path class="location-map__land" d={map.path} fill={`url(#loc-map-fill-${mapId})`}></path>
      <path class="location-map__stroke" d={map.path} fill="none"></path>
      {
        map.lines.map((d) => (
          <path class="location-map__link" d={d} fill="none" />
        ))
      }
      {
        map.points.map((point, index) => (
          <g class={`location-map__node location-map__node--${index}`}>
            <circle cx={point.x} cy={point.y} r="7" class="location-map__node-ring"></circle>
            <circle cx={point.x} cy={point.y} r="3.2" class="location-map__node-dot"></circle>
          </g>
        ))
      }
    </svg>

    <div class="location-map__chip location-map__chip--seo">
      <span class="location-map__chip-label">SEO</span>
      <span class="location-map__chip-value">Visibility</span>
    </div>
    <div class="location-map__chip location-map__chip--web">
      <span class="location-map__chip-label">Web</span>
      <span class="location-map__chip-value">Performance</span>
    </div>
    <div class="location-map__chip location-map__chip--growth">
      <span class="location-map__chip-label">Growth</span>
      <span class="location-map__chip-value">Qualified leads</span>
    </div>

    <div class="location-map__pin">
      <span class="location-map__pin-dot" aria-hidden="true"></span>
      <span class="location-map__pin-label">{visualLabel}</span>
    </div>
  </div>
</div>

<style>
  .location-map {
    position: relative;
    width: 100%;
    max-width: 26rem;
    min-height: 16.5rem;
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .location-map {
      min-height: 18rem;
    }
  }

  @media (min-width: 960px) {
    .location-map {
      max-width: none;
      min-height: 19.5rem;
      margin-inline: 0;
    }
  }

  .location-map__glow {
    position: absolute;
    inset: 10% 8% 12% 12%;
    border-radius: 2rem;
    background: radial-gradient(circle at 55% 42%, rgb(222 243 77 / 0.16), transparent 64%);
    filter: blur(18px);
  }

  .location-map__frame {
    position: relative;
    overflow: hidden;
    height: 100%;
    min-height: inherit;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.6rem;
    background:
      linear-gradient(165deg, rgb(18 24 17 / 0.96), rgb(13 18 12 / 0.92)),
      radial-gradient(circle at 70% 30%, rgb(222 243 77 / 0.08), transparent 55%);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.35);
  }

  .location-map__svg {
    position: absolute;
    inset: 8% 10% 18% 10%;
    width: auto;
    height: auto;
    margin: auto;
    max-width: 78%;
    max-height: 72%;
  }

  .location-map__stroke {
    stroke: rgb(222 243 77 / 0.55);
    stroke-width: 1.6;
  }

  .location-map__link {
    stroke: rgb(222 243 77 / 0.28);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }

  .location-map__node-ring {
    fill: rgb(222 243 77 / 0.08);
    stroke: rgb(222 243 77 / 0.35);
    stroke-width: 1;
  }

  .location-map__node-dot {
    fill: #def34d;
  }

  .location-map__chip {
    position: absolute;
    z-index: 2;
    display: grid;
    gap: 0.1rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 0.9rem;
    background: rgb(13 18 12 / 0.86);
    padding: 0.55rem 0.7rem;
    backdrop-filter: blur(8px);
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .location-map__chip:hover {
    border-color: rgb(222 243 77 / 0.4);
  }

  .location-map__chip-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #def34d;
  }

  .location-map__chip-value {
    font-size: 0.78rem;
    font-weight: 600;
    color: rgb(255 255 255 / 0.88);
  }

  .location-map__chip--seo {
    top: 10%;
    left: 6%;
  }

  .location-map__chip--web {
    top: 18%;
    right: 5%;
  }

  .location-map__chip--growth {
    bottom: 22%;
    left: 8%;
  }

  .location-map__pin {
    position: absolute;
    z-index: 3;
    right: 7%;
    bottom: 9%;
    display: inline-flex;
    max-width: calc(100% - 2rem);
    align-items: center;
    gap: 0.45rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 9999px;
    background: rgb(13 18 12 / 0.9);
    padding: 0.45rem 0.8rem;
    backdrop-filter: blur(8px);
  }

  .location-map__pin-dot {
    height: 0.45rem;
    width: 0.45rem;
    flex-shrink: 0;
    border-radius: 9999px;
    background: #def34d;
    box-shadow: 0 0 12px rgb(222 243 77 / 0.55);
  }

  .location-map__pin-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.78);
  }

  @media (prefers-reduced-motion: no-preference) {
    .location-map__chip--seo {
      animation: location-map-float-a 8s ease-in-out infinite;
    }

    .location-map__chip--web {
      animation: location-map-float-b 9s ease-in-out infinite;
    }

    .location-map__chip--growth {
      animation: location-map-float-c 7.5s ease-in-out infinite;
    }

    .location-map__node--0,
    .location-map__node--2,
    .location-map__node--4 {
      animation: location-map-pulse 3.2s ease-in-out infinite;
    }

    .location-map__node--1,
    .location-map__node--3 {
      animation: location-map-pulse 3.2s ease-in-out infinite 0.6s;
    }
  }

  @keyframes location-map-float-a {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -6px, 0);
    }
  }

  @keyframes location-map-float-b {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, 8px, 0);
    }
  }

  @keyframes location-map-float-c {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -5px, 0);
    }
  }

  @keyframes location-map-pulse {
    0%,
    100% {
      opacity: 0.75;
    }
    50% {
      opacity: 1;
    }
  }
</style>
