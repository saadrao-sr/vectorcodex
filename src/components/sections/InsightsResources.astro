---
import { ArrowUpRight } from 'lucide-react';
import { blogPlaceholders } from '../../config/blog-placeholders';
import { formatDate } from '../../lib/seo/format';
import { getPostsPage } from '../../lib/wordpress/client';
import InsightsCarousel from '../interactive/InsightsCarousel';
import Container from '../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../ui/styles';

const result = await getPostsPage(1, 6);
const livePosts = result.ok ? result.posts.slice(0, 6) : [];
const usingPlaceholders = livePosts.length === 0;
const posts = usingPlaceholders ? blogPlaceholders.slice(0, 6) : livePosts;

const slides = posts.map((post) => ({
  id: post.id,
  slug: post.slug,
  title: post.title,
  excerpt: post.excerpt,
  publishedAt: post.publishedAt,
  publishedLabel: formatDate(post.publishedAt),
  category: post.categories[0]?.name,
  image: post.image
    ? {
        src: post.image.src,
        alt: post.image.alt,
        width: post.image.width,
        height: post.image.height,
      }
    : undefined,
  href: usingPlaceholders ? undefined : `/blog/${post.slug}/`,
}));
---

<section
  id="insights"
  class="relative isolate overflow-hidden border-t border-white/10 bg-bg py-8 sm:py-10 lg:py-12"
  aria-labelledby="insights-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute top-16 right-[14%] h-48 w-48 rounded-full bg-[radial-gradient(circle,rgb(222_243_77_/0.08),transparent_70%)] blur-2xl"></div>
    <div class="absolute bottom-10 left-[8%] h-40 w-40 rounded-full bg-[radial-gradient(circle,rgb(197_246_61_/0.05),transparent_70%)] blur-2xl"></div>
  </div>

  <Container class="relative">
    <div class="grid gap-4 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-end lg:gap-8">
      <div>
        <p class={eyebrowClass}>Insights & Resources</p>
        <h2
          id="insights-heading"
          class="mt-2.5 font-display text-[1.75rem] font-semibold tracking-tight text-balance sm:text-3xl lg:text-[2.35rem]"
        >
          <span class="text-white">Insights That Move Your </span>
          <span class="text-highlight">Business Forward</span>
        </h2>
      </div>
      <div class="lg:pb-0.5">
        <p class="text-sm leading-6 text-white/65 sm:text-base sm:leading-7">
          Explore practical insights, expert advice, and the latest trends in SEO, web development, and digital marketing.
        </p>
      </div>
    </div>

    {
      usingPlaceholders && (
        <p class="mt-4 text-xs leading-5 text-white/45 sm:mt-5" role="status">
          Placeholder articles for layout preview — published WordPress posts will replace these automatically.
        </p>
      )
    }

    <InsightsCarousel client:visible items={slides} />

    <div class="mt-6 flex justify-center sm:mt-7">
      <a
        href="/blog/"
        class:list={[
          buttonClass.base,
          buttonClass.gradient,
          'group w-full shadow-[0_12px_40px_rgb(197_246_61_/0.16)] sm:w-auto',
        ]}
      >
        Explore All Insights
        <ArrowUpRight
          size={16}
          aria-hidden="true"
          className="transition duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </div>
  </Container>
</section>
