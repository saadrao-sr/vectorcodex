---
import { ArrowUpRight } from 'lucide-react';
import type { Crumb } from '../../types/content';
import BlogSearch, { type BlogSearchItem } from '../interactive/BlogSearch';
import Container from '../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../ui/styles';

interface Props {
  crumbs: Crumb[];
  page?: number;
  posts?: BlogSearchItem[];
  placeholderPosts?: boolean;
}

const { crumbs, page = 1, posts = [], placeholderPosts = false } = Astro.props;
const pageLabel = page > 1 ? `Insights · Page ${page}` : 'Insights';
---

<section
  id="blog-hero"
  class="blog-hero relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] pt-6 pb-8 sm:pt-7 sm:pb-9 lg:pt-8 lg:pb-10"
  aria-labelledby="blog-hero-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute top-10 left-[8%] h-56 w-56 rounded-full bg-[radial-gradient(circle,rgb(222_243_77_/0.1),transparent_70%)] blur-3xl"
    >
    </div>
    <div
      class="absolute right-[5%] bottom-12 h-64 w-64 rounded-full bg-[radial-gradient(circle,rgb(197_246_61_/0.07),transparent_70%)] blur-3xl"
    >
    </div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-highlight/30 to-transparent"></div>
  </div>

  <Container class="relative">
    <nav class="blog-hero__crumbband" aria-label="Breadcrumb">
      <div class="blog-hero__crumbband-bg" aria-hidden="true">
        <img
          src="/images/hero-tech.jpg"
          alt=""
          width={1200}
          height={400}
          loading="eager"
          decoding="async"
          class="blog-hero__crumbband-image"
        />
        <div class="blog-hero__crumbband-veil"></div>
        <div class="blog-hero__crumbband-glow"></div>
      </div>

      <div class="blog-hero__crumbband-content">
        <div class="blog-hero__crumbband-rule" aria-hidden="true">
          <span class="blog-hero__crumbband-line"></span>
          <span class="blog-hero__crumbband-mark"></span>
          <span class="blog-hero__crumbband-line"></span>
        </div>

        <p class="blog-hero__crumbband-title">{pageLabel}</p>

        <ol class="blog-hero__crumbband-trail">
          {
            crumbs.map((item, index) => {
              const last = index === crumbs.length - 1;
              return (
                <li class="inline-flex items-center gap-2">
                  {index > 0 && <span aria-hidden="true" class="text-white/30">/</span>}
                  {last ? (
                    <span aria-current="page" class="text-highlight">
                      {item.name}
                    </span>
                  ) : (
                    <a href={item.href} class="transition hover:text-highlight">
                      {item.name}
                    </a>
                  )}
                </li>
              );
            })
          }
        </ol>
      </div>
    </nav>

    <div class="blog-hero__copy mx-auto mt-5 max-w-3xl text-center sm:mt-6">
      <p class:list={[eyebrowClass, 'blog-hero__eyebrow mx-auto w-fit max-w-full']}>
        Knowledge That Drives Growth
      </p>

      <h1
        id="blog-hero-heading"
        class="blog-hero__title mt-3 font-display text-[1.65rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-3xl sm:leading-[1.08] md:text-[2.1rem] lg:text-[2.45rem] lg:leading-[1.05]"
      >
        Insights for Smarter
        <span class="text-highlight"> Digital Decisions.</span>
      </h1>

      <p
        class="blog-hero__lede mx-auto mt-3 max-w-2xl text-sm leading-6 text-white/65 sm:mt-3.5 sm:text-[0.95rem] sm:leading-7"
      >
        Practical perspectives on SEO, web development, and digital marketing — written to help businesses understand
        what works, what matters, and how to move forward with clarity.
      </p>

      <div class="blog-hero__actions mt-4 flex justify-center sm:mt-5">
        <button
          type="button"
          class:list={[buttonClass.base, buttonClass.ghost, 'w-full sm:w-auto']}
          data-quote-open
        >
          Discuss Your Project
          <ArrowUpRight size={16} aria-hidden="true" />
        </button>
      </div>
    </div>

    <BlogSearch client:load posts={posts} placeholders={placeholderPosts} />
  </Container>
</section>

<style>
  .blog-hero__crumbband {
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.25rem;
    min-height: 5.25rem;
  }

  @media (min-width: 640px) {
    .blog-hero__crumbband {
      min-height: 5.75rem;
      border-radius: 1.4rem;
    }
  }

  .blog-hero__crumbband-bg {
    position: absolute;
    inset: 0;
  }

  .blog-hero__crumbband-image {
    height: 100%;
    width: 100%;
    object-fit: cover;
    opacity: 0.38;
    filter: saturate(0.65) brightness(0.72);
  }

  .blog-hero__crumbband-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, rgb(13 18 12 / 0.92), rgb(13 18 12 / 0.72) 55%, rgb(13 18 12 / 0.88)),
      radial-gradient(circle at 78% 30%, rgb(222 243 77 / 0.18), transparent 48%);
  }

  .blog-hero__crumbband-glow {
    position: absolute;
    inset: auto -10% -40% 40%;
    height: 10rem;
    border-radius: 9999px;
    background: radial-gradient(circle, rgb(222 243 77 / 0.16), transparent 70%);
    filter: blur(20px);
  }

  .blog-hero__crumbband-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    text-align: center;
  }

  @media (min-width: 640px) {
    .blog-hero__crumbband-content {
      padding: 1rem 1.25rem;
      gap: 0.4rem;
    }
  }

  .blog-hero__crumbband-rule {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: min(100%, 14rem);
  }

  .blog-hero__crumbband-line {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.28), transparent);
  }

  .blog-hero__crumbband-mark {
    height: 0.4rem;
    width: 0.4rem;
    border-radius: 9999px;
    background: #def34d;
    box-shadow: 0 0 12px rgb(222 243 77 / 0.55);
  }

  .blog-hero__crumbband-title {
    font-family: var(--font-display, inherit);
    font-size: clamp(1.35rem, 2.8vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: #fff;
  }

  .blog-hero__crumbband-trail {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: rgb(255 255 255 / 0.55);
  }

  @media (prefers-reduced-motion: no-preference) {
    .blog-hero__eyebrow,
    .blog-hero__title,
    .blog-hero__lede,
    .blog-hero__actions {
      opacity: 0;
      transform: translateY(14px);
      animation: blog-hero-rise 0.7s ease forwards;
    }

    .blog-hero__eyebrow {
      animation-delay: 40ms;
    }

    .blog-hero__title {
      animation-delay: 100ms;
    }

    .blog-hero__lede {
      animation-delay: 160ms;
    }

    .blog-hero__actions {
      animation-delay: 220ms;
    }
  }

  @keyframes blog-hero-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
