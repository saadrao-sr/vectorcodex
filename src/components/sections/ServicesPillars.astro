---
import { ArrowUpRight, Code2, Megaphone, Search, Share2, type LucideIcon } from 'lucide-react';
import { servicePillars, type ServicePillarIcon } from '../../config/services-page';
import AmbientBackdrop from '../ui/AmbientBackdrop.astro';
import Container from '../ui/Container.astro';
import { eyebrowClass } from '../ui/styles';

const icons: Record<ServicePillarIcon, LucideIcon> = {
  search: Search,
  code: Code2,
  share: Share2,
  megaphone: Megaphone,
};
---

<section
  id="service-pillars"
  class="services-pillars relative isolate scroll-mt-28 overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="service-pillars-heading"
>
  <AmbientBackdrop variant="orbs" />

  <Container class="relative">
    <header class="mx-auto max-w-3xl text-center">
      <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>Service Pillars</p>
      <h2
        id="service-pillars-heading"
        class="mt-3 font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.25rem] lg:text-[2.55rem] lg:leading-[1.06]"
      >
        Practices Built as
        <span class="text-highlight"> One Growth System.</span>
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-8">
        Explore the parent services that shape how VectorCodex plans search, builds websites, and runs social and paid programmes.
      </p>
    </header>

    <ul class="services-pillars__bento">
      {
        servicePillars.map((pillar, index) => {
          const Icon = icons[pillar.icon];
          return (
            <li
              class:list={[
                'services-pillars__tile',
                `services-pillars__tile--${pillar.id}`,
                pillar.featured && 'services-pillars__tile--featured',
                pillar.span === 'wide' ? 'services-pillars__tile--wide' : 'services-pillars__tile--narrow',
              ]}
              style={`--pillar-i: ${index}`}
            >
              <article class="services-pillars__card group">
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-br from-highlight/12 via-transparent to-transparent opacity-80 transition duration-300 group-hover:opacity-100"
                  aria-hidden="true"
                />
                <div class="relative flex h-full flex-col">
                  <div class="flex items-start justify-between gap-3">
                    <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-highlight/30 bg-highlight/10 text-highlight">
                      <Icon size={20} aria-hidden="true" />
                    </span>
                    <span class="font-display text-sm font-semibold tracking-[0.14em] text-highlight/80">
                      {pillar.number}
                    </span>
                  </div>

                  <h3 class="mt-4 font-display text-xl font-semibold tracking-tight text-white sm:text-2xl">
                    {pillar.title}
                  </h3>
                  <p class="mt-2 flex-1 text-sm leading-6 text-white/60 sm:text-[0.95rem] sm:leading-7">
                    {pillar.description}
                  </p>

                  <ul class="mt-4 flex flex-wrap gap-2">
                    {pillar.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class="inline-flex rounded-full border border-white/12 bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-white/70 transition hover:border-highlight/50 hover:bg-highlight/10 hover:text-highlight"
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>

                  <a
                    href={pillar.href}
                    class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-highlight transition group-hover:gap-2.5"
                  >
                    Explore Service
                    <ArrowUpRight size={16} aria-hidden="true" />
                  </a>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </Container>
</section>

<style>
  .services-pillars__bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .services-pillars__bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .services-pillars__bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 1.05rem;
    }

    .services-pillars__tile--seo {
      grid-column: span 7;
    }

    .services-pillars__tile--web {
      grid-column: span 5;
    }

    .services-pillars__tile--social {
      grid-column: span 5;
    }

    .services-pillars__tile--ppc {
      grid-column: span 7;
    }
  }

  .services-pillars__card {
    position: relative;
    display: flex;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.5rem;
    background: rgb(255 255 255 / 0.03);
    padding: 1.2rem 1.15rem 1.25rem;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  @media (min-width: 640px) {
    .services-pillars__card {
      padding: 1.4rem 1.35rem 1.45rem;
    }
  }

  .services-pillars__tile--featured .services-pillars__card {
    border-color: rgb(222 243 77 / 0.28);
    background:
      radial-gradient(circle at 90% 10%, rgb(222 243 77 / 0.1), transparent 45%),
      rgb(255 255 255 / 0.03);
  }

  .services-pillars__card:hover {
    border-color: rgb(222 243 77 / 0.4);
    background: rgb(255 255 255 / 0.05);
  }

  @media (prefers-reduced-motion: no-preference) {
    .services-pillars__tile {
      opacity: 0;
      transform: translateY(16px);
      animation: services-pillars-rise 0.65s ease forwards;
      animation-delay: calc(120ms + var(--pillar-i, 0) * 70ms);
    }

    .services-pillars__card:hover {
      transform: translateY(-2px);
    }
  }

  @keyframes services-pillars-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
