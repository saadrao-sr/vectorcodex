---
import {
  Building2,
  Calculator,
  CloudFog,
  HeartPulse,
  Plane,
  type LucideIcon,
} from 'lucide-react';
import { industries } from '../../config/industries';
import Container from '../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../ui/styles';

const icons: Record<string, LucideIcon> = {
  healthcare: HeartPulse,
  accounting: Calculator,
  tourism: Plane,
  tobacco: CloudFog,
  'real-estate': Building2,
};

const accents = [
  'from-highlight/20 via-transparent to-transparent',
  'from-lime/16 via-transparent to-transparent',
  'from-gold/16 via-transparent to-transparent',
  'from-highlight/14 via-transparent to-transparent',
];

const previewIndustries = industries.slice(0, 4).map((industry, index) => ({
  title: industry.name,
  text: industry.hero.intro,
  href: industry.path,
  Icon: icons[industry.slug] ?? Building2,
  accent: accents[index] ?? accents[0]!,
}));
---

<section id="industries" class="relative isolate overflow-hidden border-t border-white/10 bg-bg py-12 sm:py-14 lg:py-16" aria-labelledby="industries-heading">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <img
      src="/images/hero-tech.jpg"
      alt=""
      width={1920}
      height={1080}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full scale-105 object-cover object-center opacity-35"
    />
    <div class="absolute inset-0 bg-[#0D120C]/72"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgb(222_243_77_/0.12),transparent_55%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(160deg,rgb(197_246_61_/0.07),transparent_42%,rgb(246_239_92_/0.05)_78%,rgb(13_18_12_/0.55))]"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-highlight/35 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-bg to-transparent"></div>
  </div>

  <Container class="relative">
    <div class="mx-auto max-w-3xl text-center">
      <p class={eyebrowClass}>Industries We Serve</p>
      <h2
        id="industries-heading"
        class="mt-3 font-display text-3xl font-semibold tracking-tight text-balance sm:text-4xl lg:text-[2.75rem]"
      >
        <span class="text-white">Digital Solutions for </span>
        <span class="text-highlight">Every Industry</span>
      </h2>
      <p class="mt-3 text-base leading-7 text-white/65 sm:text-lg sm:leading-8">
        We understand that every industry has unique challenges. We adapt our digital, development, and marketing strategies to meet the needs of different businesses.
      </p>
    </div>

    <ul class="mt-8 grid auto-rows-fr grid-cols-1 gap-4 sm:mt-10 sm:grid-cols-2 lg:gap-5">
      {
        previewIndustries.map((industry) => {
          const Icon = industry.Icon;
          return (
            <li class="min-h-0">
              <a
                href={industry.href}
                class="group relative flex h-full min-h-[12rem] flex-col overflow-hidden rounded-[1.75rem] border border-white/10 bg-white/[0.03] p-5 transition duration-300 hover:border-highlight/45 hover:bg-white/[0.05] sm:p-5"
              >
                <div
                  class:list={[
                    'pointer-events-none absolute inset-0 bg-gradient-to-br opacity-90 transition duration-300 group-hover:opacity-100',
                    industry.accent,
                  ]}
                  aria-hidden="true"
                />
                <div
                  class="pointer-events-none absolute -top-14 -right-12 h-32 w-32 rounded-full bg-highlight/10 blur-3xl transition duration-500 group-hover:bg-highlight/18"
                  aria-hidden="true"
                />

                <div class="relative">
                  <div class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-highlight/25 bg-highlight/10 text-highlight shadow-[0_0_30px_rgb(222_243_77_/0.12)] transition duration-300 group-hover:border-highlight/50 group-hover:shadow-[0_0_40px_rgb(222_243_77_/0.2)]">
                    <Icon size={20} aria-hidden="true" />
                  </div>
                  <div class="relative mt-5">
                    <h3 class="font-display text-xl font-semibold tracking-tight text-white group-hover:text-highlight">{industry.title}</h3>
                    <p class="mt-2 line-clamp-3 text-sm leading-6 text-white/65">{industry.text}</p>
                  </div>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="mt-8 flex justify-center sm:mt-10">
      <a href="/industries/" class:list={[buttonClass.base, buttonClass.ghost, 'min-w-[14rem]']}>
        More industries
      </a>
    </div>
  </Container>
</section>
