---
import {
  Code2,
  Search,
  Share2,
  Target,
  type LucideIcon,
} from 'lucide-react';
import { publishedChildren, type PublishedChildLink } from '../../config/published-service-children';
import Container from '../ui/Container.astro';
import { eyebrowClass } from '../ui/styles';

type Expertise = {
  number: string;
  title: string;
  href: string;
  text: string;
  skills: readonly PublishedChildLink[];
  Icon: LucideIcon;
};

const areas: Expertise[] = [
  {
    number: '01',
    title: 'SEO Services',
    href: '/services/seo/',
    text: 'Visibility systems that help the right audiences find and trust your brand.',
    skills: publishedChildren('seo'),
    Icon: Search,
  },
  {
    number: '02',
    title: 'Web Development',
    href: '/services/web-development/',
    text: 'High-performing digital experiences built for clarity, speed, and conversion.',
    skills: publishedChildren('web'),
    Icon: Code2,
  },
  {
    number: '03',
    title: 'Social Media Marketing',
    href: '/services/social-media-marketing/',
    text: 'Strategy and storytelling that grow audiences and strengthen brand presence.',
    skills: publishedChildren('social'),
    Icon: Share2,
  },
  {
    number: '04',
    title: 'PPC Management',
    href: '/services/ppc-management/',
    text: 'Paid media focused on qualified demand, measurement, and efficient spend.',
    skills: publishedChildren('ppc'),
    Icon: Target,
  },
];
---

<section
  id="our-expertise"
  class="about-expertise relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-8 sm:py-10 lg:py-11"
  aria-labelledby="our-expertise-heading"
  data-about-expertise
>
  <div class="about-expertise__bg pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute top-16 left-[8%] h-52 w-52 rounded-full bg-[radial-gradient(circle,rgb(222_243_77_/0.07),transparent_70%)] blur-3xl"></div>
    <div class="absolute right-[10%] bottom-12 h-56 w-56 rounded-full bg-[radial-gradient(circle,rgb(197_246_61_/0.05),transparent_70%)] blur-3xl"></div>
    <span class="about-expertise__shape about-expertise__shape--ring"></span>
    <span class="about-expertise__shape about-expertise__shape--orb"></span>
    <span class="about-expertise__shape about-expertise__shape--square"></span>
    <span class="about-expertise__shape about-expertise__shape--line"></span>
    <span class="about-expertise__shape about-expertise__shape--dot"></span>
  </div>

  <Container class="relative">
    <header class="about-expertise__intro mx-auto max-w-3xl text-center">
      <p class:list={[eyebrowClass, 'w-fit max-w-full']}>Where Strategy Meets Execution</p>
      <h2
        id="our-expertise-heading"
        class="mt-3 font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-3xl md:text-[2.15rem] lg:text-[2.5rem] lg:leading-[1.08]"
      >
        Expertise That Connects Every Part of
        <span class="text-highlight"> Digital Growth.</span>
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-7">
        From building powerful digital experiences to improving search visibility and driving targeted traffic, we bring the right skills, technology, and strategic thinking together to help businesses move forward.
      </p>
    </header>

    <div class="about-expertise__ecosystem relative mt-8 sm:mt-9 lg:mt-10">
      <svg class="about-expertise__lines" viewBox="0 0 1000 640" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <path class="about-expertise__line" data-line="0" d="M500 320 L200 140"></path>
        <path class="about-expertise__line" data-line="1" d="M500 320 L800 140"></path>
        <path class="about-expertise__line" data-line="2" d="M500 320 L200 500"></path>
        <path class="about-expertise__line" data-line="3" d="M500 320 L800 500"></path>
      </svg>

      <div class="about-expertise__hub" aria-hidden="true">
        <span class="about-expertise__hub-ring"></span>
        <span class="about-expertise__hub-core">
          <span class="about-expertise__hub-label">VectorCodex</span>
          <span class="about-expertise__hub-sub">Digital Growth</span>
        </span>
      </div>

      <ul class="about-expertise__nodes">
        {
          areas.map((area, index) => {
            const Icon = area.Icon;
            return (
              <li class={`about-expertise__node about-expertise__node--${index}`} style={`--node-i: ${index}`}>
                <article
                  class="about-expertise__card group"
                  data-expertise-node={String(index)}
                >
                  <div class="flex items-start justify-between gap-3">
                    <span class="font-display text-[0.7rem] font-semibold tracking-[0.16em] text-highlight uppercase">
                      {area.number}
                    </span>
                    <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-highlight/25 bg-highlight/10 text-highlight transition duration-300 group-hover:border-highlight/45 group-hover:shadow-[0_0_24px_rgb(222_243_77_/0.18)]">
                      <Icon size={16} aria-hidden="true" />
                    </span>
                  </div>
                  <h3 class="mt-3 font-display text-base font-semibold tracking-tight sm:text-lg">
                    <a
                      href={area.href}
                      class="text-white transition-colors duration-200 hover:text-highlight focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-highlight"
                    >
                      {area.title}
                    </a>
                  </h3>
                  <p class="mt-1.5 flex-1 text-sm leading-6 text-white/60">{area.text}</p>
                  {
                    area.skills.length > 0 ? (
                      <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={`${area.title} specialised services`}>
                        {area.skills.map((skill) => (
                          <li>
                            <a
                              href={skill.href}
                              class="inline-flex rounded-full border border-highlight/30 bg-highlight/10 px-2.5 py-1 text-[0.65rem] tracking-wide text-highlight transition hover:border-highlight/55 hover:bg-highlight/15 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-highlight"
                            >
                              {skill.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <div class="mt-4 min-h-[1.75rem]" aria-hidden="true" />
                    )
                  }
                </article>
              </li>
            );
          })
        }
      </ul>
    </div>

    <p class="about-expertise__closer mt-8 text-center font-display text-sm font-semibold tracking-tight text-white sm:mt-9 sm:text-base">
      One Connected Team. Multiple Areas of Expertise.
      <span class="text-highlight"> A Shared Focus on Growth.</span>
    </p>
  </Container>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-about-expertise]');
  if (root) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-expertise-node]'));
    const lines = Array.from(root.querySelectorAll<SVGPathElement>('[data-line]'));

    const setActive = (index: string | null) => {
      cards.forEach((card) => {
        const active = index != null && card.dataset.expertiseNode === index;
        card.classList.toggle('is-active', active);
      });
      lines.forEach((line) => {
        line.classList.toggle('is-active', index != null && line.dataset.line === index);
      });
      root.classList.toggle('has-active', index != null);
    };

    cards.forEach((card) => {
      card.addEventListener('mouseenter', () => setActive(card.dataset.expertiseNode ?? null));
      card.addEventListener('focusin', () => setActive(card.dataset.expertiseNode ?? null));
    });

    root.addEventListener('mouseleave', () => setActive(null));
    root.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (!next || !root.contains(next)) setActive(null);
    });
  }
</script>

<style>
  .about-expertise__shape {
    position: absolute;
    opacity: 0.2;
    will-change: transform;
  }

  .about-expertise__shape--ring {
    top: 10%;
    right: 5%;
    width: 6rem;
    height: 6rem;
    border: 1.5px solid rgb(222 243 77 / 0.48);
    border-radius: 9999px;
  }

  .about-expertise__shape--orb {
    bottom: 16%;
    left: 6%;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 9999px;
    border: 1px solid rgb(222 243 77 / 0.2);
    background: radial-gradient(circle at 35% 30%, rgb(222 243 77 / 0.3), transparent 68%);
  }

  .about-expertise__shape--square {
    --shape-rot: 18deg;
    top: 40%;
    left: 4%;
    width: 2.6rem;
    height: 2.6rem;
    border: 1.5px solid rgb(222 243 77 / 0.4);
    border-radius: 0.55rem;
    transform: rotate(var(--shape-rot));
  }

  .about-expertise__shape--line {
    top: 28%;
    left: 12%;
    width: 4rem;
    height: 1.5px;
    border-radius: 9999px;
    background: linear-gradient(90deg, rgb(222 243 77 / 0.5), transparent);
  }

  .about-expertise__shape--dot {
    bottom: 28%;
    right: 12%;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: #def34d;
    opacity: 0.28;
  }

  @media (max-width: 639px) {
    .about-expertise__shape--ring {
      width: 4.25rem;
      height: 4.25rem;
    }

    .about-expertise__shape--orb {
      width: 3rem;
      height: 3rem;
    }

    .about-expertise__shape--square {
      opacity: 0.14;
    }
  }

  .about-expertise__ecosystem {
    position: relative;
  }

  .about-expertise__lines {
    display: none;
  }

  .about-expertise__hub {
    display: none;
  }

  .about-expertise__nodes {
    display: grid;
    gap: 0.85rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .about-expertise__card {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 11.5rem;
    flex-direction: column;
    text-align: left;
    border-radius: 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(255 255 255 / 0.03);
    padding: 1.15rem 1.15rem 1.2rem;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .about-expertise__card:hover,
  .about-expertise__card.is-active {
    border-color: rgb(222 243 77 / 0.42);
    background: rgb(255 255 255 / 0.05);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.28);
  }

  .about-expertise__closer {
    position: relative;
    display: block;
    width: 100%;
    padding-bottom: 0.35rem;
  }

  .about-expertise__closer::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 4.25rem;
    height: 2px;
    border-radius: 9999px;
    background: linear-gradient(90deg, #def34d, transparent);
    transform: translateX(-50%);
  }

  @media (min-width: 768px) {
    .about-expertise__nodes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      align-items: stretch;
    }

    .about-expertise__node {
      height: 100%;
    }
  }

  @media (min-width: 1024px) {
    .about-expertise__ecosystem {
      min-height: 36rem;
      padding: 0.75rem 0;
    }

    .about-expertise__lines {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
    }

    .about-expertise__line {
      fill: none;
      stroke: rgb(222 243 77 / 0.18);
      stroke-width: 1.5;
      stroke-linecap: round;
      transition:
        stroke 0.25s ease,
        stroke-width 0.25s ease,
        opacity 0.25s ease;
    }

    .about-expertise.has-active .about-expertise__line {
      opacity: 0.28;
    }

    .about-expertise__line.is-active {
      opacity: 1;
      stroke: rgb(222 243 77 / 0.72);
      stroke-width: 2.25;
      filter: drop-shadow(0 0 8px rgb(222 243 77 / 0.35));
    }

    .about-expertise__hub {
      display: grid;
      place-items: center;
      position: absolute;
      top: 46%;
      left: 50%;
      z-index: 1;
      width: 11.5rem;
      height: 11.5rem;
      translate: -50% -50%;
    }

    .about-expertise__hub-ring {
      position: absolute;
      inset: 0;
      border-radius: 9999px;
      border: 1px dashed rgb(222 243 77 / 0.28);
      background: radial-gradient(circle, rgb(222 243 77 / 0.1), transparent 68%);
      box-shadow: 0 0 50px rgb(222 243 77 / 0.08);
    }

    .about-expertise__hub-core {
      position: relative;
      display: grid;
      place-items: center;
      width: 8.25rem;
      height: 8.25rem;
      border-radius: 9999px;
      border: 1px solid rgb(222 243 77 / 0.35);
      background: rgb(13 18 12 / 0.92);
      text-align: center;
      padding: 0.75rem;
    }

    .about-expertise__hub-label {
      font-family: var(--font-display);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #def34d;
    }

    .about-expertise__hub-sub {
      margin-top: 0.2rem;
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgb(255 255 255 / 0.55);
    }

    .about-expertise__nodes {
      display: block;
      position: relative;
      z-index: 2;
      min-height: 36rem;
    }

    .about-expertise__node {
      position: absolute;
      width: min(20rem, 34%);
      height: auto;
    }

    .about-expertise__node--0 {
      top: 0;
      left: 0;
    }

    .about-expertise__node--1 {
      top: 0;
      right: 0;
    }

    .about-expertise__node--2 {
      bottom: 0;
      left: 0;
      top: auto;
    }

    .about-expertise__node--3 {
      bottom: 0;
      right: 0;
      top: auto;
    }

    .about-expertise__card {
      min-height: 13.5rem;
      backdrop-filter: blur(6px);
    }

    .about-expertise__card:hover,
    .about-expertise__card.is-active {
      transform: translateY(-3px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .about-expertise__intro,
    .about-expertise__node,
    .about-expertise__closer {
      opacity: 0;
      transform: translateY(16px);
      animation: about-expertise-rise 0.7s ease forwards;
    }

    .about-expertise__intro {
      animation-delay: 40ms;
    }

    .about-expertise__node {
      animation-delay: calc(100ms + var(--node-i, 0) * 70ms);
    }

    .about-expertise__closer {
      animation-delay: 420ms;
    }

    .about-expertise__hub-ring {
      animation: about-expertise-spin 40s linear infinite;
    }

    .about-expertise__shape--ring {
      animation: about-expertise-drift-a 17s ease-in-out infinite;
    }

    .about-expertise__shape--orb {
      animation: about-expertise-drift-b 19s ease-in-out infinite;
    }

    .about-expertise__shape--square {
      animation: about-expertise-drift-c 15s ease-in-out infinite;
    }

    .about-expertise__shape--line {
      animation: about-expertise-drift-a 21s ease-in-out infinite reverse;
    }

    .about-expertise__shape--dot {
      animation: about-expertise-drift-b 13s ease-in-out infinite;
    }
  }

  @keyframes about-expertise-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes about-expertise-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes about-expertise-drift-a {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(12px, -14px, 0);
    }
  }

  @keyframes about-expertise-drift-b {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-12px, 10px, 0);
    }
  }

  @keyframes about-expertise-drift-c {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(var(--shape-rot, 0deg));
    }
    50% {
      transform: translate3d(8px, -10px, 0) rotate(calc(var(--shape-rot, 0deg) + 8deg));
    }
  }
</style>
