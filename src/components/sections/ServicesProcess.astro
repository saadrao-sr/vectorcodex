---
import { Compass, LineChart, Rocket, Sparkles, type LucideIcon } from 'lucide-react';
import { servicesProcessIntro, servicesProcessSteps } from '../../config/services-page';
import AmbientBackdrop from '../ui/AmbientBackdrop.astro';
import Container from '../ui/Container.astro';
import { eyebrowClass } from '../ui/styles';

const intro = servicesProcessIntro;
const stepIcons: LucideIcon[] = [Compass, LineChart, Rocket, Sparkles];
---

<section
  id="services-process"
  class="services-process relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="services-process-heading"
>
  <AmbientBackdrop variant="mesh" />

  <Container class="relative">
    <header class="mx-auto max-w-3xl text-center">
      <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{intro.eyebrow}</p>
      <h2
        id="services-process-heading"
        class="mt-3 font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.25rem] lg:text-[2.55rem] lg:leading-[1.06]"
      >
        {intro.titleBefore}
        <span class="text-highlight"> {intro.titleHighlight}</span>
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-8">
        {intro.text}
      </p>
    </header>

    <div class="services-process__path" aria-hidden="true">
      <span class="services-process__path-label">Brief</span>
      <div class="services-process__path-track">
        <span class="services-process__path-fill"></span>
        <span class="services-process__path-dot"></span>
      </div>
      <span class="services-process__path-label">Growth</span>
    </div>

    <ol class="services-process__rail">
      <div class="services-process__spine" aria-hidden="true">
        <span class="services-process__spine-line"></span>
      </div>

      {
        servicesProcessSteps.map((step, index) => {
          const Icon = stepIcons[index] ?? Compass;
          return (
            <li class="services-process__station" style={`--step-i: ${index}`}>
              <div class="services-process__beacon" aria-hidden="true">
                <span class="services-process__beacon-ring"></span>
                <span class="services-process__beacon-core">
                  <Icon size={14} />
                </span>
              </div>

              <article class="services-process__card group">
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-br from-highlight/12 via-transparent to-transparent opacity-80 transition duration-300 group-hover:opacity-100"
                  aria-hidden="true"
                />
                <div class="relative">
                  <div class="flex items-start justify-between gap-3">
                    <p class="services-process__index font-display">{step.number}</p>
                    <span class="services-process__chip">Stage {index + 1}</span>
                  </div>
                  <h3 class="mt-3 font-display text-xl font-semibold tracking-tight text-white">
                    {step.title}
                  </h3>
                  <p class="mt-2 text-sm leading-6 text-white/60">{step.text}</p>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>
  </Container>
</section>

<style>
  .services-process__path {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    max-width: 36rem;
    margin: 2.25rem auto 0;
  }

  @media (min-width: 640px) {
    .services-process__path {
      margin-top: 2.75rem;
      max-width: 42rem;
    }
  }

  .services-process__path-label {
    flex-shrink: 0;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.45);
  }

  .services-process__path-track {
    position: relative;
    flex: 1;
    height: 3px;
    overflow: hidden;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.1);
  }

  .services-process__path-fill {
    display: block;
    height: 100%;
    width: 100%;
    transform-origin: left center;
    border-radius: inherit;
    background: linear-gradient(90deg, #def34d, #c5f63d);
    box-shadow: 0 0 16px rgb(222 243 77 / 0.4);
  }

  .services-process__path-dot {
    position: absolute;
    top: 50%;
    left: 72%;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: #def34d;
    box-shadow: 0 0 12px rgb(222 243 77 / 0.7);
    transform: translate(-50%, -50%);
  }

  .services-process__rail {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    width: 100%;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .services-process__rail {
      margin-top: 2rem;
      gap: 1.1rem;
    }
  }

  @media (min-width: 900px) {
    .services-process__rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .services-process__spine {
      display: none;
    }

    .services-process__station {
      grid-template-columns: minmax(0, 1fr);
    }

    .services-process__beacon {
      display: none;
    }
  }

  @media (min-width: 1100px) {
    .services-process__rail {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 2.25rem;
    }
  }

  .services-process__spine {
    position: absolute;
    top: 0.7rem;
    bottom: 0.7rem;
    left: 1.05rem;
    width: 2px;
    pointer-events: none;
  }

  .services-process__spine-line {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: linear-gradient(180deg, rgb(222 243 77 / 0.55), rgb(222 243 77 / 0.1));
  }

  .services-process__station {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    min-width: 0;
  }

  .services-process__beacon {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
  }

  .services-process__beacon-ring {
    position: absolute;
    inset: 0;
    border: 1px solid rgb(222 243 77 / 0.35);
    border-radius: 9999px;
    background: rgb(13 18 12 / 0.92);
  }

  .services-process__beacon-core {
    position: relative;
    display: inline-flex;
    color: #def34d;
  }

  .services-process__card {
    position: relative;
    width: 100%;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.35rem;
    background: rgb(255 255 255 / 0.03);
    padding: 1.15rem 1.15rem 1.2rem;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  @media (min-width: 1100px) {
    .services-process__card {
      padding: 1.25rem 1.2rem 1.3rem;
    }

    .services-process__station:nth-child(odd) .services-process__card {
      border-color: rgb(222 243 77 / 0.22);
    }
  }

  .services-process__card:hover {
    border-color: rgb(222 243 77 / 0.4);
    background: rgb(255 255 255 / 0.05);
  }

  .services-process__index {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    color: rgb(222 243 77 / 0.35);
  }

  .services-process__chip {
    display: inline-flex;
    border: 1px solid rgb(222 243 77 / 0.25);
    border-radius: 9999px;
    background: rgb(222 243 77 / 0.08);
    padding: 0.25rem 0.65rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #def34d;
  }

  @media (prefers-reduced-motion: no-preference) {
    .services-process__station {
      opacity: 0;
      transform: translateY(14px);
      animation: services-process-rise 0.65s ease forwards;
      animation-delay: calc(120ms + var(--step-i, 0) * 80ms);
    }

    .services-process__path-fill {
      animation: services-process-meter 2.2s ease forwards;
    }

    .services-process__path-dot {
      animation: services-process-dot 3.6s ease-in-out infinite;
    }

    .services-process__card:hover {
      transform: translateY(-2px);
    }
  }

  @keyframes services-process-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes services-process-meter {
    from {
      transform: scaleX(0.18);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes services-process-dot {
    0%,
    100% {
      left: 18%;
    }
    50% {
      left: 82%;
    }
  }
</style>
