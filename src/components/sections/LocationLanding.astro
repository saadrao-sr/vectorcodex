---
import { ArrowUpRight, Mail, MapPin, Phone } from 'lucide-react';
import type { LocationOffice } from '../../config/locations';
import Container from '../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../ui/styles';
import LocationAmbientBg from './LocationAmbientBg.astro';

interface Props {
  location: LocationOffice;
}

const { location } = Astro.props;
---

<section
  class="relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="location-contact-heading"
>
  <LocationAmbientBg variant="a" />

  <Container class="relative">
    <header class="mx-auto max-w-3xl text-center">
      <p class:list={[eyebrowClass, 'mx-auto w-fit']}>{location.market}</p>
      <h2
        id="location-contact-heading"
        class="mt-3 font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.25rem] lg:text-[2.45rem] lg:leading-[1.08]"
      >
        Connect With Our
        <span class="text-highlight"> {location.name} </span>
        Presence.
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-8">
        {location.summary}
      </p>
    </header>

    <ul class="mx-auto mt-7 grid max-w-4xl gap-3 sm:mt-8 sm:grid-cols-3 sm:gap-4">
      <li>
        <article
          class="group relative flex h-full flex-col overflow-hidden rounded-[1.35rem] border border-white/12 bg-white/[0.03] p-4 transition duration-300 hover:border-highlight/40 sm:p-5"
        >
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-br from-highlight/12 via-transparent to-transparent opacity-80 transition duration-300 group-hover:opacity-100"
            aria-hidden="true"
          />
          <div class="relative">
            <span
              class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-highlight/30 bg-highlight/10 text-highlight transition duration-300 group-hover:border-highlight/50 group-hover:bg-highlight/15"
            >
              <MapPin size={20} aria-hidden="true" />
            </span>
            <p class="mt-4 text-[0.65rem] font-semibold tracking-[0.14em] text-highlight uppercase">Address</p>
            <p class="mt-2 font-display text-base font-semibold leading-6 tracking-tight text-white sm:text-lg">
              {location.address}
            </p>
          </div>
        </article>
      </li>

      <li>
        <a
          href={`tel:${location.phone.replace(/\s+/g, '')}`}
          class="group relative flex h-full flex-col overflow-hidden rounded-[1.35rem] border border-white/12 bg-white/[0.03] p-4 transition duration-300 hover:border-highlight/40 sm:p-5"
        >
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-br from-highlight/12 via-transparent to-transparent opacity-80 transition duration-300 group-hover:opacity-100"
            aria-hidden="true"
          />
          <div class="relative">
            <span
              class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-highlight/30 bg-highlight/10 text-highlight transition duration-300 group-hover:border-highlight/50 group-hover:bg-highlight/15"
            >
              <Phone size={20} aria-hidden="true" />
            </span>
            <p class="mt-4 text-[0.65rem] font-semibold tracking-[0.14em] text-highlight uppercase">Phone</p>
            <p
              class="mt-2 font-display text-base font-semibold tracking-tight text-white transition group-hover:text-highlight sm:text-lg"
            >
              {location.phone}
            </p>
            <p class="mt-3 text-sm text-white/45 transition group-hover:text-white/60">Tap to call</p>
          </div>
        </a>
      </li>

      <li>
        <a
          href={`mailto:${location.email}`}
          class="group relative flex h-full flex-col overflow-hidden rounded-[1.35rem] border border-white/12 bg-white/[0.03] p-4 transition duration-300 hover:border-highlight/40 sm:p-5"
        >
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-br from-highlight/12 via-transparent to-transparent opacity-80 transition duration-300 group-hover:opacity-100"
            aria-hidden="true"
          />
          <div class="relative">
            <span
              class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-highlight/30 bg-highlight/10 text-highlight transition duration-300 group-hover:border-highlight/50 group-hover:bg-highlight/15"
            >
              <Mail size={20} aria-hidden="true" />
            </span>
            <p class="mt-4 text-[0.65rem] font-semibold tracking-[0.14em] text-highlight uppercase">Email</p>
            <p
              class="mt-2 break-all font-display text-base font-semibold tracking-tight text-white transition group-hover:text-highlight sm:text-lg"
            >
              {location.email}
            </p>
            <p class="mt-3 text-sm text-white/45 transition group-hover:text-white/60">Send a message</p>
          </div>
        </a>
      </li>
    </ul>

    <div class="mx-auto mt-7 max-w-4xl sm:mt-8">
      <article class="rounded-[1.35rem] border border-white/12 bg-white/[0.03] p-4 sm:p-5">
        <p class="text-[0.65rem] font-semibold tracking-[0.14em] text-highlight uppercase">How we help here</p>
        <h2 class="mt-2 font-display text-xl font-semibold text-white">Regional focus areas</h2>
        <ul class="mt-4 grid gap-2.5 sm:grid-cols-3">
          {
            location.focus.map((item) => (
              <li class="rounded-2xl border border-white/10 bg-white/[0.02] px-4 py-3 text-sm text-white/75">{item}</li>
            ))
          }
        </ul>
      </article>
    </div>

    <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:mt-8 sm:flex-row">
      <a
        href="/contact/#contact-form"
        class:list={[buttonClass.base, buttonClass.gradient, 'w-full sm:w-auto']}
      >
        Contact this office
        <ArrowUpRight size={16} aria-hidden="true" />
      </a>
      <a href="/pricing/#pricing-packages" class:list={[buttonClass.base, buttonClass.ghost, 'w-full sm:w-auto']}>
        Calculate project cost
      </a>
    </div>
  </Container>
</section>
