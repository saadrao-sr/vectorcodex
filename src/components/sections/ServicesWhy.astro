---
import {
  LineChart,
  MessageSquare,
  RefreshCw,
  Target,
  Users,
  type LucideIcon,
} from 'lucide-react';
import { servicesWhyIntro, servicesWhyPoints } from '../../config/services-page';
import AmbientBackdrop from '../ui/AmbientBackdrop.astro';
import Container from '../ui/Container.astro';
import { eyebrowClass } from '../ui/styles';

const intro = servicesWhyIntro;

const icons: Record<string, LucideIcon> = {
  integrated: Users,
  tailored: Target,
  data: LineChart,
  transparent: MessageSquare,
  optimize: RefreshCw,
};
---

<section
  id="services-why"
  class="services-why relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="services-why-heading"
>
  <AmbientBackdrop variant="orbs" />

  <Container class="relative">
    <header class="mx-auto max-w-3xl text-center">
      <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{intro.eyebrow}</p>
      <h2
        id="services-why-heading"
        class="mt-3 font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.25rem] lg:text-[2.55rem] lg:leading-[1.06]"
      >
        {intro.titleBefore}
        <span class="text-highlight"> {intro.titleHighlight}</span>
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-8">
        {intro.text}
      </p>
    </header>

    <ul class="services-why__grid">
      {
        servicesWhyPoints.map((point, index) => {
          const Icon = icons[point.id] ?? Target;
          return (
            <li
              class:list={['services-why__item', index === 0 && 'services-why__item--lead']}
              style={`--why-i: ${index}`}
            >
              <article class="services-why__card group">
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-br from-highlight/10 via-transparent to-transparent opacity-80 transition duration-300 group-hover:opacity-100"
                  aria-hidden="true"
                />
                <div class="relative">
                  <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-highlight/30 bg-highlight/10 text-highlight">
                    <Icon size={18} aria-hidden="true" />
                  </span>
                  <h3 class="mt-4 font-display text-lg font-semibold tracking-tight text-white sm:text-xl">
                    {point.title}
                  </h3>
                  <p class="mt-2 text-sm leading-6 text-white/60">{point.text}</p>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </Container>
</section>

<style>
  .services-why__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .services-why__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .services-why__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .services-why__item--lead {
      grid-column: span 6;
    }

    .services-why__item:not(.services-why__item--lead) {
      grid-column: span 3;
    }

    .services-why__item:nth-child(2),
    .services-why__item:nth-child(3) {
      grid-column: span 3;
    }

    .services-why__item:nth-child(4),
    .services-why__item:nth-child(5) {
      grid-column: span 3;
    }
  }

  .services-why__card {
    position: relative;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.35rem;
    background: rgb(255 255 255 / 0.03);
    padding: 1.15rem 1.15rem 1.2rem;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease;
  }

  .services-why__item--lead .services-why__card {
    border-color: rgb(222 243 77 / 0.28);
  }

  .services-why__card:hover {
    border-color: rgb(222 243 77 / 0.4);
    background: rgb(255 255 255 / 0.05);
  }

  @media (prefers-reduced-motion: no-preference) {
    .services-why__item {
      opacity: 0;
      transform: translateY(14px);
      animation: services-why-rise 0.65s ease forwards;
      animation-delay: calc(100ms + var(--why-i, 0) * 60ms);
    }
  }

  @keyframes services-why-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
