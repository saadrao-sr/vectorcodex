---
import {
  ArrowDown,
  ArrowUpRight,
  Building2,
  Calculator,
  Car,
  HeartPulse,
  Plane,
  ShoppingBag,
  type LucideIcon,
} from 'lucide-react';
import Container from '../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../ui/styles';

type Tile = {
  label: string;
  Icon: LucideIcon;
  side: 'left' | 'right';
};

const tiles: Tile[] = [
  { label: 'Healthcare', Icon: HeartPulse, side: 'left' },
  { label: 'Finance', Icon: Calculator, side: 'right' },
  { label: 'Real Estate', Icon: Building2, side: 'left' },
  { label: 'Tourism', Icon: Plane, side: 'right' },
  { label: 'E-commerce', Icon: ShoppingBag, side: 'left' },
  { label: 'Automotive', Icon: Car, side: 'right' },
];

const leftTiles = tiles.filter((tile) => tile.side === 'left');
const rightTiles = tiles.filter((tile) => tile.side === 'right');
---

<section
  id="industries-hero"
  class="industries-hero relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-8 sm:py-10 lg:py-12"
  aria-labelledby="industries-hero-heading"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute top-10 left-[8%] h-56 w-56 rounded-full bg-[radial-gradient(circle,rgb(222_243_77_/0.09),transparent_70%)] blur-3xl"></div>
    <div class="absolute right-[6%] bottom-8 h-64 w-64 rounded-full bg-[radial-gradient(circle,rgb(197_246_61_/0.06),transparent_70%)] blur-3xl"></div>
  </div>

  <Container class="relative">
    <div class="industries-hero__layout">
      <div class="industries-hero__copy">
        <p class:list={[eyebrowClass, 'industries-hero__eyebrow w-fit max-w-full']}>Industries We Empower</p>

        <h1
          id="industries-hero-heading"
          class="industries-hero__title mt-4 max-w-xl font-display text-[1.85rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-4xl sm:leading-[1.08] md:text-[2.35rem] lg:text-[2.85rem] lg:leading-[1.05]"
        >
          Digital Solutions Built Around
          <span class="text-highlight"> Your Industry.</span>
        </h1>

        <p class="industries-hero__lede mt-4 max-w-lg text-sm leading-7 text-white/65 sm:mt-5 sm:text-base sm:leading-7 lg:text-[1.0625rem] lg:leading-8">
          Every industry has its own challenges, customers, and opportunities. At VectorCodex, we combine SEO, web development, and digital marketing expertise to create tailored digital solutions that help businesses stand out and grow.
        </p>

        <div class="industries-hero__actions mt-6 flex flex-col gap-3 sm:mt-7 sm:flex-row sm:flex-wrap">
          <a
            href="#industry-listing"
            class:list={[
              buttonClass.base,
              buttonClass.gradient,
              'w-full shadow-[0_14px_40px_rgb(197_246_61_/0.18)] sm:w-auto',
            ]}
          >
            Explore Our Industries
            <ArrowDown size={16} aria-hidden="true" />
          </a>
          <button
            type="button"
            class:list={[buttonClass.base, buttonClass.ghost, 'w-full sm:w-auto']}
            data-quote-open
          >
            Discuss Your Industry
            <ArrowUpRight size={16} aria-hidden="true" />
          </button>
        </div>

        <p class="industries-hero__note mt-5 text-xs tracking-[0.08em] text-white/45 sm:text-sm">
          One Digital Partner. Multiple Industry Solutions.
        </p>
      </div>

      <div class="industries-hero__visual" aria-hidden="false">
        <div class="industries-hero__ecosystem">
          <div class="industries-hero__rail industries-hero__rail--left">
            {
              leftTiles.map((tile, index) => {
                const Icon = tile.Icon;
                return (
                  <div class={`industries-hero__tile industries-hero__tile--float-${index}`}>
                    <span class="industries-hero__tile-icon">
                      <Icon size={16} aria-hidden="true" />
                    </span>
                    <span class="industries-hero__tile-label">{tile.label}</span>
                  </div>
                );
              })
            }
          </div>

          <div class="industries-hero__core" aria-hidden="true">
            <span class="industries-hero__core-glow"></span>
            <span class="industries-hero__core-ring industries-hero__core-ring--outer"></span>
            <span class="industries-hero__core-ring industries-hero__core-ring--mid"></span>
            <div class="industries-hero__core-badge">
              <span class="industries-hero__core-mark">VC</span>
              <span class="industries-hero__core-name">VectorCodex</span>
              <span class="industries-hero__core-sub">Digital Expertise</span>
            </div>
            <svg class="industries-hero__spokes" viewBox="0 0 160 220" preserveAspectRatio="none">
              <path d="M80 110 L18 28"></path>
              <path d="M80 110 L142 28"></path>
              <path d="M80 110 L12 110"></path>
              <path d="M80 110 L148 110"></path>
              <path d="M80 110 L18 192"></path>
              <path d="M80 110 L142 192"></path>
            </svg>
          </div>

          <div class="industries-hero__rail industries-hero__rail--right">
            {
              rightTiles.map((tile, index) => {
                const Icon = tile.Icon;
                return (
                  <div class={`industries-hero__tile industries-hero__tile--float-${index + 3}`}>
                    <span class="industries-hero__tile-icon">
                      <Icon size={16} aria-hidden="true" />
                    </span>
                    <span class="industries-hero__tile-label">{tile.label}</span>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .industries-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
  }

  .industries-hero__copy {
    min-width: 0;
  }

  @media (max-width: 899px) {
    .industries-hero__copy {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .industries-hero__title,
    .industries-hero__lede {
      margin-inline: auto;
    }

    .industries-hero__actions {
      width: 100%;
      justify-content: center;
    }

    .industries-hero__note {
      max-width: 22rem;
    }
  }

  .industries-hero__visual {
    min-width: 0;
    width: 100%;
  }

  .industries-hero__ecosystem {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    border-radius: 1.5rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    background:
      radial-gradient(ellipse at 50% 50%, rgb(222 243 77 / 0.12), transparent 58%),
      linear-gradient(160deg, rgb(255 255 255 / 0.04), transparent 55%);
    padding: 0.9rem 0.75rem;
    overflow: hidden;
  }

  .industries-hero__rail {
    display: grid;
    gap: 0.65rem;
    min-width: 0;
  }

  .industries-hero__tile {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    border-radius: 1rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    background: rgb(13 18 12 / 0.82);
    padding: 0.7rem 0.75rem;
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.25);
    transition:
      border-color 0.25s ease,
      transform 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .industries-hero__tile:hover {
    border-color: rgb(222 243 77 / 0.48);
    background: rgb(16 22 15 / 0.95);
    box-shadow: 0 16px 36px rgb(0 0 0 / 0.32);
    transform: translateY(-2px);
  }

  .industries-hero__tile-icon {
    display: inline-flex;
    height: 1.9rem;
    width: 1.9rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.65rem;
    border: 1px solid rgb(222 243 77 / 0.3);
    background: rgb(222 243 77 / 0.1);
    color: #def34d;
  }

  .industries-hero__tile-label {
    min-width: 0;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #fff;
    line-height: 1.2;
  }

  .industries-hero__core {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 7.25rem;
    height: 11.5rem;
    flex-shrink: 0;
  }

  .industries-hero__core-glow {
    position: absolute;
    inset: 18% 4%;
    border-radius: 9999px;
    background: radial-gradient(circle, rgb(222 243 77 / 0.28), transparent 68%);
    filter: blur(6px);
  }

  .industries-hero__core-ring {
    position: absolute;
    border-radius: 9999px;
    border: 1px solid rgb(222 243 77 / 0.28);
  }

  .industries-hero__core-ring--outer {
    inset: 8% -8%;
    border-style: solid;
    opacity: 0.55;
  }

  .industries-hero__core-ring--mid {
    inset: 18% 2%;
    border-style: dashed;
    border-color: rgb(222 243 77 / 0.4);
  }

  .industries-hero__core-badge {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 6.1rem;
    gap: 0.12rem;
    padding: 0.85rem 0.55rem;
    border-radius: 9999px;
    border: 1px solid rgb(222 243 77 / 0.5);
    background:
      linear-gradient(160deg, rgb(222 243 77 / 0.2), rgb(13 18 12 / 0.92) 58%),
      #0d120c;
    box-shadow:
      0 0 0 5px rgb(13 18 12 / 0.55),
      0 0 34px rgb(222 243 77 / 0.22);
    text-align: center;
  }

  .industries-hero__core-mark {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: #def34d;
  }

  .industries-hero__core-name {
    font-family: var(--font-display);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
  }

  .industries-hero__core-sub {
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
  }

  .industries-hero__spokes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.55;
  }

  .industries-hero__spokes path {
    fill: none;
    stroke: rgb(222 243 77 / 0.35);
    stroke-width: 1.2;
    stroke-linecap: round;
  }

  @media (min-width: 640px) {
    .industries-hero__ecosystem {
      gap: 0.8rem;
      padding: 1.05rem 0.9rem;
      border-radius: 1.65rem;
    }

    .industries-hero__tile {
      padding: 0.8rem 0.85rem;
    }

    .industries-hero__tile-label {
      font-size: 0.85rem;
    }

    .industries-hero__core {
      width: 8rem;
      height: 12.5rem;
    }

    .industries-hero__core-badge {
      width: 6.75rem;
      padding: 0.95rem 0.6rem;
    }

    .industries-hero__core-mark {
      font-size: 1.5rem;
    }

    .industries-hero__core-name {
      font-size: 0.62rem;
    }
  }

  @media (min-width: 900px) {
    .industries-hero__layout {
      grid-template-columns: minmax(0, 0.55fr) minmax(0, 0.45fr);
      gap: 1.5rem;
    }

    .industries-hero__copy {
      display: block;
      text-align: left;
    }

    .industries-hero__title,
    .industries-hero__lede {
      margin-inline: 0;
    }

    .industries-hero__actions {
      width: auto;
      justify-content: flex-start;
    }

    .industries-hero__ecosystem {
      gap: 0.7rem;
      padding: 1rem 0.85rem;
    }

    .industries-hero__rail {
      gap: 0.7rem;
    }

    .industries-hero__tile {
      min-height: 3.25rem;
    }

    .industries-hero__core {
      width: 7.5rem;
      height: 13rem;
    }
  }

  @media (min-width: 1100px) {
    .industries-hero__layout {
      gap: 2rem;
    }

    .industries-hero__ecosystem {
      gap: 0.85rem;
      padding: 1.15rem 1rem;
    }

    .industries-hero__tile {
      min-height: 3.5rem;
      padding: 0.9rem 0.95rem;
      border-radius: 1.1rem;
    }

    .industries-hero__tile-label {
      font-size: 0.9rem;
    }

    .industries-hero__core {
      width: 8.5rem;
      height: 14rem;
    }

    .industries-hero__core-badge {
      width: 7.25rem;
    }
  }

  @media (min-width: 1280px) {
    .industries-hero__layout {
      gap: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .industries-hero__copy,
    .industries-hero__visual {
      opacity: 0;
      transform: translateY(16px);
      animation: industries-hero-rise 0.75s ease forwards;
    }

    .industries-hero__copy {
      animation-delay: 50ms;
    }

    .industries-hero__visual {
      animation-delay: 140ms;
    }

    .industries-hero__core-ring--mid {
      animation: industries-hero-spin 28s linear infinite;
    }

    .industries-hero__core-glow {
      animation: industries-hero-pulse 6s ease-in-out infinite;
    }

    .industries-hero__tile--float-0,
    .industries-hero__tile--float-3 {
      animation: industries-hero-float 7s ease-in-out infinite;
    }

    .industries-hero__tile--float-1,
    .industries-hero__tile--float-4 {
      animation: industries-hero-float 8s ease-in-out infinite;
      animation-delay: -2s;
    }

    .industries-hero__tile--float-2,
    .industries-hero__tile--float-5 {
      animation: industries-hero-float 7.5s ease-in-out infinite;
      animation-delay: -3.5s;
    }
  }

  @keyframes industries-hero-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes industries-hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @keyframes industries-hero-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes industries-hero-pulse {
    0%,
    100% {
      opacity: 0.7;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.08);
    }
  }
</style>
