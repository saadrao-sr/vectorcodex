---
import { ArrowUpRight } from 'lucide-react';
import { publishedChildren } from '../../../../config/published-service-children';
import { socialMediaParentService } from '../../../../config/service-parents/social-media-marketing';
import AmbientBackdrop from '../../../ui/AmbientBackdrop.astro';
import Container from '../../../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../../../ui/styles';
import ServiceParentFaq from '../shared/ServiceParentFaq.astro';
import ServiceParentFinalCta from '../shared/ServiceParentFinalCta.astro';
import ServiceParentMidCta from '../shared/ServiceParentMidCta.astro';

const service = socialMediaParentService;
const { hero, problems, capabilities, method, showcase, children, deliverables, enquiryValue } = service;
const publishedChildPills = publishedChildren('social');

const methodHub = method.steps[0]!;
const methodSpokes = method.steps.slice(1);

const feedCards = [
  { label: 'Pinned', tone: 'brand', lines: ['Campaign thread', 'Format mix for the week'] },
  { label: 'Series', tone: 'neutral', lines: ['Carousel outline', 'Hook → proof → CTA'] },
  { label: 'In review', tone: 'muted', lines: ['Copy pass', 'Brand checks'] },
];
---

<div class="social-landing text-white">
  <!-- 1. Hero -->
  <section
    class="social-landing__hero relative isolate overflow-x-clip border-b border-white/10 bg-[#0D120C] py-8 sm:py-12 lg:py-16"
    aria-labelledby={`${service.slug}-hero-heading`}
  >
    <AmbientBackdrop variant="mesh" />

    <Container class="relative">
      <div class="social-landing__hero-grid">
        <div class="social-landing__hero-copy min-w-0">
          <p class:list={[eyebrowClass, 'w-fit max-w-full']}>{hero.eyebrow}</p>
          <h1
            id={`${service.slug}-hero-heading`}
            class="mt-3 font-display text-[1.85rem] leading-[1.1] font-semibold tracking-tight text-balance sm:mt-4 sm:text-[2.35rem] sm:leading-[1.08] lg:text-[2.85rem]"
          >
            {hero.titleBefore}
            <span class="text-highlight"> {hero.titleHighlight}</span>
          </h1>
          <p class="mt-3 max-w-lg text-sm leading-7 text-white/70 sm:mt-4 sm:text-base sm:leading-8">{hero.intro}</p>
          <div class="mt-5 flex flex-col gap-3 sm:mt-6 sm:flex-row sm:flex-wrap">
            <button
              type="button"
              class:list={[buttonClass.base, buttonClass.gradient, 'w-full shadow-[0_14px_40px_rgb(197_246_61_/0.18)] sm:w-auto']}
              data-booking-open
              data-service={enquiryValue}
            >
              {hero.secondaryCtaLabel}
              <ArrowUpRight size={16} aria-hidden="true" />
            </button>
          </div>
          <p class="mt-4 max-w-md text-xs leading-6 text-white/45 sm:mt-5 sm:text-sm">{hero.proofLine}</p>
        </div>

        <div class="social-landing__feed" aria-hidden="true">
          <div class="social-landing__feed-rail"></div>
          {
            feedCards.map((card, i) => (
              <div
                class:list={['social-landing__post', `social-landing__post--${card.tone}`, i === 1 && 'social-landing__post--shift']}
                style={`--post-i: ${i}`}
              >
                <div class="social-landing__post-head">
                  <span class="social-landing__avatar" />
                  <div class="social-landing__post-meta">
                    <span class="social-landing__post-title">Brand studio</span>
                    <span class="social-landing__post-sub">{card.label}</span>
                  </div>
                </div>
                <div class="social-landing__post-body">
                  {card.lines.map((line) => (
                    <span class="social-landing__post-line" title={line} />
                  ))}
                </div>
                <div class="social-landing__post-actions">
                  <span class="social-landing__chip">Plan</span>
                  <span class="social-landing__chip social-landing__chip--ghost">Draft</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <!-- 2. Problems -->
  <section class="relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14" aria-labelledby={`${service.slug}-problems-heading`}>
    <AmbientBackdrop variant="drift" />
    <Container class="relative">
      <header class="mx-auto max-w-2xl text-center">
        <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{problems.eyebrow}</p>
        <h2 id={`${service.slug}-problems-heading`} class="mt-3 font-display text-[1.65rem] font-semibold tracking-tight text-balance sm:text-[2.1rem]">
          {problems.titleBefore}
          <span class="text-highlight"> {problems.titleHighlight}</span>
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-white/65 sm:text-base sm:leading-8">{problems.intro}</p>
      </header>

      <ul class="social-landing__problems mt-7 list-none p-0 sm:mt-8">
        {
          problems.items.map((item, index) => (
            <li class="social-landing__problem-card">
              <span class="social-landing__problem-idx font-display" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="font-display text-[0.88rem] font-semibold leading-snug tracking-tight text-white sm:text-[0.92rem]">
                {item.title}
              </h3>
              <p class="mt-1.5 text-[0.72rem] leading-5 text-white/55 sm:text-[0.75rem]">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <!-- 3. Capabilities -->
  <section class="border-t border-white/10 bg-[#0D120C] py-12 sm:py-16" aria-labelledby={`${service.slug}-capabilities-heading`}>
    <Container>
      <p class:list={[eyebrowClass, 'w-fit']}>{capabilities.eyebrow}</p>
      <h2 id={`${service.slug}-capabilities-heading`} class="mt-3 max-w-3xl font-display text-2xl font-semibold tracking-tight sm:text-3xl">
        {capabilities.titleBefore}
        <span class="text-highlight"> {capabilities.titleHighlight}</span>
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:text-base">{capabilities.intro}</p>

      {
        publishedChildPills.length > 0 ? (
          <div class="social-landing__pill-row mt-8 flex flex-wrap gap-2" role="list" aria-label="Published child services">
            {publishedChildPills.map((child) => (
              <a role="listitem" href={child.href} class="social-landing__pill">
                {child.label}
              </a>
            ))}
          </div>
        ) : null
      }

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          capabilities.items.map((item) =>
            item.href ? (
              <a
                href={item.href}
                class="group flex h-full flex-col rounded-2xl border border-white/12 bg-gradient-to-br from-white/[0.04] to-transparent p-5 transition hover:border-highlight/45 hover:bg-white/[0.05]"
              >
                <h3 class="font-display text-lg font-semibold text-white group-hover:text-highlight">{item.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-6 text-white/66">{item.text}</p>
                <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-[0.14em] text-highlight/90">
                  Open
                  <ArrowUpRight size={14} aria-hidden="true" />
                </span>
              </a>
            ) : (
              <article class="flex h-full flex-col rounded-2xl border border-white/10 bg-gradient-to-br from-white/[0.04] to-transparent p-5">
                <h3 class="font-display text-lg font-semibold text-white">{item.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-6 text-white/66">{item.text}</p>
              </article>
            ),
          )
        }
      </div>
    </Container>
  </section>

  <!-- 4. Method — hub & spoke -->
  <section
    class="relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-12 sm:py-16 lg:py-20"
    aria-labelledby={`${service.slug}-method-heading`}
  >
    <AmbientBackdrop variant="orbs" />
    <Container class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <p class:list={[eyebrowClass, 'mx-auto w-fit']}>{method.eyebrow}</p>
        <h2 id={`${service.slug}-method-heading`} class="mt-3 font-display text-2xl font-semibold tracking-tight sm:text-3xl">
          {method.titleBefore}
          <span class="text-highlight"> {method.titleHighlight}</span>
        </h2>
        <p class="mt-3 text-sm leading-7 text-white/65 sm:text-base">{method.intro}</p>
      </div>

      <div class="social-landing__hub mt-12 lg:mt-16">
        <div class="social-landing__hub-center">
          <span class="social-landing__hub-ring" aria-hidden="true"></span>
          <div class="social-landing__hub-core">
            <span class="social-landing__hub-step">{methodHub.number}</span>
            <p class="social-landing__hub-title">{methodHub.title}</p>
            <p class="social-landing__hub-text">{methodHub.text}</p>
          </div>
        </div>
        {
          methodSpokes.map((step, idx) => (
            <article class="social-landing__spoke" data-spoke={idx + 1}>
              <span class="social-landing__spoke-mark">{step.number}</span>
              <h3 class="font-display text-base font-semibold text-white">{step.title}</h3>
              <p class="mt-1 text-sm leading-6 text-white/65">{step.text}</p>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- 5. Showcase -->
  <section class="border-t border-white/10 bg-[#0D120C] py-12 sm:py-16" aria-labelledby={`${service.slug}-showcase-heading`}>
    <Container>
      <p class:list={[eyebrowClass, 'w-fit']}>{showcase.eyebrow}</p>
      <h2 id={`${service.slug}-showcase-heading`} class="mt-3 max-w-3xl font-display text-2xl font-semibold tracking-tight sm:text-3xl">
        {showcase.titleBefore}
        <span class="text-highlight"> {showcase.titleHighlight}</span>
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:text-base">{showcase.intro}</p>

      <div class="social-landing__showcase mt-10 grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-stretch">
        <div class="grid gap-4 md:grid-cols-2">
          {
            showcase.panels.map((panel) => (
              <article class="flex h-full flex-col rounded-2xl border border-white/12 bg-white/[0.03] p-6">
                <h3 class="font-display text-lg font-semibold text-white">{panel.title}</h3>
                <p class="mt-2 text-sm leading-6 text-white/65">{panel.text}</p>
                <ul class="mt-4 space-y-2 border-t border-white/10 pt-4 text-sm text-white/72">
                  {panel.points.map((point) => (
                    <li class="flex gap-2">
                      <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-highlight/80" aria-hidden="true" />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>

        <div class="social-landing__showcase-feed" aria-hidden="true">
          <div class="social-landing__showcase-stack">
            <div class="social-landing__tile social-landing__tile--a" />
            <div class="social-landing__tile social-landing__tile--b" />
            <div class="social-landing__tile social-landing__tile--c" />
          </div>
          <p class="social-landing__showcase-caption">Editorial frames &amp; feed-native layouts (illustrative)</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- 6. Connected services -->
  <section class="border-t border-white/10 bg-[#0D120C] py-12 sm:py-14" aria-labelledby={`${service.slug}-children-heading`}>
    <Container>
      <p class:list={[eyebrowClass, 'w-fit']}>{children.eyebrow}</p>
      <h2 id={`${service.slug}-children-heading`} class="mt-3 max-w-3xl font-display text-2xl font-semibold tracking-tight sm:text-3xl">
        {children.titleBefore}
        <span class="text-highlight"> {children.titleHighlight}</span>
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-white/65">{children.intro}</p>

      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          children.items.map((item) => (
            <li>
              <a
                href={item.href}
                class="group flex h-full flex-col rounded-2xl border border-white/12 bg-white/[0.02] p-5 transition hover:border-highlight/45 hover:bg-white/[0.05]"
              >
                <span class="text-sm font-semibold text-white group-hover:text-highlight">{item.label}</span>
                <span class="mt-2 text-sm leading-6 text-white/65">{item.text}</span>
                <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-[0.14em] text-highlight/90">
                  Open
                  <ArrowUpRight size={14} aria-hidden="true" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <!-- 7. Mid CTA -->
  <ServiceParentMidCta service={service} tone="band" />

  <!-- 8. Deliverables -->
  <section class="social-deliverables relative isolate overflow-hidden border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14" aria-labelledby={`${service.slug}-deliverables-heading`}>
    <AmbientBackdrop variant="drift" class="opacity-50" />
    <Container class="relative">
      <header class="mx-auto max-w-2xl text-center">
        <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{deliverables.eyebrow}</p>
        <h2 id={`${service.slug}-deliverables-heading`} class="mt-3 font-display text-[1.65rem] font-semibold tracking-tight text-balance sm:text-[2.1rem]">
          {deliverables.titleBefore}
          <span class="text-highlight"> {deliverables.titleHighlight}</span>
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-white/65 sm:text-base sm:leading-8">{deliverables.intro}</p>
      </header>

      <div class="social-deliverables__board mt-7 sm:mt-8">
        <div class="social-deliverables__cadence" aria-hidden="true">
          {
            ['Plan', 'Create', 'Engage', 'Report'].map((phase, index) => (
              <div class="social-deliverables__phase">
                <span class="social-deliverables__phase-dot" />
                <span class="social-deliverables__phase-label">{phase}</span>
                {index < 3 ? <span class="social-deliverables__phase-rail" /> : null}
              </div>
            ))
          }
        </div>

        <ol class="social-deliverables__feed">
          {
            deliverables.items.map((item, index) => {
              const phase = ['Plan', 'Create', 'Engage', 'Report'][index] ?? 'Scope';
              return (
                <li class="social-deliverables__slot">
                  <article class="social-deliverables__post">
                    <div class="social-deliverables__chrome">
                      <span class="social-deliverables__avatar" aria-hidden="true" />
                      <div class="social-deliverables__chrome-copy">
                        <span class="social-deliverables__phase-chip">{phase}</span>
                        <span class="social-deliverables__slot-idx font-display" aria-hidden="true">
                          {String(index + 1).padStart(2, '0')}
                        </span>
                      </div>
                    </div>
                    <h3 class="mt-3 font-display text-[0.95rem] font-semibold leading-snug tracking-tight text-white sm:text-base">
                      {item.title}
                    </h3>
                    <p class="mt-1.5 text-[0.8rem] leading-6 text-white/60 sm:text-sm">{item.text}</p>
                    <div class="social-deliverables__media" aria-hidden="true">
                      <span />
                      <span />
                      <span />
                    </div>
                  </article>
                </li>
              );
            })
          }
        </ol>
      </div>
    </Container>
  </section>

  <!-- 9. FAQ -->
  <ServiceParentFaq service={service} layout="split" />

  <!-- 10. Final CTA -->
  <ServiceParentFinalCta service={service} />
</div>

<style>
  .social-landing__hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .social-landing__hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 1.75rem;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .social-landing__hero-grid {
      gap: 2.25rem;
    }
  }

  .social-landing__feed {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-width: 0;
    padding: 0.35rem 0 0.35rem 1.1rem;
  }

  .social-landing__feed-rail {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    border-radius: 999px;
    background: linear-gradient(180deg, rgb(222 243 77 / 0.45), rgb(222 243 77 / 0.08), transparent);
  }

  .social-landing__post {
    position: relative;
    border-radius: 1.05rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    background: rgb(255 255 255 / 0.04);
    padding: 0.75rem 0.9rem 0.85rem;
    transform: rotate(-1deg);
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.22);
    --post-i: 0;
  }

  .social-landing__post--shift {
    margin-left: 0.55rem;
    transform: rotate(0.7deg) translateY(-1px);
  }

  .social-landing__post--brand {
    border-color: rgb(222 243 77 / 0.28);
    background: linear-gradient(135deg, rgb(222 243 77 / 0.08), rgb(255 255 255 / 0.03));
  }

  .social-landing__post--muted {
    opacity: 0.88;
    transform: rotate(-0.6deg) translateX(4px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .social-landing__post {
      animation: social-post-drift 7s ease-in-out infinite;
      animation-delay: calc(var(--post-i) * 0.8s);
    }

    .social-landing__post--shift {
      animation-name: social-post-drift-alt;
    }
  }

  @keyframes social-post-drift {
    0%,
    100% {
      transform: translateY(0) rotate(-1.2deg);
    }
    50% {
      transform: translateY(-6px) rotate(-0.4deg);
    }
  }

  @keyframes social-post-drift-alt {
    0%,
    100% {
      transform: rotate(0.8deg) translateY(-2px);
    }
    50% {
      transform: rotate(0.4deg) translateY(-8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-landing__post,
    .social-landing__post--shift,
    .social-landing__post--muted {
      animation: none !important;
    }
  }

  .social-landing__post-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .social-landing__avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: linear-gradient(135deg, rgb(222 243 77 / 0.35), rgb(255 255 255 / 0.08));
    border: 1px solid rgb(255 255 255 / 0.12);
  }

  .social-landing__post-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .social-landing__post-title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.78);
  }

  .social-landing__post-sub {
    font-size: 0.68rem;
    color: rgb(255 255 255 / 0.45);
  }

  .social-landing__post-body {
    margin-top: 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .social-landing__post-line {
    height: 0.45rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
  }

  .social-landing__post-line:nth-child(1) {
    width: 92%;
  }
  .social-landing__post-line:nth-child(2) {
    width: 72%;
  }

  .social-landing__post-actions {
    margin-top: 0.75rem;
    display: flex;
    gap: 0.4rem;
  }

  .social-landing__chip {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    border: 1px solid rgb(222 243 77 / 0.35);
    color: rgb(222 243 77 / 0.95);
  }

  .social-landing__chip--ghost {
    border-color: rgb(255 255 255 / 0.14);
    color: rgb(255 255 255 / 0.55);
  }

  .social-landing__problems {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .social-landing__problems {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .social-landing__problems {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.7rem;
    }
  }

  .social-landing__problem-card {
    min-width: 0;
    height: 100%;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1rem;
    background:
      linear-gradient(165deg, rgb(222 243 77 / 0.06), transparent 42%),
      rgb(255 255 255 / 0.03);
    padding: 0.95rem 0.9rem 1rem;
  }

  .social-landing__problem-idx {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #def34d;
  }

  .social-landing__pill {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid rgb(222 243 77 / 0.35);
    background: rgb(222 243 77 / 0.1);
    padding: 0.35rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #def34d;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .social-landing__pill:hover {
    border-color: rgb(222 243 77 / 0.6);
    background: rgb(222 243 77 / 0.15);
    transform: translateY(-1px);
  }

  .social-landing__pill:focus-visible {
    outline: 2px solid #def34d;
    outline-offset: 2px;
  }

  /* Hub — CSS grid so spokes never overlap */
  .social-landing__hub {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem;
    max-width: 58rem;
    margin-inline: auto;
  }

  .social-landing__hub-center {
    position: relative;
    z-index: 2;
    width: min(16rem, 100%);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    margin-inline: auto;
    order: -1;
  }

  .social-landing__hub-ring {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    border: 1px dashed rgb(222 243 77 / 0.22);
    animation: hub-pulse 10s linear infinite;
  }

  @keyframes hub-pulse {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
