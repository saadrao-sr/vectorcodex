---
import { ArrowUpRight } from 'lucide-react';
import { seoParentService } from '../../../../config/service-parents/seo';
import AmbientBackdrop from '../../../ui/AmbientBackdrop.astro';
import Container from '../../../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../../../ui/styles';
import ServiceParentFaq from '../shared/ServiceParentFaq.astro';
import ServiceParentFinalCta from '../shared/ServiceParentFinalCta.astro';
import ServiceParentMidCta from '../shared/ServiceParentMidCta.astro';

const service = seoParentService;
const { hero, problems, capabilities, method, showcase, children, deliverables, enquiryValue } = service;
---

<div class="seo-landing bg-[#0D120C] text-white">
  <section class="seo-hero relative isolate overflow-hidden border-b border-white/10 py-8 sm:py-12 lg:py-16" aria-labelledby="seo-hero-heading">
    <AmbientBackdrop variant="mesh" />
    <Container class="relative">
      <div class="seo-hero__layout">
      <div class="seo-hero__copy min-w-0">
        <p class:list={[eyebrowClass, 'w-fit max-w-full']}>{hero.eyebrow}</p>
        <h1 id="seo-hero-heading" class="mt-3 font-display text-[1.85rem] leading-[1.1] font-semibold tracking-tight text-balance sm:mt-4 sm:text-[2.35rem] sm:leading-[1.08] lg:text-[3.1rem]">
          {hero.titleBefore}
          <span class="text-highlight"> {hero.titleHighlight}</span>
        </h1>
        <p class="mt-3 max-w-xl text-sm leading-7 text-white/70 sm:mt-4 sm:text-base sm:leading-8">{hero.intro}</p>
        <div class="mt-5 flex flex-col gap-3 sm:mt-6 sm:flex-row sm:flex-wrap">
          <button
            type="button"
            class:list={[
              buttonClass.base,
              buttonClass.gradient,
              'w-full shadow-[0_14px_40px_rgb(197_246_61_/0.18)] sm:w-auto',
            ]}
            data-booking-open
            data-service={enquiryValue}
          >
            {hero.secondaryCtaLabel}
            <ArrowUpRight size={16} aria-hidden="true" />
          </button>
        </div>
        <p class="mt-4 max-w-lg text-xs leading-6 text-white/45 sm:mt-5 sm:text-sm">{hero.proofLine}</p>
      </div>

      <div
        class="seo-analytics-panel relative w-full min-w-0 overflow-hidden rounded-[1.25rem] border border-white/12 bg-white/[0.04] p-3.5 shadow-[0_16px_48px_rgb(0_0_0_/0.28)] sm:rounded-2xl sm:p-5 sm:shadow-[0_24px_80px_rgb(0_0_0_/0.35)]"
        aria-hidden="true"
      >
        <div class="flex items-center justify-between border-b border-white/10 pb-2.5 sm:pb-3">
          <span class="text-[10px] font-semibold tracking-widest text-white/40 uppercase">Search overview</span>
          <span class="h-2 w-2 rounded-full bg-highlight/80 seo-analytics-panel__pulse"></span>
        </div>
        <div class="mt-3 grid gap-2.5 font-mono text-[10px] text-white/50 sm:mt-4 sm:gap-3 sm:text-[11px]">
          <div class="flex items-end justify-between gap-2">
            <span class="text-white/65">Intent map</span>
            <div class="seo-sparkline flex flex-1 items-end justify-end gap-px pt-1 sm:pt-2" aria-hidden="true">
              <span class="seo-sparkline__seg h-3 w-1 rounded-sm bg-highlight/35"></span>
              <span class="seo-sparkline__seg h-5 w-1 rounded-sm bg-highlight/50"></span>
              <span class="seo-sparkline__seg h-4 w-1 rounded-sm bg-highlight/40"></span>
              <span class="seo-sparkline__seg h-7 w-1 rounded-sm bg-highlight/60"></span>
              <span class="seo-sparkline__seg h-5 w-1 rounded-sm bg-highlight/45"></span>
              <span class="seo-sparkline__seg h-8 w-1 rounded-sm bg-highlight/70"></span>
              <span class="seo-sparkline__seg h-4 w-1 rounded-sm bg-highlight/38"></span>
            </div>
          </div>
          <div class="rounded-lg border border-white/8 bg-black/25 p-2.5 sm:p-3">
            <p class="text-[9px] tracking-wide text-white/35 uppercase">Coverage</p>
            <div class="mt-2 space-y-2">
              {
                ['Query themes', 'Templates', 'Structured'].map((label, i) => (
                  <div class="flex items-center gap-2">
                    <span class="w-20 shrink-0 truncate text-white/55 sm:w-24">{label}</span>
                    <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-white/10">
                      <div
                        class="h-full rounded-full bg-gradient-to-r from-lime/80 to-gold/70 seo-rank-bar"
                        style={`--bar-pct: ${45 + i * 12}%`}
                      />
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="rounded-lg border border-white/8 bg-black/20 p-2.5 sm:p-3">
            <p class="text-[9px] tracking-wide text-white/35 uppercase">Technical</p>
            <div class="mt-2 flex gap-1.5">
              {
                Array.from({ length: 8 }).map((_, j) => (
                  <div
                    class="w-2 rounded-sm bg-gradient-to-t from-highlight/15 to-highlight/55 seo-crawl-col"
                    style={`height:${1.1 + (j % 4) * 0.35}rem`}
                  />
                ))
              }
            </div>
          </div>
          <div class="flex flex-wrap gap-1.5 text-[9px] text-white/40 sm:gap-2">
            <span class="rounded border border-white/10 px-2 py-1">Index health</span>
            <span class="rounded border border-white/10 px-2 py-1">Internal links</span>
            <span class="rounded border border-white/10 px-2 py-1">Entities</span>
          </div>
        </div>
      </div>
      </div>
    </Container>
  </section>

  <section class="relative isolate overflow-x-clip border-b border-white/10 py-10 sm:py-12 lg:py-14" aria-labelledby="seo-problems-heading">
    <AmbientBackdrop variant="drift" class="opacity-80" />
    <Container class="relative">
      <header class="mx-auto max-w-2xl text-center">
        <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{problems.eyebrow}</p>
        <h2 id="seo-problems-heading" class="mt-3 font-display text-[1.65rem] font-semibold tracking-tight text-balance sm:text-[2.1rem]">
          {problems.titleBefore}
          <span class="text-highlight"> {problems.titleHighlight}</span>
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-white/68 sm:text-base sm:leading-8">{problems.intro}</p>
      </header>

      <ul class="mt-7 grid list-none grid-cols-1 gap-3 p-0 sm:mt-8 sm:grid-cols-2 md:grid-cols-5 md:gap-2.5 lg:gap-3">
        {
          problems.items.map((item, index) => (
            <li class="min-w-0 rounded-xl border border-white/10 bg-white/[0.03] px-3.5 py-3.5 sm:px-4 sm:py-4">
              <span class="font-display block text-[0.68rem] font-bold tracking-[0.12em] text-highlight" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-2 font-display text-[0.88rem] font-semibold leading-snug tracking-tight text-white sm:text-[0.92rem]">
                {item.title}
              </h3>
              <p class="mt-1.5 text-[0.72rem] leading-5 text-white/55 sm:text-[0.75rem]">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <section class="relative isolate border-b border-white/10 py-10 sm:py-12 lg:py-14" aria-labelledby="seo-capabilities-heading">
    <AmbientBackdrop variant="orbs" />
    <Container class="relative">
      <header class="mx-auto max-w-2xl text-center">
        <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{capabilities.eyebrow}</p>
        <h2 id="seo-capabilities-heading" class="mt-3 font-display text-[1.65rem] font-semibold tracking-tight text-balance sm:text-[2.1rem]">
          {capabilities.titleBefore}
          <span class="text-highlight"> {capabilities.titleHighlight}</span>
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-white/68 sm:text-base sm:leading-8">{capabilities.intro}</p>
      </header>

      <ul class="seo-caps mt-8 grid list-none grid-cols-1 gap-3 p-0 sm:mt-9 sm:grid-cols-2 lg:grid-cols-3 lg:gap-3.5">
        {
          capabilities.items.map((cap, idx) => {
            const cardClass = [
              'seo-caps__card group relative flex h-full min-h-[12rem] flex-col overflow-hidden rounded-2xl border border-white/12 bg-white/[0.03] p-5 transition duration-300',
              cap.href ? 'hover:border-highlight/40 hover:bg-white/[0.05]' : '',
            ];
            const body = (
              <>
                <span class="seo-caps__accent" aria-hidden="true" />
                <div class="flex items-center justify-between gap-3">
                  <span class="font-display text-[0.68rem] font-bold tracking-[0.14em] text-highlight">
                    {String(idx + 1).padStart(2, '0')}
                  </span>
                  {cap.href ? (
                    <ArrowUpRight
                      size={15}
                      className="text-white/35 transition group-hover:text-highlight"
                      aria-hidden="true"
                    />
                  ) : (
                    <span class="h-1.5 w-1.5 rounded-full bg-white/25" aria-hidden="true" />
                  )}
                </div>
                <h3 class="mt-3 font-display text-lg font-semibold tracking-tight text-white">{cap.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-6 text-white/62">{cap.text}</p>
                {cap.href ? (
                  <span class="mt-4 text-xs font-semibold tracking-tight text-highlight/90">View service</span>
                ) : (
                  <span class="mt-4 text-xs font-medium tracking-tight text-white/35">Included in SEO</span>
                )}
              </>
            );
            return (
              <li class="min-w-0">
                {cap.href ? (
                  <a href={cap.href} class:list={cardClass}>
                    {body}
                  </a>
                ) : (
                  <div class:list={cardClass}>{body}</div>
                )}
              </li>
            );
          })
        }
      </ul>
    </Container>
  </section>

  <section class="relative isolate border-b border-white/10 py-12 sm:py-14 lg:py-16" aria-labelledby="seo-method-heading">
    <Container class="relative">
      <header class="mx-auto max-w-2xl text-center">
        <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{method.eyebrow}</p>
        <h2 id="seo-method-heading" class="mt-3 font-display text-[1.65rem] font-semibold tracking-tight text-balance sm:text-[2.1rem]">
          {method.titleBefore}
          <span class="text-highlight"> {method.titleHighlight}</span>
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-white/68 sm:text-base sm:leading-8">{method.intro}</p>
      </header>

      <div class="seo-timeline mt-10 overflow-x-auto pb-2">
        <ol class="seo-timeline__track flex min-w-[52rem] gap-0 lg:min-w-0">
          {
            method.steps.map((step) => (
              <li class="seo-timeline__step relative flex min-w-0 flex-1 flex-col border-t border-white/15 pt-6 pr-4 pl-2 sm:pr-5">
                <span class="absolute top-0 left-2 h-2 w-2 -translate-y-1/2 rounded-full border-2 border-[#0D120C] bg-highlight" />
                <span class="text-[10px] font-semibold tracking-[0.2em] text-white/35 uppercase">{step.number}</span>
                <h3 class="mt-2 font-display text-base font-semibold sm:text-lg">{step.title}</h3>
                <p class="mt-2 text-xs leading-6 text-white/62 sm:text-sm">{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </Container>
  </section>

  <section class="relative isolate border-b border-white/10 py-12 sm:py-14 lg:py-16" aria-labelledby="seo-showcase-heading">
    <AmbientBackdrop variant="mesh" class="opacity-70" />
    <Container class="relative">
      <div class="max-w-2xl">
        <p class:list={[eyebrowClass, 'w-fit']}>{showcase.eyebrow}</p>
        <h2 id="seo-showcase-heading" class="mt-3 font-display text-[1.65rem] font-semibold tracking-tight sm:text-[2.1rem]">
          {showcase.titleBefore}
          <span class="text-highlight"> {showcase.titleHighlight}</span>
        </h2>
        <p class="mt-3 max-w-xl text-sm leading-7 text-white/68 sm:text-base sm:leading-8">{showcase.intro}</p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {
          showcase.panels.map((panel) => (
            <article class="rounded-[1.35rem] border border-white/12 bg-gradient-to-br from-white/[0.06] to-transparent p-6 sm:p-7">
              <h3 class="font-display text-xl font-semibold">{panel.title}</h3>
              <p class="mt-3 text-sm leading-7 text-white/68">{panel.text}</p>
              <ul class="mt-5 space-y-2.5 border-t border-white/10 pt-5 text-sm text-white/72">
                {panel.points.map((point) => (
                  <li class="flex gap-2">
                    <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-highlight/80" aria-hidden="true" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="relative isolate border-b border-white/10 py-12 sm:py-14 lg:py-16" aria-labelledby="seo-children-heading">
    <Container>
      <header class="mx-auto max-w-2xl text-center">
        <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{children.eyebrow}</p>
        <h2 id="seo-children-heading" class="mt-3 font-display text-[1.65rem] font-semibold tracking-tight text-balance sm:text-[2.1rem]">
          {children.titleBefore}
          <span class="text-highlight"> {children.titleHighlight}</span>
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-white/68 sm:text-base sm:leading-8">{children.intro}</p>
      </header>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          children.items.map((link) => (
            <li>
              <a
                href={link.href}
                class="group flex h-full flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-4 transition hover:border-highlight/40 hover:bg-white/[0.05] sm:p-5"
              >
                <span class="font-display text-lg font-semibold text-white group-hover:text-highlight">{link.label}</span>
                <p class="mt-1 flex-1 text-sm leading-6 text-white/65">{link.text}</p>
                <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold tracking-[0.14em] text-highlight/90 uppercase">
                  Open
                  <ArrowUpRight size={14} aria-hidden="true" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <ServiceParentMidCta service={service} />

  <section class="seo-deliverables relative isolate overflow-hidden border-b border-white/10 py-10 sm:py-12 lg:py-14" aria-labelledby="seo-deliverables-heading">
    <AmbientBackdrop variant="drift" class="opacity-60" />
    <Container class="relative">
      <div class="seo-deliverables__shell">
        <header class="seo-deliverables__intro">
          <p class:list={[eyebrowClass, 'w-fit max-w-full']}>{deliverables.eyebrow}</p>
          <h2 id="seo-deliverables-heading" class="mt-3 font-display text-[1.65rem] font-semibold tracking-tight text-balance sm:text-[2.1rem]">
            {deliverables.titleBefore}
            <span class="text-highlight"> {deliverables.titleHighlight}</span>
          </h2>
          <p class="mt-3 max-w-md text-sm leading-7 text-white/68 sm:text-base sm:leading-8">{deliverables.intro}</p>
          <div class="seo-deliverables__meter mt-6 hidden sm:block" aria-hidden="true">
            <div class="seo-deliverables__meter-label">
              <span>Scope</span>
              <span>Signal</span>
            </div>
            <div class="seo-deliverables__meter-track">
              <span class="seo-deliverables__meter-fill"></span>
            </div>
            <p class="mt-2 text-[0.7rem] tracking-wide text-white/40 uppercase">Evidence-led reporting only</p>
          </div>
        </header>

        <ul class="seo-deliverables__grid">
          {
            deliverables.items.map((d, index) => (
              <li>
                <article class="seo-deliverables__card">
                  <span class="seo-deliverables__watermark font-display" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="seo-deliverables__card-top">
                    <span class="seo-deliverables__tag">{index < 3 ? 'Deliverable' : 'Reporting'}</span>
                    <span class="seo-deliverables__dot" aria-hidden="true" />
                  </div>
                  <h3 class="relative mt-3 font-display text-base font-semibold tracking-tight text-white sm:text-lg">{d.title}</h3>
                  <p class="relative mt-2 flex-1 text-sm leading-6 text-white/62">{d.text}</p>
                </article>
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </section>

  <ServiceParentFaq service={service} />
  <ServiceParentFinalCta service={service} />
</div>

<style>
  .seo-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .seo-hero__layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 1.75rem;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .seo-hero__layout {
      gap: 2.5rem;
    }
  }

  .seo-rank-bar {
    width: var(--bar-pct, 60%);
  }

  .seo-deliverables__shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .seo-deliverables__shell {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 1.5rem 1.75rem;
      align-items: stretch;
    }

    .seo-deliverables__intro {
      display: flex;
      height: 100%;
      flex-direction: column;
      justify-content: center;
      padding-right: 0.5rem;
    }
  }

  .seo-deliverables__meter {
    max-width: 16rem;
  }

  .seo-deliverables__meter-label {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.4rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.4);
  }

  .seo-deliverables__meter-track {
    height: 0.35rem;
    overflow: hidden;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.08);
  }

  .seo-deliverables__meter-fill {
    display: block;
    width: 68%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #def34d, rgb(197 246 61 / 0.45));
  }

  .seo-deliverables__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .seo-deliverables__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 1fr;
      gap: 0.85rem;
    }
  }

  .seo-deliverables__grid > li {
    min-width: 0;
    height: 100%;
  }

  .seo-deliverables__card {
    position: relative;
    display: flex;
    height: 100%;
    min-height: 10.75rem;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.15rem;
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.045), transparent 42%),
      rgb(13 18 12 / 0.55);
    padding: 1.1rem 1.1rem 1.15rem;
  }

  .seo-deliverables__watermark {
    position: absolute;
    top: 0.55rem;
    right: 0.7rem;
    z-index: 0;
    font-size: clamp(2.4rem, 5vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
    color: rgb(222 243 77 / 0.07);
    pointer-events: none;
  }

  .seo-deliverables__card-top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 1.5rem;
  }

  .seo-deliverables__tag {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgb(222 243 77 / 0.28);
    border-radius: 9999px;
    background: rgb(222 243 77 / 0.08);
    padding: 0.25rem 0.6rem;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #def34d;
  }

  .seo-deliverables__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: #def34d;
    box-shadow: 0 0 0 3px rgb(222 243 77 / 0.12);
  }

  .seo-caps__accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #def34d, transparent 72%);
    opacity: 0.85;
  }

  .seo-caps__card {
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04);
  }

  @media (prefers-reduced-motion: no-preference) {
    .seo-caps__card:hover {
      transform: translateY(-2px);
    }

    .seo-analytics-panel__pulse {
      animation: seo-pulse 2.4s ease-in-out infinite;
    }

    .seo-sparkline__seg {
      animation: seo-spark 2.8s ease-in-out infinite;
    }

    .seo-sparkline__seg:nth-child(2) {
      animation-delay: 0.15s;
    }
    .seo-sparkline__seg:nth-child(3) {
      animation-delay: 0.3s;
    }
    .seo-sparkline__seg:nth-child(4) {
      animation-delay: 0.45s;
    }
    .seo-sparkline__seg:nth-child(5) {
      animation-delay: 0.6s;
    }
    .seo-sparkline__seg:nth-child(6) {
      animation-delay: 0.75s;
    }
    .seo-sparkline__seg:nth-child(7) {
      animation-delay: 0.9s;
    }

    .seo-crawl-col {
      animation: seo-crawl 2.2s ease-in-out infinite;
    }
    .seo-crawl-col:nth-child(odd) {
      animation-delay: 0.2s;
    }
  }

  @keyframes seo-pulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  @keyframes seo-spark {
    0%,
    100% {
      opacity: 0.45;
      transform: scaleY(0.85);
    }
    50% {
      opacity: 1;
      transform: scaleY(1.1);
    }
  }

  @keyframes seo-crawl {
    0%,
