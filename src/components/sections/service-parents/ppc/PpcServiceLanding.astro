---
import { ArrowUpRight } from 'lucide-react';
import { ppcParentService } from '../../../../config/service-parents/ppc-management';
import AmbientBackdrop from '../../../ui/AmbientBackdrop.astro';
import Container from '../../../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../../../ui/styles';
import ServiceParentFaq from '../shared/ServiceParentFaq.astro';
import ServiceParentFinalCta from '../shared/ServiceParentFinalCta.astro';
import ServiceParentMidCta from '../shared/ServiceParentMidCta.astro';

const service = ppcParentService;
const { hero, problems, capabilities, method, showcase, children, deliverables, enquiryValue } = service;

const channelMarkers: Record<string, string> = {
  'Google Ads': 'GA',
  'Search campaigns': 'SR',
  'Display advertising': 'DS',
  'Performance Max': 'PM',
  'Conversion tracking': 'TR',
};
---

<div class="ppc-landing text-white">
  <!-- 1. Hero -->
  <section
    class="ppc-landing__hero relative isolate overflow-x-clip border-b border-white/10 bg-[#0D120C] py-8 sm:py-12 lg:py-16"
    aria-labelledby={`${service.slug}-hero-heading`}
  >
    <AmbientBackdrop variant="mesh" />

    <Container class="relative">
      <div class="ppc-landing__hero-grid">
        <div class="ppc-landing__hero-copy min-w-0">
          <p class:list={[eyebrowClass, 'w-fit max-w-full']}>{hero.eyebrow}</p>
          <h1
            id={`${service.slug}-hero-heading`}
            class="mt-3 font-display text-[1.85rem] leading-[1.1] font-semibold tracking-tight text-balance sm:mt-4 sm:text-[2.35rem] sm:leading-[1.08] lg:text-[2.85rem]"
          >
            {hero.titleBefore}
            <span class="text-highlight"> {hero.titleHighlight}</span>
          </h1>
          <p class="mt-3 max-w-lg text-sm leading-7 text-white/70 sm:mt-4 sm:text-base sm:leading-8">{hero.intro}</p>
          <div class="mt-5 flex flex-col gap-3 sm:mt-6 sm:flex-row sm:flex-wrap">
            <button
              type="button"
              class:list={[buttonClass.base, buttonClass.gradient, 'w-full shadow-[0_14px_40px_rgb(197_246_61_/0.18)] sm:w-auto']}
              data-quote-open
              data-service={enquiryValue}
            >
              {hero.primaryCtaLabel}
              <ArrowUpRight size={16} aria-hidden="true" />
            </button>
          </div>
          <p class="mt-4 max-w-md text-xs leading-6 text-white/45 sm:mt-5 sm:text-sm">{hero.proofLine}</p>
        </div>

        <div class="ppc-landing__hero-visual" aria-hidden="true">
          <div class="ppc-landing__dash">
            <div class="ppc-landing__dash-top">
              <span class="ppc-landing__dash-title">Campaign overview</span>
              <span class="ppc-landing__dash-pill">Structure</span>
            </div>
            <div class="ppc-landing__dash-bars">
              <span class="ppc-landing__bar" style="height: 42%" />
              <span class="ppc-landing__bar" style="height: 68%" />
              <span class="ppc-landing__bar" style="height: 55%" />
              <span class="ppc-landing__bar" style="height: 80%" />
              <span class="ppc-landing__bar" style="height: 36%" />
            </div>
            <div class="ppc-landing__dash-grid">
              <span class="ppc-landing__cell" />
              <span class="ppc-landing__cell" />
              <span class="ppc-landing__cell" />
              <span class="ppc-landing__cell" />
            </div>
          </div>

          <div class="ppc-landing__funnel">
            <p class="ppc-landing__funnel-label">Intent funnel</p>
            <ol class="ppc-landing__funnel-stages">
              <li class="ppc-landing__stage" style="--w: 100%">
                <span class="ppc-landing__stage-name">Awareness</span>
              </li>
              <li class="ppc-landing__stage" style="--w: 82%">
                <span class="ppc-landing__stage-name">Consideration</span>
              </li>
              <li class="ppc-landing__stage" style="--w: 64%">
                <span class="ppc-landing__stage-name">Conversion</span>
              </li>
              <li class="ppc-landing__stage ppc-landing__stage--accent" style="--w: 46%">
                <span class="ppc-landing__stage-name">Enquiry</span>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 2. Problems -->
  <section class="relative isolate overflow-x-clip bg-[#0D120C] py-12 sm:py-14" aria-labelledby={`${service.slug}-problems-heading`}>
    <AmbientBackdrop variant="drift" />
    <Container class="relative">
      <div class="text-center lg:text-left">
        <p class:list={[eyebrowClass, 'mx-auto w-fit lg:mx-0']}>{problems.eyebrow}</p>
        <h2 id={`${service.slug}-problems-heading`} class="mt-3 font-display text-2xl font-semibold tracking-tight sm:text-3xl">
          {problems.titleBefore}
          <span class="text-highlight"> {problems.titleHighlight}</span>
        </h2>
        <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:text-base lg:mx-0">{problems.intro}</p>
      </div>

      <div class="ppc-landing__diagnostic mt-10 rounded-[1.35rem] border border-white/12 bg-[#0a0f0a] p-4 sm:p-6">
        <div class="ppc-landing__diag-header">
          <span class="ppc-landing__diag-dot" />
          <span class="ppc-landing__diag-dot" />
          <span class="ppc-landing__diag-dot" />
          <span class="ppc-landing__diag-tag">Diagnostic board</span>
        </div>
        <div class="ppc-landing__diag-grid">
          {
            problems.items.map((item) => (
              <article class="ppc-landing__diag-cell">
                <h3 class="font-display text-[0.95rem] font-semibold leading-snug text-white">{item.title}</h3>
                <p class="mt-2 text-[0.8125rem] leading-6 text-white/65">{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <!-- 3. Capabilities -->
  <section class="border-t border-white/10 bg-[#0D120C] py-12 sm:py-16" aria-labelledby={`${service.slug}-capabilities-heading`}>
    <Container>
      <p class:list={[eyebrowClass, 'w-fit']}>{capabilities.eyebrow}</p>
      <h2 id={`${service.slug}-capabilities-heading`} class="mt-3 max-w-3xl font-display text-2xl font-semibold tracking-tight sm:text-3xl">
        {capabilities.titleBefore}
        <span class="text-highlight"> {capabilities.titleHighlight}</span>
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:text-base">{capabilities.intro}</p>

      <ul class="ppc-landing__tiles mt-10 grid gap-3 sm:mt-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          capabilities.items.map((item) => (
            <li>
              {item.href ? (
                <a href={item.href} class="ppc-landing__tile ppc-landing__tile--link group">
                  <span class="ppc-landing__tile-mark" aria-hidden="true">
                    {channelMarkers[item.title] ?? item.title.slice(0, 2).toUpperCase()}
                  </span>
                  <div class="min-w-0 flex-1">
                    <h3 class="font-display text-lg font-semibold text-white transition group-hover:text-highlight">
                      {item.title}
                    </h3>
                    <p class="mt-2 text-sm leading-6 text-white/65">{item.text}</p>
                    <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-[0.14em] text-highlight/90">
                      Open
                      <ArrowUpRight size={14} aria-hidden="true" />
                    </span>
                  </div>
                </a>
              ) : (
                <div class="ppc-landing__tile">
                  <span class="ppc-landing__tile-mark" aria-hidden="true">
                    {channelMarkers[item.title] ?? item.title.slice(0, 2).toUpperCase()}
                  </span>
                  <div class="min-w-0">
                    <h3 class="font-display text-lg font-semibold text-white">{item.title}</h3>
                    <p class="mt-2 text-sm leading-6 text-white/65">{item.text}</p>
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <!-- 4. Method -->
  <section
    class="relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
    aria-labelledby={`${service.slug}-method-heading`}
  >
    <AmbientBackdrop variant="orbs" class="opacity-60" />
    <Container class="relative">
      <header class="mx-auto max-w-2xl text-center">
        <p class:list={[eyebrowClass, 'mx-auto w-fit max-w-full']}>{method.eyebrow}</p>
        <h2 id={`${service.slug}-method-heading`} class="mt-3 font-display text-[1.65rem] font-semibold tracking-tight text-balance sm:text-[2.1rem]">
          {method.titleBefore}
          <span class="text-highlight"> {method.titleHighlight}</span>
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-white/65 sm:text-base sm:leading-8">{method.intro}</p>
      </header>

      <ol class="ppc-landing__arch mt-7 list-none p-0 sm:mt-8">
        {
          method.steps.map((step, index) => (
            <li class:list={['ppc-landing__arch-step', index === method.steps.length - 1 && 'ppc-landing__arch-step--tail']}>
              <span class="ppc-landing__arch-num font-display">{step.number}</span>
              <h3 class="mt-2 font-display text-[0.92rem] font-semibold leading-snug tracking-tight text-white sm:text-base">
                {step.title}
              </h3>
              <p class="mt-1.5 text-[0.78rem] leading-5 text-white/60 sm:text-sm sm:leading-6">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <!-- 5. Showcase -->
  <section class="border-t border-white/10 bg-[#0D120C] py-12 sm:py-16" aria-labelledby={`${service.slug}-showcase-heading`}>
    <Container>
      <p class:list={[eyebrowClass, 'w-fit']}>{showcase.eyebrow}</p>
      <h2 id={`${service.slug}-showcase-heading`} class="mt-3 max-w-3xl font-display text-2xl font-semibold tracking-tight sm:text-3xl">
        {showcase.titleBefore}
        <span class="text-highlight"> {showcase.titleHighlight}</span>
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:text-base">{showcase.intro}</p>

      <div class="ppc-landing__journey mt-10">
        <div class="ppc-landing__strip" aria-hidden="true">
          <div class="ppc-landing__strip-node">
            <span class="ppc-landing__strip-label">Ad</span>
            <div class="ppc-landing__ad-mock">
              <span class="ppc-landing__ad-line" />
              <span class="ppc-landing__ad-line ppc-landing__ad-line--short" />
              <span class="ppc-landing__ad-cta">CTA</span>
            </div>
          </div>
          <span class="ppc-landing__strip-connector" />
          <div class="ppc-landing__strip-node">
            <span class="ppc-landing__strip-label">Landing</span>
            <div class="ppc-landing__lp-mock">
              <span class="ppc-landing__lp-block" />
              <span class="ppc-landing__lp-block ppc-landing__lp-block--row" />
            </div>
          </div>
          <span class="ppc-landing__strip-connector" />
          <div class="ppc-landing__strip-node">
            <span class="ppc-landing__strip-label">Conversion</span>
            <div class="ppc-landing__cv-mock">
              <span class="ppc-landing__cv-field" />
              <span class="ppc-landing__cv-btn" />
            </div>
          </div>
        </div>

        <div class="ppc-landing__showcase-panels mt-8 grid gap-4 lg:grid-cols-2">
          {
            showcase.panels.map((panel) => (
              <article class="flex h-full flex-col rounded-2xl border border-white/12 bg-white/[0.03] p-6">
                <h3 class="font-display text-lg font-semibold text-white">{panel.title}</h3>
                <p class="mt-2 text-sm leading-6 text-white/65">{panel.text}</p>
                <ul class="mt-4 space-y-2 border-t border-white/10 pt-4 text-sm text-white/72">
                  {panel.points.map((point) => (
                    <li class="flex gap-2">
                      <span class="mt-2 h-px w-6 flex-none bg-highlight/50" aria-hidden="true" />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <!-- 6. Related services -->
  <section class="border-t border-white/10 bg-[#0D120C] py-12 sm:py-14" aria-labelledby={`${service.slug}-children-heading`}>
    <Container>
      <p class:list={[eyebrowClass, 'w-fit']}>{children.eyebrow}</p>
      <h2 id={`${service.slug}-children-heading`} class="mt-3 max-w-3xl font-display text-2xl font-semibold tracking-tight sm:text-3xl">
        {children.titleBefore}
        <span class="text-highlight"> {children.titleHighlight}</span>
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-white/65">{children.intro}</p>

      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          children.items.map((item) => (
            <li>
              <a
                href={item.href}
                class="group flex h-full flex-col rounded-2xl border border-white/12 bg-white/[0.02] p-5 transition hover:border-highlight/45 hover:bg-white/[0.05]"
              >
                <span class="text-sm font-semibold text-white group-hover:text-highlight">{item.label}</span>
                <span class="mt-2 text-sm leading-6 text-white/65">{item.text}</span>
                <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-[0.14em] text-highlight/90">
                  Open
                  <ArrowUpRight size={14} aria-hidden="true" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <!-- 7. Mid CTA -->
  <ServiceParentMidCta service={service} tone="rail" />

  <!-- 8. Deliverables -->
  <section class="border-t border-white/10 bg-[#0D120C] py-12 sm:py-14" aria-labelledby={`${service.slug}-deliverables-heading`}>
    <Container>
      <p class:list={[eyebrowClass, 'w-fit']}>{deliverables.eyebrow}</p>
      <h2 id={`${service.slug}-deliverables-heading`} class="mt-3 max-w-3xl font-display text-2xl font-semibold tracking-tight sm:text-3xl">
        {deliverables.titleBefore}
        <span class="text-highlight"> {deliverables.titleHighlight}</span>
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-white/65">{deliverables.intro}</p>

      <div class="ppc-landing__deliverables mt-10 grid gap-4 sm:grid-cols-2">
        {
          deliverables.items.map((item) => (
            <article class="ppc-landing__deliverable">
              <h3 class="font-display text-lg font-semibold text-white">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-white/66">{item.text}</p>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- 9. FAQ -->
  <ServiceParentFaq service={service} layout="stack" />

  <!-- 10. Final CTA -->
  <ServiceParentFinalCta service={service} />
</div>

<style>
  .ppc-landing__hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .ppc-landing__hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 1.75rem;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .ppc-landing__hero-grid {
      gap: 2.25rem;
    }
  }

  .ppc-landing__hero-visual {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    min-width: 0;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .ppc-landing__hero-visual {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem;
    }
  }

  .ppc-landing__dash {
    min-width: 0;
    height: 100%;
    border-radius: 1.15rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: linear-gradient(145deg, rgb(255 255 255 / 0.04), rgb(0 0 0 / 0.35));
    padding: 0.95rem 1rem 1.05rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ppc-landing__dash-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .ppc-landing__dash-title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
  }

  .ppc-landing__dash-pill {
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid rgb(222 243 77 / 0.35);
    color: rgb(222 243 77 / 0.95);
  }

  .ppc-landing__dash-bars {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.35rem;
    height: 5rem;
    margin-top: auto;
    padding: 0 0.1rem;
  }

  .ppc-landing__bar {
    flex: 1;
    border-radius: 0.35rem 0.35rem 0 0;
    background: linear-gradient(180deg, rgb(222 243 77 / 0.35), rgb(222 243 77 / 0.08));
    border: 1px solid rgb(255 255 255 / 0.08);
    min-height: 20%;
  }

  .ppc-landing__dash-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.35rem;
  }

  .ppc-landing__cell {
    aspect-ratio: 1.6;
    border-radius: 0.45rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    background: rgb(255 255 255 / 0.04);
  }

  .ppc-landing__funnel {
    min-width: 0;
    height: 100%;
    border-radius: 1.15rem;
    border: 1px solid rgb(222 243 77 / 0.18);
    background: rgb(0 0 0 / 0.25);
    padding: 0.95rem 1rem 1.05rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .ppc-landing__funnel-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
  }

  .ppc-landing__funnel-stages {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .ppc-landing__stage {
    margin-inline: auto;
    width: var(--w);
    min-width: 0;
    max-width: 100%;
    border-radius: 0.45rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: linear-gradient(90deg, rgb(255 255 255 / 0.06), transparent);
    padding: 0.4rem 0.6rem;
  }

  .ppc-landing__stage--accent {
    border-color: rgb(222 243 77 / 0.35);
    background: linear-gradient(90deg, rgb(222 243 77 / 0.12), transparent);
  }

  .ppc-landing__stage-name {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.78);
  }

  .ppc-landing__diag-header {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .ppc-landing__diag-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.18);
  }
  .ppc-landing__diag-dot:first-child {
    background: rgb(222 243 77 / 0.45);
  }

  .ppc-landing__diag-tag {
    margin-left: auto;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.38);
  }

  .ppc-landing__diag-grid {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .ppc-landing__diag-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem 1rem;
    }
  }

  .ppc-landing__diag-cell {
    border-radius: 1rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    background: rgb(255 255 255 / 0.025);
    padding: 0.85rem 1rem;
  }

  .ppc-landing__tiles {
    list-style: none;
    padding: 0;
    margin-inline: 0;
    margin-bottom: 0;
  }

  .ppc-landing__tile {
    display: flex;
    height: 100%;
    gap: 0.85rem;
    border-radius: 1.15rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(255 255 255 / 0.03);
    padding: 1rem 1.1rem;
  }

  .ppc-landing__tile--link {
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .ppc-landing__tile--link:hover {
    border-color: rgb(222 243 77 / 0.45);
    background: rgb(255 255 255 / 0.05);
  }

  .ppc-landing__tile-mark {
    flex: 0 0 auto;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.85rem;
    display: grid;
    place-items: center;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: rgb(13 18 12);
    background: linear-gradient(135deg, rgb(222 243 77), rgb(197 246 61));
    border: 1px solid rgb(255 255 255 / 0.12);
  }

  .ppc-landing__arch {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .ppc-landing__arch {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem;
    }
  }

  @media (min-width: 1024px) {
    .ppc-landing__arch {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.7rem;
    }
  }

  .ppc-landing__arch-step {
    position: relative;
    min-width: 0;
    height: 100%;
    border-radius: 1rem;
    border: 1px solid rgb(255 255 255 / 0.11);
    background:
      linear-gradient(165deg, rgb(222 243 77 / 0.05), transparent 42%),
      rgb(255 255 255 / 0.03);
    padding: 0.95rem 0.9rem 1rem;
  }

  .ppc-landing__arch-step--tail {
    border-color: rgb(222 243 77 / 0.28);
    background:
      linear-gradient(165deg, rgb(222 243 77 / 0.1), transparent 48%),
      rgb(255 255 255 / 0.03);
  }

  .ppc-landing__arch-num {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
