---
import { ArrowUpRight } from 'lucide-react';
import type { LocationOffice } from '../../config/locations';
import Container from '../ui/Container.astro';
import { buttonClass, eyebrowClass } from '../ui/styles';
import LocationAmbientBg from './LocationAmbientBg.astro';

interface Props {
  location: LocationOffice;
}

const { location } = Astro.props;
const { services } = location;
---

<section
  id="location-services"
  class="location-services relative isolate overflow-x-clip border-t border-white/10 bg-[#0D120C] py-10 sm:py-12 lg:py-14"
  aria-labelledby="location-services-heading"
>
  <LocationAmbientBg variant="c" />

  <Container class="relative">
    <header class="location-services__header mx-auto max-w-3xl text-center">
      <p class:list={[eyebrowClass, 'location-services__eyebrow mx-auto w-fit max-w-full']}>
        Local Digital Services
      </p>
      <h2
        id="location-services-heading"
        class="location-services__title mt-3 font-display text-[1.7rem] leading-[1.12] font-semibold tracking-tight text-balance text-white sm:text-[2.25rem] lg:text-[2.45rem] lg:leading-[1.06]"
      >
        Digital Marketing &amp; Web Development Services in
        <span class="text-highlight"> {location.locationLabel}.</span>
      </h2>
      <p class="location-services__lede mx-auto mt-3 max-w-2xl text-sm leading-7 text-white/65 sm:mt-4 sm:text-base sm:leading-8">
        {services.intro}
      </p>
    </header>

    <div class="location-services__board mt-7 sm:mt-8">
      <div class="location-services__board-meta" aria-hidden="true">
        <span>Service index</span>
        <span>{String(services.items.length).padStart(2, '0')} offerings</span>
      </div>

      <ol class="location-services__directory">
        {
          services.items.map((item, index) => {
            const number = String(index + 1).padStart(2, '0');
            return (
              <li class="location-services__item" style={`--svc-i: ${index}`}>
                <a href={item.href} class="location-services__link group">
                  <span class="location-services__index font-display" aria-hidden="true">
                    {number}
                  </span>
                  <div class="location-services__body">
                    <div class="location-services__top">
                      <h3 class="location-services__item-title font-display">{item.title}</h3>
                      <span class="location-services__arrow" aria-hidden="true">
                        <ArrowUpRight size={16} />
                      </span>
                    </div>
                    <p class="location-services__desc">{item.description}</p>
                    <span class="location-services__action">
                      {item.linkLabel}
                      <ArrowUpRight size={14} aria-hidden="true" />
                    </span>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ol>
    </div>

    <div class="location-services__cta mt-7 flex justify-center sm:mt-8">
      <a
        href="/services/"
        class:list={[
          buttonClass.base,
          buttonClass.gradient,
          'w-full max-w-md px-6 shadow-[0_14px_40px_rgb(197_246_61_/0.18)] sm:w-auto sm:max-w-none',
        ]}
      >
        Find the Right Digital Solution for Your Business
        <ArrowUpRight size={16} aria-hidden="true" />
      </a>
    </div>
  </Container>
</section>

<style>
  .location-services__board {
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 1.5rem;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.035), rgb(255 255 255 / 0.015)),
      rgb(13 18 12 / 0.65);
  }

  .location-services__board-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    padding: 0.85rem 1.1rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.45);
  }

  @media (min-width: 640px) {
    .location-services__board-meta {
      padding: 0.95rem 1.35rem;
    }
  }

  .location-services__board-meta span:last-child {
    color: #def34d;
  }

  .location-services__directory {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .location-services__directory {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .location-services__item:nth-child(odd) .location-services__link {
      border-right: 1px solid rgb(255 255 255 / 0.1);
    }
  }

  .location-services__item:not(:last-child) .location-services__link {
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  @media (min-width: 900px) {
    .location-services__item:nth-last-child(-n + 2) .location-services__link {
      border-bottom: 0;
    }
  }

  .location-services__link {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    min-height: 100%;
    padding: 1rem 1rem 1.05rem;
    transition: background-color 0.25s ease;
  }

  @media (min-width: 640px) {
    .location-services__link {
      gap: 0.9rem;
      padding: 1.15rem 1.2rem 1.2rem;
    }
  }

  @media (min-width: 1100px) {
    .location-services__link {
      gap: 1rem;
      padding: 1.25rem 1.35rem 1.3rem;
    }
  }

  .location-services__link:hover,
  .location-services__link:focus-visible {
    background: rgb(222 243 77 / 0.05);
  }

  .location-services__index {
    position: relative;
    z-index: 0;
    font-size: clamp(1.85rem, 3.4vw, 2.55rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    color: rgb(222 243 77 / 0.42);
    transition: color 0.25s ease;
  }

  .location-services__link:hover .location-services__index,
  .location-services__link:focus-visible .location-services__index {
    color: #def34d;
  }

  .location-services__body {
    position: relative;
    z-index: 1;
    min-width: 0;
    padding-top: 0.15rem;
  }

  .location-services__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .location-services__item-title {
    margin: 0;
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: #fff;
    transition: color 0.25s ease;
  }

  .location-services__link:hover .location-services__item-title,
  .location-services__link:focus-visible .location-services__item-title {
    color: #def34d;
  }

  .location-services__arrow {
    display: inline-flex;
    height: 2rem;
    width: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 9999px;
    color: rgb(255 255 255 / 0.4);
    transition:
      border-color 0.25s ease,
      color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  .location-services__link:hover .location-services__arrow,
  .location-services__link:focus-visible .location-services__arrow {
    border-color: rgb(222 243 77 / 0.45);
    background: rgb(222 243 77 / 0.1);
    color: #def34d;
    transform: translate(1px, -1px);
  }

  .location-services__desc {
    margin-top: 0.65rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: rgb(255 255 255 / 0.6);
  }

  @media (min-width: 640px) {
    .location-services__desc {
      font-size: 0.92rem;
      line-height: 1.7;
    }
  }

  .location-services__action {
    margin-top: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #def34d;
  }

  @media (prefers-reduced-motion: no-preference) {
    .location-services__header,
    .location-services__board,
    .location-services__cta {
      opacity: 0;
      transform: translateY(14px);
      animation: location-services-rise 0.7s ease forwards;
    }

    .location-services__header {
      animation-delay: 50ms;
    }

    .location-services__board {
      animation-delay: 120ms;
    }

    .location-services__cta {
      animation-delay: 220ms;
    }

    .location-services__item {
      opacity: 0;
      transform: translateY(10px);
      animation: location-services-rise 0.55s ease forwards;
      animation-delay: calc(160ms + var(--svc-i, 0) * 45ms);
    }
  }

  @keyframes location-services-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
