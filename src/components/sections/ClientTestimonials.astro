---
import { testimonials } from '../../config/testimonials';
import TestimonialsCarousel from '../interactive/TestimonialsCarousel';
import AmbientBackdrop from '../ui/AmbientBackdrop.astro';
import Container from '../ui/Container.astro';
import { eyebrowClass } from '../ui/styles';
---

<section
  id="testimonials"
  class="relative isolate overflow-hidden border-t border-white/10 bg-bg py-12 sm:py-14 lg:py-16"
  aria-labelledby="testimonials-heading"
>
  <AmbientBackdrop variant="drift" />

  <Container class="relative">
    <div class="mx-auto max-w-3xl text-center">
      <p class={eyebrowClass}>Client Feedback</p>
      <h2
        id="testimonials-heading"
        class="mt-3 font-display text-3xl font-semibold tracking-tight text-balance sm:text-4xl lg:text-[2.75rem]"
      >
        <span class="text-white">What Our Clients </span>
        <span class="text-highlight">Say</span>
      </h2>
      <p class="mt-3 text-base leading-7 text-white/65 sm:text-lg sm:leading-8">
        Building lasting partnerships through thoughtful strategies, quality work, and meaningful digital experiences.
      </p>
    </div>

    <TestimonialsCarousel client:visible items={testimonials} />
  </Container>
</section>
