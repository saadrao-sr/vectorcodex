---
import { Briefcase, CalendarDays, Layers, Sparkles, type LucideIcon } from 'lucide-react';
import { resultsStats } from '../../config/stats';
import CountUpStat from '../interactive/CountUpStat';
import Container from '../ui/Container.astro';
import { eyebrowClass } from '../ui/styles';

const icons: Record<(typeof resultsStats)[number]['icon'], LucideIcon> = {
  briefcase: Briefcase,
  calendar: CalendarDays,
  layers: Layers,
  sparkles: Sparkles,
};
---

<section id="results" class="border-t border-white/10 bg-bg py-10 sm:py-12 lg:py-14" aria-labelledby="results-heading">
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <p class={eyebrowClass}>Impact Snapshot</p>
      <h2
        id="results-heading"
        class="mt-3 font-display text-2xl font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl"
      >
        <span class="text-white">Our Clients Get </span>
        <span class="text-highlight">Results.</span>
      </h2>
      <p class="mt-3 text-sm leading-6 text-white/65 sm:text-base sm:leading-7">
        Turning digital strategies into measurable progress through technology, creativity, and performance.
      </p>
    </div>

    <div class="mt-8 overflow-hidden rounded-2xl border border-white/12 bg-white/[0.03] shadow-[0_16px_48px_rgb(0_0_0_/0.25)] sm:mt-10">
      <ul class="grid grid-cols-2 divide-x divide-y divide-white/10 lg:grid-cols-4 lg:divide-y-0">
        {
          resultsStats.map((stat) => {
            const Icon = icons[stat.icon];
            return (
              <li class="group relative px-4 py-5 text-center transition hover:bg-white/[0.04] sm:px-5 sm:py-6">
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-b from-highlight/8 to-transparent opacity-0 transition group-hover:opacity-100"
                  aria-hidden="true"
                />
                <div class="relative">
                  <div class="mx-auto inline-flex h-9 w-9 items-center justify-center rounded-xl border border-highlight/25 bg-highlight/10 text-highlight">
                    <Icon size={16} aria-hidden="true" />
                  </div>
                  <p class="mt-3 font-display text-3xl font-semibold tracking-tight text-transparent bg-gradient-to-r from-lime to-gold bg-clip-text sm:text-4xl">
                    <CountUpStat client:visible value={stat.value} suffix={stat.suffix} />
                  </p>
                  <h3 class="mt-2 text-sm font-semibold tracking-tight text-white sm:text-[0.9375rem]">{stat.label}</h3>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>

    <p class="mt-3 text-center text-xs leading-5 text-white/40">
      Figures are editable placeholders until verified project data is published.
    </p>
  </Container>
</section>
