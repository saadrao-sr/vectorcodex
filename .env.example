# Production origin used for canonical URLs, sitemap, Open Graph, and llms.txt.
# No trailing slash.
SITE_URL=https://vectorcodex.co.uk

# WordPress REST API origin or wp-json URL. Public content works with no key.
# Examples:
#   https://cms.example.com
#   https://cms.example.com/wp-json
WORDPRESS_API_URL=

# Server-only. Never prefix with PUBLIC_.
# Use a Bearer token, or a full "Basic ..." application-password value.
WORDPRESS_API_KEY=

# Optional public endpoint for contact / quote / pricing calculator forms (POST, multipart form data).
# For the pricing calculator, the endpoint should:
#   1) validate and accept form_type=pricing_calculator
#   2) email the full payload_json / summary to the VectorCodex business inbox
#   3) send the visitor an acknowledgement email
#   4) optionally store the enquiry in your CRM/database
# Never put SMTP secrets or private API keys in PUBLIC_ vars.
PUBLIC_CONTACT_ENDPOINT=

# Future server-side email provider (only if you add a secure API/server adapter):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO_EMAIL=info@vectorcodex.com
# CONTACT_FROM_EMAIL=noreply@vectorcodex.com
