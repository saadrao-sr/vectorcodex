# Production origin used for canonical URLs, sitemap, Open Graph, and llms.txt.
# No trailing slash.
SITE_URL=https://vectorcodex.co.uk

# WordPress REST API origin or wp-json URL. Public content works with no key.
# Accepted forms (all normalised to .../wp-json):
#   https://blog.vectorcodex.com
#   https://blog.vectorcodex.com/wp-json
#   https://blog.vectorcodex.com/wp-json/wp/v2
WORDPRESS_API_URL=https://blog.vectorcodex.com/wp-json/wp/v2

# Server-only. Never prefix with PUBLIC_.
# Use a Bearer token, or a full "Basic ..." application-password value.
WORDPRESS_API_KEY=

# Public VectorCodex Lead Manager endpoint (POST, multipart FormData).
# Production:
#   https://blog.vectorcodex.com/wp-json/vectorcodex/v1/leads
# Accepts form_type values:
#   quote | booking | free_audit | team_requirements | project_inquiry | homepage_inquiry | pricing_calculator
# Never put SMTP secrets or private API keys in PUBLIC_ vars.
PUBLIC_CONTACT_ENDPOINT=https://blog.vectorcodex.com/wp-json/vectorcodex/v1/leads

# Cloudflare Turnstile public Site Key (browser-safe).
# Leave empty to hide the widget and skip client-side token checks.
# Enable Turnstile enforcement in WordPress (VectorCodex Leads → Settings) only after
# this key is set and forms post cf-turnstile-response.
# NEVER put the Turnstile Secret Key here — secret stays in WordPress options only.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAGF8JSyBkixA7Lm6

# Future server-side email provider (only if you add a secure API/server adapter):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO_EMAIL=info@vectorcodex.com
# CONTACT_FROM_EMAIL=noreply@vectorcodex.com
